# Normalize line endings to LF in the repo (silences CRLF warnings on Windows).
* text=auto eol=lf

# Treat binaries as binary (no EOL conversion).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.docx binary
*.pdf binary
