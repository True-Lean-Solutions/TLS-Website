---
import { href as withBase } from '../data/site';
import { categoryMeta, formatDate, type Post } from '../data/insights';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { data } = post;
const cat = categoryMeta[data.category];
const url = withBase(`/insights/${post.id}/`);
const topicsAttr = data.topics.join('|');
---

<article class="insight-card ix-card ix-light" data-topics={topicsAttr}>
  <a class="cover-link" href={url} tabindex="-1" aria-hidden="true">
    {
      data.cover ? (
        <img class="cover" src={withBase(data.cover)} alt="" width="600" height="338" loading="lazy" />
      ) : (
        <span class="cover placeholder" />
      )
    }
  </a>
  <div class="body">
    <span class="cat">{cat.label}</span>
    <h3><a href={url}>{data.title}</a></h3>
    <p class="excerpt">{data.excerpt}</p>
    <p class="meta">
      <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
      {data.readTime && <span aria-hidden="true">·</span>}
      {data.readTime && <span>{data.readTime}</span>}
    </p>
  </div>
</article>

<style>
  .insight-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  /* Hover lift: motion.css (.ix-card). The cover eases in slightly. */
  .cover-link {
    overflow: hidden;
  }
  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--section);
    transition: transform 700ms var(--ix-ease);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .insight-card:hover .cover {
      transform: scale(1.03);
    }
  }
  .placeholder {
    background: var(--grad);
    opacity: 0.9;
  }
  .body {
    padding: 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex-grow: 1;
  }
  .cat {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red-text);
  }
  h3 {
    font-size: var(--step-1);
    line-height: 1.25;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
    transition: color var(--ix-fast) ease;
  }
  h3 a:hover {
    color: var(--blue-text);
  }
  .excerpt {
    color: var(--text-2);
    font-size: 0.93rem;
    line-height: 1.5;
    flex-grow: 1;
  }
  .meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    color: var(--muted);
    font-size: 0.82rem;
    margin-top: 0.25rem;
  }
</style>
