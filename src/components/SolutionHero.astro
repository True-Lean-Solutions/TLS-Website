---
/**
 * Cinematic hero shared by the Solutions page and every solution page: one
 * image and one layout for the whole family; each page brings its own copy,
 * CTAs, icon and accent. Text sits left (on the dark side of the image), the
 * meeting and skyline right, the red/blue wave along the bottom.
 * Image: public/solutions/hero-solutions.webp (see docs/sources.md §5).
 */
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import type { IconName } from './iconTypes';
import type { Accent } from '../data/services';
import { href } from '../data/site';

interface Cta {
  label: string;
  href: string;
  external?: boolean;
}
interface Props {
  eyebrow: string;
  /** White part of the headline. */
  title: string;
  /** TLS red part, on its own line. */
  highlight?: string;
  description?: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
  /** Solution icon shown in a glass tile beside the eyebrow. */
  icon?: IconName;
  /** Tints the icon tile and a faint glow over the image. */
  accent?: Accent;
  /** 'xl' for the Solutions page; 'lg' for solution pages' longer headlines. */
  size?: 'xl' | 'lg';
  image?: { src: string; width: number; height: number };
  /** object-position per breakpoint, if a page's image needs a different crop. */
  position?: { desktop?: string; tablet?: string; mobile?: string };
}

const {
  eyebrow,
  title,
  highlight,
  description,
  primaryCta,
  secondaryCta,
  icon,
  accent = 'red',
  size = 'lg',
  image = { src: '/solutions/hero-solutions.webp', width: 1774, height: 887 },
  position = {},
} = Astro.props;

const accentVar: Record<Accent, string> = { red: 'var(--red)', blue: 'var(--blue)', plum: 'var(--plum)' };

/**
 * Motion graphic on arrival: a one-time light over the photo whose movement
 * follows what the solution does. Keyed by the solution's icon, so every
 * solution page gets its own without page changes. It plays once and is gone,
 * so the settled hero is exactly as designed.
 */
const arrival: Partial<Record<IconName, string>> = {
  ai: 'depth', // AI: light radiating out through the layers
  software: 'modular', // Custom Software: panels slotting into place
  integration: 'connect', // System Integration: two sides meeting
  talent: 'human', // Technical Talent: a soft, unhurried glow
  workflow: 'sequence', // Workflow Automation: one stage, then the next
  compass: 'progress', // Technology Strategy: a directional sweep forward
  analytics: 'flow', // Data & Analytics: light streaming across
  security: 'scan', // Cyber Security: a layered scan, top to bottom
};
const fx = icon ? arrival[icon] : undefined;
const style = [
  `--c: ${accentVar[accent]}`,
  `--pos-desktop: ${position.desktop ?? '60% 80%'}`,
  `--pos-tablet: ${position.tablet ?? '78% 80%'}`,
  `--pos-mobile: ${position.mobile ?? '100% 100%'}`,
].join('; ');
---

<section class:list={['sh', `sh--${size}`, { 'sh--icon': icon }]} style={style}>
  <img
    class="sh-bg"
    src={href(image.src)}
    alt=""
    width={image.width}
    height={image.height}
    fetchpriority="high"
    decoding="async"
  />
  {fx && <span class:list={['sh-fx', `sh-fx--${fx}`]} aria-hidden="true"></span>}
  <span class="sh-spot" aria-hidden="true"></span>
  <div class="wrap">
    <div class="sh-copy">
      {
        icon ? (
          <p class="sh-kicker">
            <span class="sh-ic glass-icon">
              <Icon name={icon} size={18} />
            </span>
            <span class="sh-kicker-label">{eyebrow}</span>
          </p>
        ) : (
          <Eyebrow label={eyebrow} />
        )
      }
      <h1>
        <span class="ml"><span>{title}</span></span>{' '}{highlight && <span class="ml"><span class="hl sh-hl">{highlight}</span></span>}
      </h1>
      {description && <p class="sh-lede">{description}</p>}
      <div class="sh-cta">
        <Button href={primaryCta.href} variant="primary" arrow external={primaryCta.external}>
          {primaryCta.label}
        </Button>
        {
          secondaryCta && (
            <Button href={secondaryCta.href} variant="ghost-light" external={secondaryCta.external}>
              {secondaryCta.label}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .sh {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: clamp(560px, 76vh, 740px);
    background: #070a14; /* the image's own darkness, shown while it loads */
    color: #fff;
  }
  /* The photo, "background-size: cover" style, anchored low so the red/blue
     wave always forms the bottom edge. */
  .sh-bg {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos-desktop);
  }
  /* Readability: darker behind the text, clear over the meeting and skyline. */
  .sh::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.22) 42%,
      rgba(0, 0, 0, 0) 65%
    );
  }
  /* Each solution's accent, as a faint light over the upper right. */
  .sh--icon::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(
      45% 60% at 82% 18%,
      color-mix(in srgb, var(--c) 18%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }
  .sh .wrap {
    width: 100%;
  }
  .sh-copy {
    max-width: 600px;
    padding-block: var(--space-6) var(--space-7);
  }
  .sh--xl .sh-copy {
    max-width: 560px;
  }

  /* Eyebrow: the site's eyebrow on light-on-dark, or icon + label. */
  .sh-copy :global(.eyebrow) {
    color: var(--border);
  }
  .sh-kicker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--border);
  }
  /* Smoked glass tile on the dark image, glyph in a lightened accent. */
  .sh-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    color: color-mix(in srgb, var(--c) 62%, #fff);
  }
  .sh-ic::after {
    background: color-mix(in srgb, var(--c) 20%, rgba(255, 255, 255, 0.04));
    border-color: rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.14),
      0 8px 20px -10px color-mix(in srgb, var(--c) 60%, transparent);
    /* No backdrop-filter: at rest it would cost the page subpixel text. */
  }
  .sh-ic::before {
    opacity: 0.55;
  }

  .sh h1 {
    color: #fff;
    line-height: 1.06;
  }
  .sh--xl h1 {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4rem);
  }
  .sh--lg h1 {
    font-size: clamp(2.2rem, 1.45rem + 2.6vw, 3.25rem);
  }
  .sh-hl {
    display: block;
  }
  .sh-lede {
    margin-top: 1.25rem;
    max-width: 30em;
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--border);
  }
  .sh--xl .sh-lede {
    max-width: 27em; /* three lines on the Solutions page, as briefed */
    font-size: 1.15rem;
  }
  .sh-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.9rem;
  }

  /* Entrance: the photo settles out of a slight zoom while the eyebrow, the
     headline (line by line, out of a mask: motion.css .ml), the copy and the
     CTAs arrive in sequence. The scroll layer then drifts the photo (its
     transform composes with this `scale`). */
  @media screen and (prefers-reduced-motion: no-preference) {
    .sh-bg {
      animation: sh-settle 1600ms var(--ix-ease) backwards;
    }
    .sh-copy > :global(*:not(h1)) {
      --ix-rise: 20px;
      animation: ix-rise 700ms var(--ix-ease) backwards;
    }
    .sh-copy > :global(:nth-child(1)) { --ix-rise: 15px; animation-delay: 60ms; }
    .sh-copy h1 :global(.ml > span) { animation-delay: 160ms; }
    .sh-copy h1 :global(.ml:nth-child(2) > span) { animation-delay: 270ms; }
    .sh-copy > :global(:nth-child(3)) { animation-delay: 420ms; }
    .sh-copy > :global(:nth-child(4)) { animation-delay: 560ms; }
  }
  @keyframes sh-settle {
    from {
      scale: 1.07;
    }
  }

  /* Arrival motion graphic (see `arrival` above). Transform and opacity
     only, over the photo and under the text; it fades in, moves once and
     fades out. Nothing shows at rest, in print or with reduced motion. */
  .sh-fx {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    /* Screen blending: the layer adds light to the photo rather than a film. */
    mix-blend-mode: screen;
    --fx-tint: color-mix(in srgb, var(--c) 26%, transparent);
    --fx-glint: rgba(255, 255, 255, 0.22);
  }
  .sh-fx::before,
  .sh-fx::after {
    content: '';
    position: absolute;
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    .sh-fx {
      animation: sh-fx-life 2600ms ease 750ms backwards;
    }
    .sh-fx::before,
    .sh-fx::after {
      animation-duration: 2400ms;
      animation-delay: 850ms;
      animation-fill-mode: backwards;
      animation-timing-function: cubic-bezier(0.45, 0, 0.2, 1);
    }

    /* Cyber Security: a band scans down the image, a fainter layer behind it. */
    .sh-fx--scan::before,
    .sh-fx--scan::after {
      left: 0;
      right: 0;
      top: 0;
      height: 26%;
      background: linear-gradient(
        180deg,
        transparent,
        var(--fx-tint) 70%,
        transparent 96.5%,
        rgba(255, 255, 255, 0.7) 98%,
        transparent
      );
      animation-name: sh-fx-scan;
    }
    .sh-fx--scan::after {
      opacity: 0.5;
      animation-delay: 1250ms;
      animation-duration: 2000ms;
    }

    /* Data & Analytics: light streams across, a thinner stream following. */
    .sh-fx--flow::before,
    .sh-fx--flow::after {
      top: -20%;
      bottom: -20%;
      left: 0;
      width: 45%;
      background: linear-gradient(105deg, transparent 20%, var(--fx-tint) 46%, var(--fx-glint) 52%, transparent 80%);
      animation-name: sh-fx-flow;
      animation-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
    }
    .sh-fx--flow::after {
      width: 28%;
      opacity: 0.6;
      animation-delay: 1200ms;
    }

    /* System Integration: light from each side, meeting in the middle. */
    .sh-fx--connect::before,
    .sh-fx--connect::after {
      top: 0;
      bottom: 0;
      width: 38%;
      background: linear-gradient(90deg, transparent, var(--fx-tint) 72%, var(--fx-glint) 96%, transparent);
      animation-name: sh-fx-connect;
      animation-duration: 2000ms;
    }
    .sh-fx--connect::before {
      left: 0;
      --fx-from: -100%;
      --fx-to: 32%;
    }
    .sh-fx--connect::after {
      right: 0;
      scale: -1 1;
      --fx-from: 100%;
      --fx-to: -32%;
    }

    /* Workflow Automation: a light holds on each third of the image in turn. */
    .sh-fx--sequence::before {
      top: 0;
      bottom: 0;
      left: 0;
      width: 33.34%;
      background:
        radial-gradient(60% 45% at 50% 55%, var(--fx-tint), transparent 75%),
        linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);
      animation-name: sh-fx-steps;
      animation-timing-function: var(--ix-ease);
    }

    /* Technology Strategy: a directional fill with a bright leading edge. */
    .sh-fx--progress::before {
      inset: 0;
      background: linear-gradient(
        90deg,
        var(--fx-tint),
        color-mix(in srgb, var(--c) 8%, transparent) 70%,
        var(--fx-glint) 99%,
        transparent
      );
      transform-origin: left center;
      animation-name: sh-fx-progress;
      animation-timing-function: cubic-bezier(0.5, 0, 0.15, 1);
    }

    /* AI & Automation: rings of light radiating out from the scene. */
    .sh-fx--depth::before,
    .sh-fx--depth::after {
      left: 64%;
      top: 46%;
      width: 70vmax;
      height: 70vmax;
      margin: -35vmax 0 0 -35vmax;
      border-radius: 50%;
      background: radial-gradient(
        closest-side,
        transparent 56%,
        var(--fx-tint) 70%,
        var(--fx-glint) 74%,
        transparent 80%
      );
      animation-name: sh-fx-depth;
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.2, 1);
    }
    .sh-fx--depth::after {
      opacity: 0.55;
      animation-delay: 1250ms;
      animation-duration: 2000ms;
    }

    /* Technical Talent: a soft glow over the people, breathing in once. */
    .sh-fx--human::before {
      inset: -10%;
      background: radial-gradient(
        40% 50% at 72% 58%,
        var(--fx-tint),
        rgba(255, 255, 255, 0.05) 45%,
        transparent 75%
      );
      animation-name: sh-fx-breathe;
      animation-duration: 2600ms;
      animation-timing-function: cubic-bezier(0.45, 0, 0.55, 1);
    }

    /* Custom Software: two panels slot into place, one after the other. */
    .sh-fx--modular::before,
    .sh-fx--modular::after {
      top: 0;
      bottom: 0;
      width: 22%;
      background: linear-gradient(90deg, rgba(255, 255, 255, 0.07), var(--fx-tint));
      border-left: 1px solid rgba(255, 255, 255, 0.18);
      animation-name: sh-fx-module;
      animation-duration: 1500ms;
      animation-timing-function: var(--ix-ease);
    }
    .sh-fx--modular::before {
      right: 22%;
      --fx-from: 210%;
    }
    .sh-fx--modular::after {
      right: 0;
      --fx-from: 110%;
      animation-delay: 1050ms;
    }
  }
  @media print {
    .sh-fx {
      display: none;
    }
  }
  @keyframes sh-fx-life {
    0% {
      opacity: 0;
    }
    14%,
    76% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes sh-fx-scan {
    from {
      translate: 0 -100%;
    }
    to {
      translate: 0 385%;
    }
  }
  @keyframes sh-fx-flow {
    from {
      translate: -110% 0;
    }
    to {
      translate: 240% 0;
    }
  }
  @keyframes sh-fx-connect {
    from {
      translate: var(--fx-from) 0;
    }
    to {
      translate: var(--fx-to) 0;
    }
  }
  @keyframes sh-fx-steps {
    0%,
    24% {
      translate: 0 0;
    }
    34%,
    58% {
      translate: 100% 0;
    }
    68%,
    100% {
      translate: 200% 0;
    }
  }
  @keyframes sh-fx-progress {
    from {
      scale: 0 1;
    }
    to {
      scale: 1 1;
    }
  }
  @keyframes sh-fx-depth {
    from {
      scale: 0.15;
    }
    to {
      scale: 1.2;
    }
  }
  @keyframes sh-fx-breathe {
    from {
      scale: 0.92;
    }
    to {
      scale: 1.04;
    }
  }
  @keyframes sh-fx-module {
    from {
      translate: var(--fx-from) 0;
    }
    to {
      translate: 0 0;
    }
  }

  /* Cursor spotlight (fine pointers; positioned by the scroll layer). */
  .sh-spot {
    position: absolute;
    z-index: -1;
    top: 0;
    left: 0;
    width: 520px;
    height: 520px;
    margin: -260px 0 0 -260px;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--c) 16%, rgba(255, 255, 255, 0.07)),
      transparent
    );
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Tablet: shorter, narrower copy, image shifted so the meeting sits clear
     of the text. */
  @media (max-width: 1024px) {
    .sh {
      /* Tall enough for the longest copy, so every page matches. */
      min-height: clamp(560px, 70vh, 720px);
    }
    .sh-bg {
      object-position: var(--pos-tablet);
    }
    .sh::before {
      background: linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.62) 0%,
        rgba(0, 0, 0, 0.38) 45%,
        rgba(0, 0, 0, 0) 70%
      );
    }
    .sh-copy,
    .sh--xl .sh-copy {
      max-width: 410px;
    }
    .sh-lede,
    .sh--xl .sh-lede {
      font-size: 1.05rem;
    }
  }

  /* Phone: the copy on the image's dark tone, then a band of the photo — the
     meeting and the wave — below it. The band never sits under the text, so
     long copy can't collide with the people. */
  @media (max-width: 640px) {
    .sh {
      display: block;
      min-height: 0;
      padding-bottom: 290px;
    }
    .sh-bg {
      inset: auto 0 0 0;
      height: 400px;
      object-position: var(--pos-mobile);
    }
    .sh-fx {
      inset: auto 0 0 0;
      height: 400px;
    }
    .sh::before {
      background: linear-gradient(
        180deg,
        #070a14 0%,
        #070a14 calc(100% - 400px),
        rgba(7, 10, 20, 0.55) calc(100% - 330px),
        rgba(7, 10, 20, 0) calc(100% - 230px)
      );
    }
    .sh--icon::after {
      background: radial-gradient(
        70% 40% at 80% 0%,
        color-mix(in srgb, var(--c) 20%, transparent),
        transparent 70%
      );
    }
    .sh-copy,
    .sh--xl .sh-copy {
      padding-block: var(--space-5) 0;
    }
    .sh--xl h1 {
      font-size: clamp(2.1rem, 1.2rem + 4.4vw, 2.6rem);
    }
    .sh--lg h1 {
      font-size: clamp(1.9rem, 1.1rem + 4vw, 2.3rem);
    }
    .sh-lede,
    .sh--xl .sh-lede {
      font-size: 1rem;
    }
  }
</style>
