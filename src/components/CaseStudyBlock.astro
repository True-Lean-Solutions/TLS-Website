---
import Eyebrow from './Eyebrow.astro';

/** Highlighted case study with a verified metric (v2.3 §15). */
interface Props {
  stat: string;
  title: string;
  text: string;
}
const { stat, title, text } = Astro.props;
---

<div class="case" data-reveal>
  <div class="stat-col">
    <Eyebrow label="Case Study" />
    <span class="stat">{stat}</span>
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p>{text}</p>
  </div>
</div>

<style>
  .case {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 2rem;
    align-items: center;
    background: var(--ink);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    border-top: 3px solid transparent;
    border-image: var(--grad-h) 1;
  }
  .stat {
    display: block;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(2.6rem, 1.6rem + 3vw, 3.6rem);
    line-height: 1;
    color: #fff;
    letter-spacing: -0.02em;
  }
  .body h3 {
    color: #fff;
    font-size: var(--step-2);
    margin-bottom: 0.75rem;
  }
  .body p {
    color: var(--border);
    line-height: 1.6;
  }
  @media (max-width: 760px) {
    .case {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      padding: 1.75rem;
    }
  }
</style>
