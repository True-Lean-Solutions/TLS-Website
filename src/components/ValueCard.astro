---
import Icon from './Icon.astro';
import type { IconName } from './iconTypes';
import type { Accent } from '../data/services';

interface Props {
  title: string;
  text: string;
  icon: IconName;
  accent: Accent;
}
const { title, text, icon, accent } = Astro.props;

const accents: Record<Accent, string> = {
  red: '--c: var(--red); --c-tint: var(--red-tint);',
  blue: '--c: var(--blue); --c-tint: var(--blue-tint);',
  plum: '--c: var(--plum); --c-tint: var(--plum-tint);',
};
---

<div class="value-card ix-card ix-card--quiet ix-light" style={accents[accent]}>
  <span class="icon glass-icon"><Icon name={icon} size={24} /></span>
  <div class="body">
    <h3>{title}</h3>
    <p>{text}</p>
  </div>
  <span class="arrow glass-icon" aria-hidden="true"><Icon name="arrow" size={18} /></span>
</div>

<style>
  .value-card {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow);
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    color: var(--c);
    align-self: start;
  }
  h3 {
    font-size: var(--step-1);
    margin-bottom: 0.3rem;
  }
  p {
    color: var(--text-2);
    line-height: 1.55;
    font-size: 0.96rem;
  }
  .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    color: var(--c);
    flex: none;
  }
  @media (max-width: 480px) {
    .value-card {
      grid-template-columns: auto 1fr;
    }
    .arrow {
      display: none;
    }
  }
</style>
