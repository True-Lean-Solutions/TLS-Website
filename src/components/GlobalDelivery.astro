---
/**
 * Global delivery section for About (Mack, 2026-09-28): "Built in Dallas.
 * Connected Globally." — a world map with location pins, numbered location
 * cards, and the "One Team. Global Capability." advantage row.
 */
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { href } from '../data/site';
import type { Accent } from '../data/services';

type Status = 'Headquarters' | 'Active' | 'Expanding';
interface Location {
  n: string;
  city: string;
  status: Status;
  desc: string;
  /** Skyline drawing on the card: public/about/skylines/<name>.webp. */
  skyline: keyof typeof skylines;
  x: number;
  y: number;
}

// Pin coordinates are in the map's 1000×520 viewBox (roughly geographic).
const locations: Location[] = [
  { n: '01', city: 'Dallas–Fort Worth', status: 'Headquarters', desc: 'Global Headquarters · Prosper, Texas', skyline: 'dfw', x: 232, y: 214 },
  { n: '02', city: 'India', status: 'Active', desc: 'Technology & Delivery', skyline: 'india', x: 686, y: 250 },
  { n: '03', city: 'United Kingdom', status: 'Active', desc: 'UK Presence', skyline: 'uk', x: 494, y: 168 },
  { n: '04', city: 'United Arab Emirates', status: 'Expanding', desc: 'Expanding Capabilities', skyline: 'uae', x: 612, y: 236 },
  { n: '05', city: 'Australia', status: 'Expanding', desc: 'Expanding Capabilities', skyline: 'australia', x: 838, y: 372 },
  { n: '06', city: 'Mexico', status: 'Expanding', desc: 'Expanding Capabilities · Guadalajara', skyline: 'mexico', x: 214, y: 262 },
];

// Skyline line drawings, cut from Hemang's location-card reference (2026-09-29;
// see docs/sources.md). Width and height of each file, for layout stability.
const skylines = {
  dfw: [443, 234],
  india: [441, 176],
  uk: [444, 228],
  uae: [443, 183],
  australia: [441, 148],
  mexico: [444, 175],
} as const;

const statusAccent: Record<Status, Accent> = {
  Headquarters: 'red',
  Active: 'blue',
  Expanding: 'plum',
};
const accentVar: Record<Accent, string> = {
  red: 'var(--red)',
  blue: 'var(--blue)',
  plum: 'var(--plum)',
};
/** Small text in each status color (AA on white). */
const accentText: Record<Accent, string> = {
  red: 'var(--red-text)',
  blue: 'var(--blue-text)',
  plum: 'var(--plum)',
};

// Pulse rings over the pins baked into global-map.webp, as % of the image
// (measured from the 1600×800 asset). Decorative only.
const pins = [
  { x: 16.75, y: 37.1, c: 'var(--red)' }, // USA
  { x: 13.25, y: 49.3, c: 'var(--red)' }, // Mexico
  { x: 43.0, y: 23.9, c: 'var(--blue)' }, // United Kingdom
  { x: 57.1, y: 48.9, c: 'color-mix(in srgb, var(--blue), var(--plum))' }, // UAE
  { x: 68.6, y: 48.1, c: 'var(--red)' }, // India
  { x: 85.6, y: 75.5, c: 'var(--blue)' }, // Australia
];

const advantages = [
  { icon: 'users' as const, title: 'Global Talent', body: 'Access specialized expertise beyond geographic boundaries.' },
  { icon: 'gear' as const, title: 'Connected Delivery', body: 'Teams designed to collaborate across locations and time zones.' },
  { icon: 'target' as const, title: 'One Standard', body: 'Consistent accountability, quality, and True Lean thinking wherever the work happens.' },
];
---

<section class="section global">
  <div class="wrap">
    <div class="top">
      <div class="intro" data-reveal>
        <Eyebrow label="Global Delivery" />
        <h2>Built in Dallas. <span class="hl">Connected Globally.</span></h2>
        <p>
          True Lean Solutions is headquartered in the Dallas–Fort Worth area,
          with a growing international delivery network designed to bring
          together the right talent, expertise, and capabilities for our clients.
        </p>
        <Button href="#global-presence" variant="primary" arrow>Our Global Presence</Button>
      </div>

      <div class="map" data-reveal>
        <img
          src={href('/about/global-map.webp')}
          alt="World map showing True Lean Solutions locations: the USA, Mexico, United Kingdom, UAE, India and Australia"
          width="1600"
          height="800"
          loading="lazy"
        />
        {
          pins.map((p, i) => (
            <span
              class="pin"
              aria-hidden="true"
              style={`--x: ${p.x}%; --y: ${p.y}%; --c: ${p.c}; --pulse-delay: ${(i * 0.47).toFixed(2)}s;`}
            />
          ))
        }
      </div>
    </div>

    <ol class="locations" id="global-presence" data-reveal="stagger">
      {
        locations.map((l) => {
          const acc = statusAccent[l.status];
          return (
            <li class:list={['loc', 'ix-card', `loc--${acc}`]} style={`--c: ${accentVar[acc]}; --c-text: ${accentText[acc]};`}>
              <div class="loc-head">
                <span class="num">{l.n}</span>
                <span class="badge">{l.status}</span>
              </div>
              <h3>{l.city}</h3>
              <p>{l.desc}</p>
              <div class="skyline" aria-hidden="true">
                <img
                  src={href(`/about/skylines/${l.skyline}.webp`)}
                  alt=""
                  width={skylines[l.skyline][0]}
                  height={skylines[l.skyline][1]}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="rule" aria-hidden="true" />
            </li>
          );
        })
      }
    </ol>

    <div class="advantage">
      <div class="adv-intro" data-reveal>
        <Eyebrow label="The Advantage" />
        <h2>One Team. <span class="hl">Global Capability.</span></h2>
        <p>
          Our distributed model brings together business leadership, specialized
          technology expertise, and delivery capabilities across markets — while
          maintaining a single standard for quality, communication, and
          accountability.
        </p>
      </div>
      <div class="adv-grid" data-reveal="stagger">
        {
          advantages.map((a, i) => (
            <div class="adv-card ix-card ix-card--quiet ix-light" style={`--c: ${accentVar[(['red', 'blue', 'plum'] as Accent[])[i]]};`}>
              <span class="adv-ic glass-icon"><Icon name={a.icon} size={24} /></span>
              <h4>{a.title}</h4>
              <p>{a.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* White, eased in from the page canvas above rather than starting on a line. */
  .global {
    background: linear-gradient(180deg, var(--bg) 0, var(--surface) 96px);
  }
  .hl {
    color: var(--red);
  }
  .top {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 2.5rem;
    align-items: center;
  }
  .intro h2 {
    max-width: 14ch;
  }
  .intro p {
    color: var(--text-2);
    margin: var(--gap-lead) 0 1.75rem;
    max-width: 46ch;
    line-height: 1.6;
  }
  .map {
    position: relative;
  }
  .map img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* A slow, faint ring breathing out of each pin (~2.8s cycle, offset per
     pin). Paused until the map has scrolled into view. */
  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 2.6%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border: 1.5px solid var(--c);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pin {
      animation: pin-pulse 2.8s cubic-bezier(0.2, 0.6, 0.35, 1) var(--pulse-delay) infinite;
    }
    :global(html.ix) .map:not(.is-in) .pin {
      animation-play-state: paused;
    }
  }
  @keyframes pin-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0;
    }
    18% {
      opacity: 0.55;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .locations {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }
  /* Location card: number, status, place, then its skyline along the bottom
     and a bar in the status color (red headquarters, blue active, plum
     expanding). */
  .loc {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.15rem 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow:
      0 1px 2px rgba(13, 13, 13, 0.04),
      0 18px 34px -24px color-mix(in srgb, var(--c) 55%, transparent);
    overflow: hidden;
  }
  .loc-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
  }
  .num {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: 1.5px solid color-mix(in srgb, var(--c) 45%, #fff);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 0.82rem;
    color: var(--c-text);
  }
  .badge {
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--c) 13%, #fff);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-text);
  }
  .loc--red .badge {
    background: var(--red-text);
    color: #fff;
  }
  .loc h3 {
    font-size: clamp(1.1rem, 0.95rem + 0.45vw, 1.35rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .loc p {
    margin-top: 0.25rem;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--text-2);
  }
  /* Skyline: full bleed along the bottom, ground lines level across cards. */
  .skyline {
    height: clamp(84px, 7.5vw, 112px);
    margin: auto -1.15rem 0;
    padding-top: 0.8rem;
    box-sizing: content-box;
  }
  .skyline img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    transform-origin: center bottom;
    transition: scale 600ms var(--ix-ease);
  }
  .loc .rule {
    display: block;
    height: 4px;
    margin: 0 -1.15rem;
    background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 65%, #fff));
    transition: box-shadow var(--ix-base) var(--ix-ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .loc:hover .rule {
      box-shadow: 0 -4px 16px -2px color-mix(in srgb, var(--c) 55%, transparent);
    }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .loc:hover .skyline img {
      scale: 1.03;
    }
  }

  .advantage {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .adv-intro h2 {
    max-width: 16ch;
  }
  .adv-intro p {
    color: var(--text-2);
    margin-top: var(--gap-lead);
    max-width: 60ch;
    line-height: 1.6;
  }
  .adv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .adv-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .adv-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    color: var(--c);
    margin-bottom: 0.9rem;
  }
  .adv-card h4 {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .adv-card p {
    color: var(--text-2);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .locations {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  @media (max-width: 860px) {
    .top {
      grid-template-columns: 1fr;
      gap: var(--gap-block);
    }
    .adv-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .locations {
      grid-template-columns: 1fr;
    }
    .loc {
      padding: 1rem 1rem 0;
    }
    .skyline {
      height: 96px;
      margin-inline: -1rem;
    }
    .loc .rule {
      margin-inline: -1rem;
    }
  }
</style>
