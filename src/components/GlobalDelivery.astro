---
/**
 * Global delivery section for About (Mack, 2026-09-28): "Built in Dallas.
 * Connected Globally." — a world map with location pins, numbered location
 * cards, and the "One Team. Global Capability." advantage row.
 */
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { href } from '../data/site';
import type { Accent } from '../data/services';

type Status = 'Headquarters' | 'Active' | 'Expanding';
interface Location {
  n: string;
  city: string;
  status: Status;
  desc: string;
  x: number;
  y: number;
}

// Pin coordinates are in the map's 1000×520 viewBox (roughly geographic).
const locations: Location[] = [
  { n: '01', city: 'Dallas–Fort Worth', status: 'Headquarters', desc: 'Global Headquarters · Prosper, Texas', x: 232, y: 214 },
  { n: '02', city: 'India', status: 'Active', desc: 'Technology & Delivery', x: 686, y: 250 },
  { n: '03', city: 'United Kingdom', status: 'Active', desc: 'UK Presence', x: 494, y: 168 },
  { n: '04', city: 'United Arab Emirates', status: 'Expanding', desc: 'Expanding Capabilities', x: 612, y: 236 },
  { n: '05', city: 'Australia', status: 'Expanding', desc: 'Expanding Capabilities', x: 838, y: 372 },
  { n: '06', city: 'Mexico', status: 'Expanding', desc: 'Expanding Capabilities · Guadalajara', x: 214, y: 262 },
];

const statusAccent: Record<Status, Accent> = {
  Headquarters: 'red',
  Active: 'blue',
  Expanding: 'plum',
};
const accentVar: Record<Accent, string> = {
  red: 'var(--red)',
  blue: 'var(--blue)',
  plum: 'var(--plum)',
};

// Pulse rings over the pins baked into global-map.webp, as % of the image
// (measured from the 1600×800 asset). Decorative only.
const pins = [
  { x: 16.75, y: 37.1, c: 'var(--red)' }, // USA
  { x: 13.25, y: 49.3, c: 'var(--red)' }, // Mexico
  { x: 43.0, y: 23.9, c: 'var(--blue)' }, // United Kingdom
  { x: 57.1, y: 48.9, c: 'color-mix(in srgb, var(--blue), var(--plum))' }, // UAE
  { x: 68.6, y: 48.1, c: 'var(--red)' }, // India
  { x: 85.6, y: 75.5, c: 'var(--blue)' }, // Australia
];

const advantages = [
  { icon: 'users' as const, title: 'Global Talent', body: 'Access specialized expertise beyond geographic boundaries.' },
  { icon: 'gear' as const, title: 'Connected Delivery', body: 'Teams designed to collaborate across locations and time zones.' },
  { icon: 'target' as const, title: 'One Standard', body: 'Consistent accountability, quality, and True Lean thinking wherever the work happens.' },
];
---

<section class="section global">
  <div class="wrap">
    <div class="top">
      <div class="intro" data-reveal>
        <Eyebrow label="Global Delivery" />
        <h2>Built in Dallas. <span class="hl">Connected Globally.</span></h2>
        <p>
          True Lean Solutions is headquartered in the Dallas–Fort Worth area,
          with a growing international delivery network designed to bring
          together the right talent, expertise, and capabilities for our clients.
        </p>
        <Button href="#global-presence" variant="primary" arrow>Our Global Presence</Button>
      </div>

      <div class="map" data-reveal>
        <img
          src={href('/about/global-map.webp')}
          alt="World map showing True Lean Solutions locations: the USA, Mexico, United Kingdom, UAE, India and Australia"
          width="1600"
          height="800"
          loading="lazy"
        />
        {
          pins.map((p, i) => (
            <span
              class="pin"
              aria-hidden="true"
              style={`--x: ${p.x}%; --y: ${p.y}%; --c: ${p.c}; --pulse-delay: ${(i * 0.47).toFixed(2)}s;`}
            />
          ))
        }
      </div>
    </div>

    <ol class="locations" id="global-presence" data-reveal="stagger">
      {
        locations.map((l) => {
          const acc = statusAccent[l.status];
          return (
            <li class="loc" style={`--c: ${accentVar[acc]};`}>
              <div class="loc-head">
                <span class="num">{l.n}</span>
                <span class="badge">{l.status}</span>
              </div>
              <h3>{l.city}</h3>
              <p>{l.desc}</p>
              <span class="rule" aria-hidden="true" />
            </li>
          );
        })
      }
    </ol>

    <div class="advantage">
      <div class="adv-intro" data-reveal>
        <Eyebrow label="The Advantage" />
        <h2>One Team. <span class="hl">Global Capability.</span></h2>
        <p>
          Our distributed model brings together business leadership, specialized
          technology expertise, and delivery capabilities across markets — while
          maintaining a single standard for quality, communication, and
          accountability.
        </p>
      </div>
      <div class="adv-grid" data-reveal="stagger">
        {
          advantages.map((a, i) => (
            <div class="adv-card ix-card ix-card--quiet ix-light" style={`--c: ${accentVar[(['red', 'blue', 'plum'] as Accent[])[i]]};`}>
              <span class="adv-ic glass-icon"><Icon name={a.icon} size={24} /></span>
              <h4>{a.title}</h4>
              <p>{a.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .global {
    background: var(--surface);
  }
  .hl {
    color: var(--red);
  }
  .top {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 2.5rem;
    align-items: center;
  }
  .intro h2 {
    max-width: 14ch;
  }
  .intro p {
    color: var(--text-2);
    margin: 1rem 0 1.75rem;
    max-width: 46ch;
    line-height: 1.6;
  }
  .map {
    position: relative;
  }
  .map img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* A slow, faint ring breathing out of each pin (~2.8s cycle, offset per
     pin). Paused until the map has scrolled into view. */
  .pin {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 2.6%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border: 1.5px solid var(--c);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pin {
      animation: pin-pulse 2.8s cubic-bezier(0.2, 0.6, 0.35, 1) var(--pulse-delay) infinite;
    }
    :global(html.ix) .map:not(.is-in) .pin {
      animation-play-state: paused;
    }
    /* Each location's accent bar draws in as its card arrives. */
    :global(html.ix) .loc:global(.is-in) .rule {
      transform-origin: left center;
      animation: ix-draw 900ms var(--ix-ease) calc(var(--ix-d, 0ms) + 180ms) backwards;
    }
  }
  @keyframes pin-pulse {
    0% {
      transform: scale(0.6);
      opacity: 0;
    }
    18% {
      opacity: 0.55;
    }
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .locations {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1.25rem;
  }
  .loc {
    padding-top: 1rem;
  }
  .loc-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
  }
  .num {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .badge {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c);
  }
  .loc h3 {
    font-size: 1.05rem;
  }
  .loc p {
    color: var(--text-2);
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }
  .loc .rule {
    display: block;
    height: 3px;
    width: 100%;
    border-radius: 999px;
    background: var(--c);
    margin-top: 1rem;
    opacity: 0.85;
  }

  .advantage {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .adv-intro h2 {
    max-width: 16ch;
  }
  .adv-intro p {
    color: var(--text-2);
    margin-top: 1rem;
    max-width: 60ch;
    line-height: 1.6;
  }
  .adv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .adv-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }
  .adv-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: var(--radius);
    color: var(--c);
    margin-bottom: 0.9rem;
  }
  .adv-card h4 {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .adv-card p {
    color: var(--text-2);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .locations {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem 1.25rem;
    }
  }
  @media (max-width: 860px) {
    .top {
      grid-template-columns: 1fr;
    }
    .adv-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .locations {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
