---
/**
 * The platform in Home › Common Business Challenges, drawn in code
 * (2026-11-20): a 3D model in SVG that stands in for the picture
 * (public/home/challenges-visual.webp). Same scene: a tiled floor, the
 * stacked TLS platform with its red and blue edge light, four glass panels
 * (Business Problem, Lean Thinking, Right Solution, Measurable Results) and
 * the light that runs between them.
 *
 * The picture needed a blurred haze around it to hide its edges. The model
 * has no haze: its dark floor is a field of tiles that ends cleanly, whole in
 * the middle and thinning to dots at the rim, so the scene stands on the
 * page as part of it (Hemang, 2026-11-20).
 *
 * It has the picture's shape and keeps the platform in the same place, so
 * CommonChallenges positions it exactly as it did the picture.
 * Decorative: aria-hidden, like the picture's empty alt.
 *
 * Motion, only while it is on screen and never with reduced motion: the
 * platform's upper tiers and the panels float a few pixels, light travels
 * the traces toward the platform, and (with a mouse) the layers shift a
 * little with the pointer, nearer ones more, which gives the depth.
 */
import { href } from '../data/site';
import { W, H, O, base, middle, upper, cards, card, traces, grid, tiles, field } from './challengesModel';

const mark = { w: 196, h: 113 }; // the TLS mark lying on the top tier (foreshortened)
const tones = ['#7f8cff', '#4fb6ff', '#c77dff'];
---

<svg class="cm" viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-hidden="true" focusable="false">
  <defs>
    <!-- The floor: lit under the platform, dark around it. -->
    <radialGradient id="cm-floor" gradientUnits="userSpaceOnUse" cx={O[0]} cy={O[1] + 10} r="760" gradientTransform={`translate(0 ${O[1] * 0.42}) scale(1 0.58)`}>
      <stop offset="0" stop-color="#3a3f8f" />
      <stop offset="0.4" stop-color="#1c2152" />
      <stop offset="1" stop-color="#131837" />
    </radialGradient>
    <!-- The floor's outline: the tile field (challengesModel.ts). Crisp, no blur. -->
    <!-- Its bounds stop short of the drawing's own edges: a fill that reaches
         the very edge can show as a hairline while the drawing is scaled. -->
    <mask id="cm-mask" maskUnits="userSpaceOnUse" x="310" y="75" width="1170" height="860">
      {field.map((points) => <polygon points={points} fill="#fff" />)}
    </mask>
    {
      [
        ['red', '#ff4d5a'],
        ['blue', '#2f9bff'],
        ['violet', '#a45cff'],
      ].map(([name, c]) => (
        <radialGradient id={`cm-glow-${name}`}>
          <stop offset="0" stop-color={c} stop-opacity="0.55" />
          <stop offset="1" stop-color={c} stop-opacity="0" />
        </radialGradient>
      ))
    }
    <!-- The tiers: white tops, lavender sides. -->
    <linearGradient id="cm-top" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#e7e5fb" />
    </linearGradient>
    <linearGradient id="cm-side" gradientUnits="userSpaceOnUse" x1={base.left} y1="0" x2={base.right} y2="0">
      <stop offset="0" stop-color="#b3aee6" />
      <stop offset="0.5" stop-color="#dcdaf7" />
      <stop offset="1" stop-color="#a9b4ee" />
    </linearGradient>
    <!-- The edge light: red on the left, blue on the right. -->
    <linearGradient id="cm-edge" gradientUnits="userSpaceOnUse" x1={base.left} y1="0" x2={base.right} y2="0">
      <stop offset="0" stop-color="#ff3b4e" />
      <stop offset="0.5" stop-color="#b44dff" />
      <stop offset="1" stop-color="#1e9bff" />
    </linearGradient>
    <linearGradient id="cm-glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.96" />
      <stop offset="1" stop-color="#e9e6ff" stop-opacity="0.84" />
    </linearGradient>
    <filter id="cm-blur" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="9" />
    </filter>
    <filter id="cm-soft" x="-30%" y="-30%" width="160%" height="160%">
      <feGaussianBlur stdDeviation="22" />
    </filter>
  </defs>

  <!-- 1. The floor -->
  <g class="cm-layer" style="--z: -0.5">
    <g mask="url(#cm-mask)">
      <rect x="310" y="75" width="1170" height="860" fill="url(#cm-floor)" />
      {tiles.map((t) => <polygon points={t.points} fill={tones[t.tone % 3]} fill-opacity={0.07 + t.tone * 0.035} />)}
      {grid.map((d) => <path d={d} class="cm-grid" />)}
      <ellipse cx={O[0] - 330} cy={O[1] + 10} rx="330" ry="170" fill="url(#cm-glow-red)" />
      <ellipse cx={O[0] + 330} cy={O[1] - 10} rx="340" ry="175" fill="url(#cm-glow-blue)" />
      <ellipse cx={O[0]} cy={O[1] + 150} rx="400" ry="160" fill="url(#cm-glow-violet)" />
      {
        traces.map((t) => (
          <>
            <path d={t.d} class="cm-trace" stroke={t.c} stroke-opacity="0.3" stroke-width="8" filter="url(#cm-blur)" />
            <path d={t.d} class="cm-trace" stroke={t.c} stroke-opacity="0.75" />
            <circle cx={t.end[0]} cy={t.end[1]} r="5" fill="#fff" stroke={t.c} stroke-width="2.5" />
          </>
        ))
      }
      {
        cards.map((c) => (
          <>
            <path d={c.trace} class="cm-trace" stroke={c.c} stroke-opacity="0.55" stroke-width="10" filter="url(#cm-blur)" />
            <path d={c.trace} class="cm-trace" stroke={c.c} />
            <path d={c.trace} class="cm-flow" stroke="#fff" style={`--i: ${c.i}`} pathLength="100" />
            <ellipse cx={c.foot[0]} cy={c.foot[1]} rx="46" ry="22" fill={c.c} fill-opacity="0.4" filter="url(#cm-blur)" />
            <circle cx={c.foot[0]} cy={c.foot[1]} r="6" fill="#fff" stroke={c.c} stroke-width="3" />
          </>
        ))
      }
    </g>
  </g>

  <!-- 2. The platform: three tiers, light between them -->
  <g class="cm-layer" style="--z: 0.6">
    <ellipse cx={O[0]} cy={O[1] + 30} rx="390" ry="205" fill="#05071c" fill-opacity="0.55" filter="url(#cm-soft)" />
    <path d={base.edge} class="cm-edge-glow" filter="url(#cm-soft)" />
    <path d={base.side} fill="url(#cm-side)" />
    <path d={base.top} fill="url(#cm-top)" />
    <path d={base.rim} class="cm-rim" />

    <g class="cm-float cm-float--mid">
      <path d={middle.edge} class="cm-edge-glow" filter="url(#cm-soft)" />
      <path d={middle.edge} class="cm-edge" />
      <path d={middle.side} fill="url(#cm-side)" />
      <path d={middle.top} fill="url(#cm-top)" />
      <path d={middle.rim} class="cm-rim" />
    </g>

    <g class="cm-float cm-float--top">
      <path d={upper.edge} class="cm-edge-glow" filter="url(#cm-soft)" />
      <path d={upper.edge} class="cm-edge" />
      <path d={upper.side} fill="url(#cm-side)" />
      <path d={upper.top} fill="url(#cm-top)" />
      <path d={upper.rim} class="cm-rim" />
      <ellipse cx={upper.cap[0]} cy={upper.cap[1] + 8} rx="92" ry="48" fill="#6a5fd0" fill-opacity="0.2" filter="url(#cm-blur)" />
      <image
        href={href('/brand/tls-mark-320.webp')}
        x={upper.cap[0] - mark.w / 2}
        y={upper.cap[1] - mark.h / 2}
        width={mark.w}
        height={mark.h}
        preserveAspectRatio="none"
      />
    </g>
  </g>

  <!-- 3. The four glass panels -->
  {
    cards.map((c) => (
      <g class="cm-layer" style="--z: 1.4">
        <g class="cm-float cm-float--card" style={`--i: ${c.i}`}>
          <path d={c.stem} stroke={c.c} stroke-width="2" stroke-dasharray="3 6" stroke-opacity="0.8" />
          <g transform={c.matrix}>
            <rect width={card.w} height={card.h} rx="22" fill={c.c} fill-opacity="0.3" filter="url(#cm-blur)" />
            <rect width={card.w} height={card.h} rx="22" transform={c.depth} fill="#cfcaf5" fill-opacity="0.8" />
            <rect width={card.w} height={card.h} rx="22" fill="url(#cm-glass)" stroke={c.c} stroke-width="2.5" />
            <rect x="5" y="5" width={card.w - 10} height={card.h - 10} rx="18" fill="none" stroke="#fff" stroke-opacity="0.9" stroke-width="1.5" />
            <g transform="translate(26 44) scale(1.18)" stroke={c.ink} fill={c.ink} stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
              {
                c.key === 'problem' && (
                  <>
                    <rect x="2" y="40" width="11" height="22" rx="2" fill="none" />
                    <rect x="24" y="26" width="11" height="36" rx="2" stroke="none" />
                    <rect x="46" y="12" width="11" height="50" rx="2" stroke="none" />
                    <path d="M3 26 L22 12 L33 18 L56 0" fill="none" />
                  </>
                )
              }
              {
                c.key === 'thinking' && (
                  <>
                    <circle cx="32" cy="32" r="22" fill="none" stroke-width="9" stroke-dasharray="8.64 8.64" stroke-linecap="butt" />
                    <circle cx="32" cy="32" r="16" fill="none" />
                    <circle cx="32" cy="32" r="5" stroke="none" />
                  </>
                )
              }
              {
                c.key === 'solution' && (
                  <>
                    <path d="M32 2a20 20 0 0 0-12 36c3 2.4 4 5 4 8h16c0-3 1-5.6 4-8A20 20 0 0 0 32 2z" fill="none" />
                    <path d="M25 56h14M28 64h8" fill="none" />
                    <path d="M32 44V28M26 24l6 5 6-5" fill="none" stroke-width="3.5" />
                  </>
                )
              }
              {
                c.key === 'results' && (
                  <>
                    <rect x="4" y="38" width="12" height="24" rx="3" stroke="none" />
                    <rect x="26" y="22" width="12" height="40" rx="3" stroke="none" />
                    <rect x="48" y="4" width="12" height="58" rx="3" stroke="none" />
                  </>
                )
              }
            </g>
            <text x="122" y="66" class="cm-label">{c.l1}</text>
            <text x="122" y="100" class="cm-label">{c.l2}</text>
            <rect x="122" y="118" width="128" height="7" rx="3.5" fill="#bdb9e4" />
            <rect x="122" y="134" width="84" height="7" rx="3.5" fill="#d2cff0" />
          </g>
        </g>
      </g>
    ))
  }
</svg>

<script>
  /**
   * Runs the model's motion only while it is on screen, and lets the layers
   * follow the pointer a little (mouse only). Nothing runs with reduced
   * motion: the model is then a still picture.
   */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  for (const svg of document.querySelectorAll<SVGSVGElement>('svg.cm')) {
    if (reduce.matches) continue;
    new IntersectionObserver(([e]) => svg.classList.toggle('is-live', e.isIntersecting), { threshold: 0.15 }).observe(svg);

    const section = svg.closest<HTMLElement>('section');
    if (!section || !window.matchMedia('(hover: hover) and (pointer: fine)').matches) continue;
    let frame = 0;
    section.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse' || frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const r = section.getBoundingClientRect();
        svg.style.setProperty('--px', ((e.clientX - r.left) / r.width - 0.5).toFixed(3));
        svg.style.setProperty('--py', ((e.clientY - r.top) / r.height - 0.5).toFixed(3));
      });
    });
    section.addEventListener('pointerleave', () => {
      svg.style.setProperty('--px', '0');
      svg.style.setProperty('--py', '0');
    });
  }
</script>

<style>
  .cm {
    display: block;
    width: 100%;
    height: auto;
    --px: 0;
    --py: 0;
  }
  .cm-grid {
    fill: none;
    stroke: #9aa5ff;
    stroke-opacity: 0.26;
    stroke-width: 1.4;
  }
  .cm-trace {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* A light that travels each trace toward the platform. Still: not shown. */
  .cm-flow {
    fill: none;
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 9 91;
    stroke-dashoffset: 9;
    opacity: 0;
  }
  .cm-rim {
    fill: none;
    stroke: #fff;
    stroke-width: 2;
    stroke-opacity: 0.95;
  }
  .cm-edge {
    fill: none;
    stroke: url(#cm-edge);
    stroke-width: 7;
    stroke-linecap: round;
  }
  .cm-edge-glow {
    fill: none;
    stroke: url(#cm-edge);
    stroke-width: 34;
    stroke-linecap: round;
    opacity: 0.95;
  }
  .cm-label {
    font-family: var(--font-head);
    font-size: 29px;
    font-weight: 700;
    fill: #17172e;
  }

  /* Depth: each layer shifts with the pointer, nearer layers more. */
  .cm-layer {
    translate: calc(var(--px) * var(--z) * -22px) calc(var(--py) * var(--z) * -14px);
    transition: translate 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cm-float {
      animation: cm-float 7s ease-in-out infinite paused;
    }
    .cm-float--mid {
      --lift: -4px;
      animation-delay: -1.2s;
    }
    .cm-float--top {
      --lift: -9px;
    }
    .cm-float--card {
      --lift: -7px;
      animation-duration: 8s;
      animation-delay: calc(var(--i) * -1.9s);
    }
    .cm-edge-glow {
      animation: cm-breathe 4.5s ease-in-out infinite paused;
    }
    .cm.is-live :is(.cm-float, .cm-edge-glow) {
      animation-play-state: running;
    }
    .cm.is-live .cm-flow {
      animation: cm-flow 3.6s linear infinite;
      animation-delay: calc(var(--i) * 0.9s);
    }
  }
  @keyframes cm-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 var(--lift, -6px);
    }
  }
  @keyframes cm-breathe {
    0%,
    100% {
      opacity: 0.6;
    }
    50% {
      opacity: 1;
    }
  }
  @keyframes cm-flow {
    0% {
      stroke-dashoffset: 9;
      opacity: 0;
    }
    10%,
    85% {
      opacity: 0.95;
    }
    100% {
      stroke-dashoffset: -91;
      opacity: 0;
    }
  }
</style>
