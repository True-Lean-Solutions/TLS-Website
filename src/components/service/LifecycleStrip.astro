---
/**
 * Diagram 06: the employee technology lifecycle (Managed IT, 2026-11-18).
 * Join, work, leave: what happens to a person's account, device and access
 * at each point. A compact strip, not an animation: the three columns are
 * the picture, joined by one line.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../iconTypes';

export interface LifeStage {
  title: string;
  line: string;
  icon: IconName;
  items: string[];
}

interface Props {
  title: string;
  lead: string;
  stages: LifeStage[];
}
const { title, lead, stages } = Astro.props;
---

<div class="ls-intro" data-reveal>
  <h3>{title}</h3>
  <p>{lead}</p>
</div>
<ol class="ls" data-reveal="stagger">
  {
    stages.map((s, i) => (
      <li class="ls-stage" style={`--i: ${i}`}>
        <div class="ls-head">
          <span class="ls-ico glass-icon" aria-hidden="true">
            <Icon name={s.icon} size={22} />
          </span>
          <div>
            <h4>{s.title}</h4>
            <p>{s.line}</p>
          </div>
        </div>
        <ul>
          {s.items.map((it) => (
            <li>{it}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ol>

<style>
  .ls-intro {
    margin-bottom: 1.25rem;
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--border-2);
  }
  .ls-intro h3 {
    margin: 0 0 0.4rem;
    font-size: 1.2rem;
  }
  .ls-intro p {
    margin: 0;
    max-width: 62ch;
    color: var(--text-2);
    line-height: 1.6;
  }
  .ls {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  /* One line across the three stages: red to blue. */
  .ls::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--grad-h);
  }
  .ls-stage {
    padding: 1.5rem 1.4rem 1.4rem;
  }
  .ls-stage + .ls-stage {
    border-left: 1px solid var(--border);
  }
  .ls-head {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }
  .ls-ico {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    color: var(--blue-text);
  }
  .ls-stage:first-child .ls-ico {
    color: var(--red-text);
  }
  .ls-stage:nth-child(2) .ls-ico {
    color: var(--plum);
  }
  .ls-head h4 {
    margin: 0;
    font-family: var(--font-head);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ls-head p {
    margin: 0.1rem 0 0;
    font-size: 0.85rem;
    color: var(--text-2);
  }
  .ls-stage ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .ls-stage ul li {
    position: relative;
    padding-left: 1.35rem;
    font-size: 0.92rem;
    line-height: 1.45;
  }
  /* A check. */
  .ls-stage ul li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.3em;
    width: 0.32rem;
    height: 0.6rem;
    border: solid var(--blue-text);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  @media (max-width: 820px) {
    .ls {
      grid-template-columns: minmax(0, 1fr);
    }
    .ls-stage + .ls-stage {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
