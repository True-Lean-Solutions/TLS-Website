---
/**
 * A band of capability chips that glide sideways with the scroll
 * (2026-11-18; chips since 2026-11-19, replacing two rows of large type
 * whose outlined row showed the font's overlapping contours). Two rows of
 * glass chips, each with its icon, move in opposite directions (progress --p
 * from scrub.ts) and fade out at the edges. Decorative: the same capabilities
 * are listed in the cards below. Without motion the rows sit still.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../iconTypes';

export interface BandItem {
  label: string;
  icon: IconName;
}

interface Props {
  items: BandItem[];
}
const { items } = Astro.props;
const half = Math.ceil(items.length / 2);
const rows = [items.slice(0, half), items.slice(half)];
const tones = ['var(--red)', '#5cc3ff', '#c084fc'];
---

<div class="band" data-scrub data-scrub-start="top bottom" data-scrub-end="bottom top" aria-hidden="true">
  <div class="band-rows">
  {
    rows.map((row, r) => (
      <ul class:list={['band-row', `band-row--${r}`]}>
        {[...row, ...row, ...row].map((it, i) => (
          <li class="band-chip" style={`--t: ${tones[(i + r) % tones.length]}`}>
            <span class="band-icon">
              <Icon name={it.icon} size={20} />
            </span>
            {it.label}
          </li>
        ))}
      </ul>
    ))
  }
  </div>
</div>

<style>
  .band {
    position: relative;
    overflow: clip;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    background:
      radial-gradient(50% 120% at 50% 0%, rgba(18, 136, 207, 0.14), transparent 70%),
      #0b0f1c;
    border-block: 1px solid rgba(255, 255, 255, 0.08);
  }
  /* The chips (not the band) fade in and out at the edges instead of being cut off. */
  .band-rows {
    display: grid;
    gap: 0.9rem;
    mask-image: linear-gradient(90deg, transparent 0, #000 9%, #000 91%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 9%, #000 91%, transparent);
  }
  /* A hairline of the brand gradient along the top. */
  .band::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--grad-h);
    opacity: 0.7;
  }
  .band-row {
    display: flex;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
    width: max-content;
    will-change: transform;
  }
  .band-row--0 {
    transform: translateX(calc(-6% - var(--p, 0.5) * 16%));
  }
  .band-row--1 {
    transform: translateX(calc(-24% + var(--p, 0.5) * 16%));
  }
  .band-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1.35rem 0.6rem 0.65rem;
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.03));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.12);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .band-row--1 .band-chip {
    color: rgba(255, 255, 255, 0.78);
    background: rgba(255, 255, 255, 0.035);
  }
  .band-icon {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    color: var(--t);
    background: color-mix(in srgb, var(--t) 16%, transparent);
    border: 1px solid color-mix(in srgb, var(--t) 40%, transparent);
  }
  @media (max-width: 640px) {
    .band-rows {
      gap: 0.65rem;
    }
    .band-row {
      gap: 0.65rem;
    }
    .band-chip {
      gap: 0.55rem;
      padding: 0.45rem 1rem 0.45rem 0.45rem;
    }
    .band-icon {
      width: 2rem;
      height: 2rem;
    }
  }
</style>
