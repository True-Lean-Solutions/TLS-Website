---
/**
 * How an engagement runs, as one connected rail (2026-11-18, after the Data &
 * Analytics strategy steps): numbered nodes on a red-to-blue line, an icon,
 * a title and a line of text per step. The line draws with the scroll and
 * each step lights as the line reaches it (scroll layer: scrub.ts); without
 * motion it is complete. Phones: the rail runs down the left edge.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../iconTypes';

export interface RailStep {
  title: string;
  text: string;
  icon: IconName;
}

interface Props {
  steps: RailStep[];
}
const { steps } = Astro.props;
const tones = [
  '--c: var(--red); --c-text: var(--red-text);',
  '--c: var(--blue); --c-text: var(--blue-text);',
  '--c: var(--plum); --c-text: var(--plum);',
];
const n = steps.length;
const half = 50 / n; // first and last node centers, in % of the width
const gid = `rail-g-${n}-${steps[0]?.title.length ?? 0}`;
---

<div class="rail" data-scrub data-scrub-start="top 86%" data-scrub-end="bottom 70%" style={`--n: ${n}`}>
  <svg class="rail-line" viewBox="0 0 100 2" preserveAspectRatio="none" aria-hidden="true" style={`left: ${half}%; width: ${100 - 2 * half}%`}>
    <defs>
      <!-- userSpaceOnUse: a flat line has a zero-height box, so a bounding-box
           gradient would not paint at all. -->
      <linearGradient id={gid} gradientUnits="userSpaceOnUse" x1="0" y1="1" x2="100" y2="1">
        <stop offset="0" stop-color="#D94040" />
        <stop offset="0.5" stop-color="#873662" />
        <stop offset="1" stop-color="#1288CF" />
      </linearGradient>
    </defs>
    <line class="rail-track" x1="0" y1="1" x2="100" y2="1" />
    <line class="rail-fill scrub-path" x1="0" y1="1" x2="100" y2="1" stroke={`url(#${gid})`} />
  </svg>
  <ol class="rail-steps">
    {
      steps.map((s, i) => (
        <li class="rail-step" style={tones[i % 3]} data-at={n > 1 ? ((i / (n - 1)) * 0.92).toFixed(2) : '0'}>
          <span class="rail-node" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="rail-icon" aria-hidden="true">
            <Icon name={s.icon} size={20} />
          </span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .rail {
    position: relative;
  }
  .rail-line {
    position: absolute;
    top: 21px;
    height: 2px;
    overflow: visible;
  }
  .rail-track {
    stroke: var(--border-2);
    stroke-width: 2;
  }
  .rail-fill {
    stroke-width: 2;
  }
  .rail-steps {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 1.25rem;
  }
  .rail-step {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.55rem;
    padding-inline: 0.25rem;
  }
  .rail-node {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--c);
    color: var(--c-text);
    font-family: var(--font-head);
    font-size: 0.82rem;
    font-weight: 700;
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--c) 10%, transparent);
    transition:
      border-color var(--ix-base) var(--ix-ease),
      color var(--ix-base) var(--ix-ease),
      box-shadow var(--ix-base) var(--ix-ease),
      transform var(--ix-base) var(--ix-ease);
  }
  .rail-icon {
    margin-top: 0.4rem;
    display: inline-flex;
    color: var(--c);
  }
  .rail-step h3 {
    font-size: 1.02rem;
    line-height: 1.3;
  }
  .rail-step p {
    color: var(--text-2);
    font-size: 0.9rem;
    line-height: 1.55;
    max-width: 26ch;
  }

  /* With the scroll: steps wait (quiet) until the line reaches them. */
  .rail:global(.is-scrub) .rail-step:not(:global(.is-on)) .rail-node {
    border-color: var(--border-2);
    color: var(--muted);
    box-shadow: none;
    transform: scale(0.92);
  }
  .rail:global(.is-scrub) .rail-step:not(:global(.is-on)) :is(.rail-icon, h3, p) {
    opacity: 0.45;
  }
  .rail-step :is(.rail-icon, h3, p) {
    transition: opacity var(--ix-base) var(--ix-ease);
  }

  @media (max-width: 860px) {
    .rail-line {
      display: none;
    }
    .rail-steps {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
    /* The rail runs down the left edge, through every node. */
    .rail-steps::before {
      content: '';
      position: absolute;
      left: 21px;
      top: 22px;
      bottom: 22px;
      width: 2px;
      background: linear-gradient(180deg, var(--red), var(--plum), var(--blue));
      opacity: 0.7;
    }
    .rail-step {
      grid-template-columns: 44px minmax(0, 1fr);
      justify-items: start;
      text-align: left;
      column-gap: 1rem;
      row-gap: 0.25rem;
      padding: 0;
    }
    .rail-node {
      grid-row: span 3;
    }
    .rail-icon {
      display: none;
    }
    .rail-step p {
      max-width: none;
    }
  }
</style>
