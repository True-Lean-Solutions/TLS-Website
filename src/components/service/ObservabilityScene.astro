---
/**
 * Diagram 08: application observability (Managed IT, 2026-11-18). A request
 * crosses an application, its API, a database and an external service, and
 * each of them reports to one observability layer. When the external service
 * slows down, the signals show where the time is going.
 *
 * Monitoring is shown as something that narrows a search for a person; it
 * does not find the cause or fix anything by itself. Sample signals only:
 * shapes and status words, no figures.
 *
 * Stages (StagedFigure): 1 a request · 2 signals · 3 a dependency slows ·
 * 4 traces point at it · 5 fixed, back in range. Without motion: the last
 * stage.
 */
import StagedFigure, { type Stage } from './StagedFigure.astro';
import DiagramNode from './DiagramNode.astro';

const stages: Stage[] = [
  { title: 'Request', text: 'A business transaction travels from the user through the application and its API to the database and an external service.' },
  { title: 'Observe', text: 'Each component reports metrics, logs, traces and availability to one observability layer.' },
  { title: 'Degrade', text: 'Calls to the external service slow down, and response time rises for users.' },
  { title: 'Correlate', text: 'Traces show where the extra time is being spent, which narrows the search. A person still confirms the cause.' },
  { title: 'Recover', text: 'A fix is applied, in this example a timeout with a fallback, and response time returns to its normal range.' },
];

type P = [number, number];
const user: P = [9, 22];
const app: P = [32, 22];
const api: P = [55, 22];
const db: P = [82, 22];
const ext: P = [64, 49];
const PANEL = 63;
const L = (...ps: P[]) => 'M' + ps.map((p) => p.join(' ')).join(' L');
const request = [L(user, app), L(app, api), L(api, db)];
const toExt = L(api, ext);
const signals = [L(app, [app[0], PANEL]), L(api, [api[0], PANEL]), L(db, [db[0], PANEL]), L(ext, [ext[0], PANEL])];
---

<StagedFigure note="Illustrative sample signals" stages={stages}>
  <div class="dg-zone" style="left: 20%; top: 5%; width: 76%; height: 29%">
    <span class="dg-zone-lbl">Cloud hosting</span>
  </div>

  <svg class="dg-links" viewBox="0 0 100 100" preserveAspectRatio="none">
    <!-- 1. The request -->
    <g class="sf-from" style="--k: 1">
      {request.map((d) => <path class="dg-link" d={d} />)}
      <path class="dg-link" d={toExt} />
      {request.map((d) => <path class="dg-flow" d={d} />)}
      <path class="dg-flow sf-not" d={toExt} style="--k: 3" />
    </g>
    <!-- 2. Signals to the observability layer -->
    <g class="sf-from" style="--k: 2">
      {signals.map((d) => <path class="dg-link ob-signal" d={d} />)}
      {signals.map((d) => <path class="dg-flow ob-signal-flow" d={d} />)}
    </g>
    <!-- 3 and 4. The slow dependency -->
    <g class="sf-span" style="--k: 3; --e: 4">
      <path class="dg-link ob-slow" d={toExt} />
      <path class="dg-flow ob-slow-flow" d={toExt} style="--c: #fbbf24" />
    </g>
  </svg>

  <DiagramNode p={user} label="User" icon="user" side="up" tone="rgba(255,255,255,0.85)" />
  <DiagramNode p={app} label="Application" icon="monitor" side="up" />
  <DiagramNode p={api} label="API" glyph="api" side="up" />
  <DiagramNode p={db} label="Database" icon="database" side="up" />
  <DiagramNode p={ext} label="External service" icon="integration" side="r" tone="#c9a0ff">
    <i class="dg-halo sf-span" style="--k: 3; --e: 4; --h: #fbbf24"></i>
    <i class="dg-halo sf-at" style="--k: 5; --h: #34d399"></i>
  </DiagramNode>
  <span class="ob-state">
    <span class="dg-badge dg-badge--warn sf-at" style="--k: 3">Slow response</span>
    <span class="dg-badge dg-badge--warn sf-at" style="--k: 4">Being investigated</span>
    <span class="dg-badge dg-badge--ok sf-from" style="--k: 5">Back in range</span>
  </span>

  <div class="ob-panel glass-panel glass-panel--dark sf-from" style="--k: 2">
    <span class="ob-head">Observability</span>
    <div class="ob-lanes">
      <div class="ob-lane">
        <span>Metrics</span>
        <svg viewBox="0 0 60 22">
          <path class="ob-line sf-not" style="--k: 3" d="M2 15 L12 13 L22 15 L32 12 L42 14 L58 13" />
          <path class="ob-line ob-line--warn sf-span" style="--k: 3; --e: 4" d="M2 15 L12 13 L22 14 L32 10 L42 6 L58 3" />
        </svg>
      </div>
      <div class="ob-lane">
        <span>Logs</span>
        <svg viewBox="0 0 60 22">
          <rect class="ob-bar" x="2" y="3" width="40" height="2.6" rx="1.3" />
          <rect class="ob-bar" x="2" y="9.7" width="54" height="2.6" rx="1.3" />
          <rect class="ob-bar" x="2" y="16.4" width="30" height="2.6" rx="1.3" />
        </svg>
      </div>
      <div class="ob-lane ob-lane--traces">
        <i class="ob-focus sf-at" style="--k: 4"></i>
        <span>Traces</span>
        <svg viewBox="0 0 60 22">
          <rect class="ob-span" x="2" y="3" width="56" height="3" rx="1.5" />
          <rect class="ob-span" x="6" y="9.5" width="18" height="3" rx="1.5" />
          <rect class="ob-span sf-not" style="--k: 3" x="28" y="16" width="10" height="3" rx="1.5" />
          <rect class="ob-span ob-span--warn sf-span" style="--k: 3; --e: 4" x="28" y="16" width="30" height="3" rx="1.5" />
        </svg>
      </div>
      <div class="ob-lane">
        <span>Availability</span>
        <svg viewBox="0 0 60 22">
          {[0, 1, 2, 3, 4, 5].map((i) => <circle class="ob-up" cx={6 + i * 9.6} cy="11" r="3" />)}
        </svg>
      </div>
    </div>
  </div>
</StagedFigure>

<style>
  .ob-signal {
    stroke: rgba(255, 255, 255, 0.16);
  }
  .ob-signal-flow {
    --c: rgba(160, 205, 255, 0.75);
    stroke-width: 1.5;
    stroke-dasharray: 1.5 9;
  }
  .ob-slow {
    stroke: rgba(251, 191, 36, 0.85);
  }
  /* A slower march on the slow link. */
  :global(.sf.is-seq) .ob-slow-flow {
    animation-duration: 3.2s;
  }
  .ob-state {
    position: absolute;
    left: 43%;
    top: 49%;
  }
  .ob-state .dg-badge {
    left: 0;
    top: 0;
  }
  .ob-panel {
    position: absolute;
    left: 5%;
    right: 5%;
    top: 63%;
    bottom: 5%;
    border-radius: 16px;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    padding: 0.7rem 0.9rem 0.8rem;
  }
  .ob-head {
    font-family: var(--font-head);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }
  .ob-lanes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
    align-items: end;
  }
  .ob-lane {
    position: relative;
    display: grid;
    gap: 0.35rem;
    padding: 0.4rem 0.45rem;
    border-radius: 8px;
  }
  .ob-lane span {
    position: relative;
    font-family: var(--font-head);
    font-size: 0.66rem;
    font-weight: 600;
    color: #fff;
  }
  .ob-lane svg {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  /* The lane that holds the answer. */
  .ob-focus {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.55);
  }
  .ob-line {
    fill: none;
    stroke: #5cc3ff;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ob-line--warn {
    stroke: #fbbf24;
  }
  .ob-bar {
    fill: rgba(255, 255, 255, 0.38);
  }
  .ob-span {
    fill: #5cc3ff;
  }
  .ob-span--warn {
    fill: #fbbf24;
  }
  .ob-up {
    fill: #34d399;
  }
  @media (max-width: 640px) {
    .ob-panel {
      left: 4%;
      right: 4%;
      padding: 0.55rem 0.6rem 0.6rem;
    }
    .ob-lanes {
      gap: 0.25rem;
    }
    .ob-lane {
      padding: 0.3rem;
    }
    .ob-lane span {
      font-size: 0.56rem;
    }
    .ob-state {
      left: 36%;
    }
  }
</style>
