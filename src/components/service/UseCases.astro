---
/**
 * Illustrative use cases (2026-11-18): how a common situation would be
 * approached. These are NOT client case studies. Every card carries an
 * "Illustrative scenario" label, and none names a client or states a result
 * that was achieved. When a verified project exists, it belongs in Insights
 * as a case study, linked from here.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../iconTypes';
import type { Accent } from '../../data/services';

export interface UseCase {
  title: string;
  /** The situation the business is in. */
  challenge: string;
  /** The steps of the approach, in order. */
  approach: string[];
  /** What the work is meant to achieve. An aim, not a result. */
  aim: string;
  icon: IconName;
}

interface Props {
  cases: UseCase[];
}
const { cases } = Astro.props;
const tones: Accent[] = ['red', 'blue', 'plum', 'blue'];
const colors: Record<Accent, string> = {
  red: '--c: var(--red); --ct: var(--red-text);',
  blue: '--c: var(--blue); --ct: var(--blue-text);',
  plum: '--c: var(--plum); --ct: var(--plum);',
};
---

<ul class="uc" data-reveal="stagger">
  {
    cases.map((c, i) => (
      <li class="uc-card ix-card ix-card--quiet ix-light" style={colors[tones[i % tones.length]]}>
        <div class="uc-top">
          <span class="uc-ico glass-icon" aria-hidden="true">
            <Icon name={c.icon} size={22} />
          </span>
          <span class="uc-tag">Illustrative scenario</span>
        </div>
        <h3>{c.title}</h3>
        <p class="uc-challenge">{c.challenge}</p>
        <p class="uc-label">How we would approach it</p>
        <ol class="uc-steps">
          {c.approach.map((s) => (
            <li>{s}</li>
          ))}
        </ol>
        <p class="uc-aim">
          <span>Aim</span>
          {c.aim}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .uc {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .uc-card {
    display: flex;
    flex-direction: column;
    padding: 1.6rem;
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .uc-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .uc-ico {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 12px;
    color: var(--ct);
  }
  .uc-tag {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px dashed var(--border-2);
    font-family: var(--font-head);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .uc-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .uc-challenge {
    margin: 0 0 1.1rem;
    color: var(--text-2);
    line-height: 1.6;
  }
  .uc-label {
    margin: 0 0 0.6rem;
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ct);
  }
  .uc-steps {
    list-style: none;
    margin: 0 0 1.2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    counter-reset: uc;
  }
  .uc-steps li {
    counter-increment: uc;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    background: var(--section);
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--ink);
  }
  .uc-steps li::before {
    content: counter(uc);
    font-family: var(--font-head);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ct);
  }
  .uc-aim {
    margin: auto 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--ink);
  }
  .uc-aim span {
    margin-right: 0.5rem;
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  @media (max-width: 820px) {
    .uc {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
