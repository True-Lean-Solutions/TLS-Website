---
/**
 * Small code-drawn illustrations for capability cards (2026-11-18, after the
 * Data & Analytics capability bento). Each shows what the capability does, in
 * the card's accent (--c). Decorative: the card's heading and list carry the
 * meaning. On hover the picture does one small thing (a ticket resolves, a
 * pulse travels, a copy syncs); reduced motion keeps it still.
 */
import type { ArtName } from './art';

interface Props {
  name: ArtName;
}
const { name } = Astro.props;

const bars = [10, 18, 28, 16, 34, 22, 40, 26, 36, 18, 30, 14, 24, 12, 8];
---

<svg class="sa" viewBox="0 0 320 150" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={`sa-dots-${name}`} width="14" height="14" patternUnits="userSpaceOnUse">
      <circle cx="1" cy="1" r="0.9" class="sa-dot" />
    </pattern>
  </defs>
  <rect width="320" height="150" fill={`url(#sa-dots-${name})`} />

  {
    name === 'desk' && (
      <g>
        <circle class="sa-acc" cx="34" cy="38" r="15" />
        <path class="sa-ink-w" d="M27 40v-2a7 7 0 0114 0v2M26 39h3v6h-3zM39 39h3v6h-3z" />
        {[0, 1, 2].map((i) => (
          <g class={`sa-ticket sa-ticket--${i}`} transform={`translate(0 ${i * 38})`}>
            <rect class="sa-card" x="64" y="20" width="236" height="30" rx="9" />
            <circle class="sa-soft" cx="82" cy="35" r="8" />
            <rect class="sa-bar" x="98" y="29" width="78" height="5" rx="2.5" />
            <rect class="sa-bar sa-bar--lt" x="98" y="38" width="50" height="4" rx="2" />
          </g>
        ))}
        <g class="sa-pill sa-pill--ok">
          <rect x="226" y="27" width="64" height="16" rx="8" />
          <text x="258" y="38.3">Resolved</text>
        </g>
        <g class="sa-pill sa-pill--warn" transform="translate(0 38)">
          <rect x="226" y="27" width="64" height="16" rx="8" />
          <text x="258" y="38.3">In progress</text>
        </g>
        <g class="sa-pill sa-pill--new" transform="translate(0 76)">
          <rect x="226" y="27" width="64" height="16" rx="8" />
          <text x="258" y="38.3">New</text>
        </g>
      </g>
    )
  }

  {
    name === 'health' && (
      <g>
        <path class="sa-grid" d="M20 40H262M20 75H262M20 110H262" />
        <path class="sa-acc-line sa-trace" d="M20 92H66L80 60 94 114 108 80H150L164 52 178 104 190 86H262" pathLength="100" />
        {[66, 150, 262].map((x) => (
          <g transform={`translate(${x} ${x === 66 ? 92 : x === 150 ? 80 : 86})`}>
            <circle class="sa-ok" r="6" />
            <path class="sa-ink-w" d="M-2.6 0l1.8 1.8 3.4-3.4" />
          </g>
        ))}
        <g class="sa-pill sa-pill--ok">
          <rect x="20" y="14" width="74" height="16" rx="8" />
          <text x="57" y="25.3">All healthy</text>
        </g>
        <g transform="translate(276 54)">
          <rect class="sa-card" width="34" height="18" rx="4" />
          <rect class="sa-card" y="22" width="34" height="18" rx="4" />
          <circle class="sa-ok" cx="8" cy="9" r="2.2" />
          <circle class="sa-ok" cx="8" cy="31" r="2.2" />
          <rect class="sa-bar sa-bar--lt" x="14" y="7.5" width="14" height="3" rx="1.5" />
          <rect class="sa-bar sa-bar--lt" x="14" y="29.5" width="14" height="3" rx="1.5" />
        </g>
      </g>
    )
  }

  {
    name === 'backup' && (
      <g>
        {[
          [80, 'Primary'],
          [240, 'Copy'],
        ].map(([cx, label]) => (
          <g transform={`translate(${cx} 38)`}>
            <path class="sa-card" d="M-36 0v58a36 11 0 0072 0V0" />
            <ellipse class="sa-soft-strong" cx="0" cy="0" rx="36" ry="11" />
            <path class="sa-grid" d="M-36 20a36 11 0 0072 0M-36 39a36 11 0 0072 0" />
            <text class="sa-label" x="0" y="92">
              {label}
            </text>
          </g>
        ))}
        <path class="sa-acc-line sa-sync" d="M120 64Q160 28 200 64" />
        <path class="sa-acc-line" d="M194 56l6 8-10 2" />
        <g class="sa-pill sa-pill--ok">
          <rect x="116" y="104" width="88" height="16" rx="8" />
          <text x="160" y="115.3">Restore tested</text>
        </g>
      </g>
    )
  }

  {
    name === 'cloud' && (
      <g>
        <path
          class="sa-cloud"
          d="M98 72a26 26 0 015-51 38 38 0 0172-6 30 30 0 0150 22 25 25 0 01-6 35z"
        />
        <rect class="sa-card sa-ghost" x="138" y="40" width="44" height="22" rx="6" />
        <text class="sa-label" x="160" y="55">
          App
        </text>
        {[
          [92, 'Data'],
          [160, 'Files'],
          [228, 'Mail'],
        ].map(([x, l], i) => (
          <g class={`sa-wl sa-wl--${i}`}>
            <path class="sa-arrow" d={`M${x} 112V84`} />
            <rect class="sa-card" x={Number(x) - 24} y="112" width="48" height="24" rx="6" />
            <text class="sa-label" x={x} y="128">
              {l}
            </text>
          </g>
        ))}
      </g>
    )
  }

  {
    name === 'network' && (
      <g>
        {[
          [58, 34],
          [58, 116],
          [262, 34],
          [262, 116],
          [160, 136],
        ].map(([x, y], i) => (
          <path class:list={['sa-link', { 'sa-link--hot': i === 2 }]} d={`M160 70L${x} ${y}`} />
        ))}
        <circle class="sa-packet" r="3.2" cx="160" cy="70" />
        {[
          [58, 34],
          [58, 116],
          [262, 34],
          [262, 116],
          [160, 136],
        ].map(([x, y]) => (
          <g transform={`translate(${x} ${y})`}>
            <circle class="sa-card" r="11" />
            <circle class="sa-soft-strong" r="4" />
          </g>
        ))}
        <g transform="translate(160 70)">
          <rect class="sa-acc" x="-30" y="-15" width="60" height="30" rx="8" />
          <path class="sa-ink-w" d="M-16 -4h32M-16 4h32" />
          <circle class="sa-dot-w" cx="-10" cy="-4" r="1.6" />
          <circle class="sa-dot-w" cx="0" cy="-4" r="1.6" />
          <circle class="sa-dot-w" cx="10" cy="-4" r="1.6" />
        </g>
      </g>
    )
  }

  {
    name === 'workplace' && (
      <g>
        <path class="sa-floor" d="M160 18L292 82 160 146 28 82z" />
        <path class="sa-grid" d="M94 50L226 114M226 50L94 114" />
        {[
          [160, 52],
          [214, 80],
          [116, 92],
          [168, 114],
        ].map(([x, y]) => (
          <path class="sa-cable" d={`M74 76L${x} ${y}`} />
        ))}
        {[
          [160, 52],
          [214, 80],
          [116, 92],
          [168, 114],
        ].map(([x, y]) => (
          <g transform={`translate(${x} ${y})`}>
            <path class="sa-card" d="M0 -9L18 0 0 9 -18 0z" />
            <path class="sa-side" d="M-18 0v5L0 14V9zM18 0v5L0 14V9z" />
          </g>
        ))}
        <g transform="translate(74 76)">
          <path class="sa-acc" d="M-12 -38L0 -44 12 -38V0L0 6 -12 0z" />
          <path class="sa-ink-w" d="M-7 -30h14M-7 -22h14M-7 -14h14" />
        </g>
      </g>
    )
  }

  {
    name === 'comms' && (
      <g>
        <g transform="translate(46 34)">
          <rect class="sa-card" width="40" height="72" rx="9" />
          <rect class="sa-soft" x="5" y="9" width="30" height="48" rx="4" />
          <circle class="sa-bar" cx="20" cy="64" r="2.6" />
        </g>
        <g transform="translate(218 42)">
          <rect class="sa-card" width="64" height="44" rx="6" />
          <rect class="sa-soft" x="5" y="5" width="54" height="34" rx="3" />
          <path class="sa-card" d="M-8 52h80l-6-8H-2z" />
        </g>
        {bars.map((h, i) => (
          <rect class="sa-wave" x={102 + i * 7.6} y={75 - h / 2} width="4" height={h} rx="2" style={`--i: ${i}`} />
        ))}
        <g class="sa-pill sa-pill--ok">
          <rect x="112" y="118" width="96" height="16" rx="8" />
          <text x="160" y="129.3">Call connected</text>
        </g>
      </g>
    )
  }

  {
    name === 'assess' && (
      <g>
        <g transform="translate(92 75)">
          {[22, 42, 60].map((r) => (
            <circle class="sa-ring" r={r} />
          ))}
          <path class="sa-grid" d="M-64 0H64M0 -64V64" />
          <path class="sa-sweep" d="M0 0L60 0A60 60 0 0 0 30 -52z" />
          <circle class="sa-find sa-find--hot" cx="26" cy="-30" r="5" />
          <circle class="sa-find sa-find--warn" cx="-34" cy="18" r="5" />
          <circle class="sa-find sa-find--ok" cx="12" cy="40" r="5" />
        </g>
        {[
          ['hot', 38],
          ['warn', 70],
          ['ok', 102],
        ].map(([k, y]) => (
          <g transform={`translate(180 ${y})`}>
            <rect class="sa-card" width="122" height="24" rx="7" />
            <circle class={`sa-find sa-find--${k}`} cx="14" cy="12" r="4.5" />
            <rect class="sa-bar" x="26" y="8.5" width="62" height="4" rx="2" />
            <rect class="sa-bar sa-bar--lt" x="26" y="15.5" width="40" height="3" rx="1.5" />
          </g>
        ))}
      </g>
    )
  }

  {
    name === 'gaps' && (
      <g>
        <rect class="sa-card" x="62" y="14" width="196" height="122" rx="12" />
        {[0, 1, 2, 3].map((i) => (
          <g transform={`translate(80 ${30 + i * 22})`}>
            <rect class:list={['sa-box', { 'sa-box--on': i < 2, 'sa-box--half': i === 2 }]} width="12" height="12" rx="3.5" />
            {i < 2 && <path class="sa-ink-w" d="M3 6.2l2.2 2.2L9.2 4" />}
            <rect class="sa-bar" x="22" y="3" width={[96, 80, 104, 70][i]} height="5" rx="2.5" />
          </g>
        ))}
        <rect class="sa-track" x="80" y="118" width="160" height="6" rx="3" />
        <rect class="sa-acc sa-progress" x="80" y="118" width="104" height="6" rx="3" />
      </g>
    )
  }

  {
    name === 'govern' && (
      <g>
        <path class="sa-card" d="M104 14h82l22 22v100a8 8 0 01-8 8H104a8 8 0 01-8-8V22a8 8 0 018-8z" />
        <path class="sa-soft" d="M186 14v22h22" />
        <rect class="sa-acc" x="112" y="30" width="44" height="7" rx="3.5" />
        {[48, 60, 72, 84, 96].map((y, i) => (
          <rect class:list={['sa-bar', { 'sa-bar--lt': i % 2 }]} x="112" y={y} width={[80, 66, 76, 54, 70][i]} height="4.5" rx="2.25" />
        ))}
        <g class="sa-seal" transform="translate(206 112)">
          <circle class="sa-acc" r="22" />
          <circle class="sa-seal-ring" r="16" />
          <path class="sa-ink-w" d="M-7 0l5 5 9-9" />
        </g>
      </g>
    )
  }
</svg>

<style>
  .sa {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--font-body);
  }
  .sa-dot {
    fill: color-mix(in srgb, var(--c, var(--blue)) 26%, transparent);
  }
  .sa-card {
    fill: var(--surface);
    stroke: rgba(13, 13, 13, 0.12);
    stroke-width: 1;
  }
  .sa-side {
    fill: color-mix(in srgb, var(--c, var(--blue)) 18%, #fff);
    stroke: rgba(13, 13, 13, 0.1);
  }
  .sa-floor {
    fill: color-mix(in srgb, var(--c, var(--blue)) 7%, #fff);
    stroke: color-mix(in srgb, var(--c, var(--blue)) 30%, transparent);
  }
  .sa-acc {
    fill: var(--c, var(--blue));
  }
  .sa-soft {
    fill: color-mix(in srgb, var(--c, var(--blue)) 16%, #fff);
  }
  .sa-soft-strong {
    fill: color-mix(in srgb, var(--c, var(--blue)) 34%, #fff);
    stroke: color-mix(in srgb, var(--c, var(--blue)) 50%, transparent);
  }
  .sa-bar {
    fill: rgba(13, 13, 13, 0.2);
  }
  .sa-bar--lt {
    fill: rgba(13, 13, 13, 0.1);
  }
  .sa-grid {
    fill: none;
    stroke: rgba(13, 13, 13, 0.08);
    stroke-dasharray: 3 4;
  }
  .sa-ring {
    fill: none;
    stroke: color-mix(in srgb, var(--c, var(--blue)) 30%, transparent);
  }
  .sa-ink-w {
    fill: none;
    stroke: #fff;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sa-dot-w {
    fill: #fff;
  }
  .sa-acc-line {
    fill: none;
    stroke: var(--c, var(--blue));
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sa-ok {
    fill: #16a34a;
  }
  .sa-label {
    font-size: 9px;
    text-anchor: middle;
    fill: var(--text-2);
  }
  .sa-pill text {
    font-size: 8.6px;
    font-weight: 500;
    text-anchor: middle;
  }
  .sa-pill--ok rect {
    fill: #dcfce7;
  }
  .sa-pill--ok text {
    fill: #166534;
  }
  .sa-pill--warn rect {
    fill: #fef3c7;
  }
  .sa-pill--warn text {
    fill: #92400e;
  }
  .sa-pill--new rect {
    fill: #eef0f6;
  }
  .sa-pill--new text {
    fill: #475569;
  }
  .sa-cloud {
    fill: color-mix(in srgb, var(--c, var(--blue)) 9%, #fff);
    stroke: var(--c, var(--blue));
    stroke-width: 1.6;
  }
  .sa-ghost {
    stroke: var(--c, var(--blue));
    stroke-dasharray: 3 3;
  }
  .sa-arrow {
    fill: none;
    stroke: var(--c, var(--blue));
    stroke-width: 1.6;
    stroke-dasharray: 3 3;
  }
  .sa-link {
    stroke: rgba(13, 13, 13, 0.18);
    stroke-width: 1.4;
  }
  .sa-link--hot {
    stroke: var(--c, var(--blue));
    stroke-width: 2;
  }
  .sa-packet {
    fill: var(--c, var(--blue));
    opacity: 0;
  }
  .sa-cable {
    fill: none;
    stroke: var(--c, var(--blue));
    stroke-width: 1.4;
    stroke-dasharray: 3 3;
  }
  .sa-wave {
    fill: var(--c, var(--blue));
    opacity: 0.75;
    transform-box: fill-box;
    transform-origin: center;
  }
  .sa-sweep {
    fill: color-mix(in srgb, var(--c, var(--blue)) 16%, transparent);
    /* Pivot on the radar's center: the wedge's bottom-left corner. */
    transform-box: fill-box;
    transform-origin: 0% 100%;
  }
  .sa-find--hot {
    fill: #dc2626;
  }
  .sa-find--warn {
    fill: #f59e0b;
  }
  .sa-find--ok {
    fill: #16a34a;
  }
  .sa-box {
    fill: #fff;
    stroke: rgba(13, 13, 13, 0.25);
  }
  .sa-box--on {
    fill: var(--c, var(--blue));
    stroke: none;
  }
  .sa-box--half {
    stroke: var(--c, var(--blue));
    stroke-width: 1.6;
  }
  .sa-track {
    fill: rgba(13, 13, 13, 0.08);
  }
  .sa-seal-ring {
    fill: none;
    stroke: rgba(255, 255, 255, 0.55);
    stroke-dasharray: 2 3;
  }

  /* One small thing on hover (the card is .ix-group-ish: any :hover ancestor). */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .sa-trace {
      stroke-dasharray: 100;
      stroke-dashoffset: 0;
    }
    :global(.ix-card:hover) .sa-trace {
      animation: sa-trace 1.6s var(--ix-ease);
    }
    :global(.ix-card:hover) .sa-packet {
      animation: sa-packet 1.4s var(--ix-ease) infinite;
    }
    :global(.ix-card:hover) .sa-wave {
      animation: sa-wave 0.9s ease-in-out infinite alternate;
      animation-delay: calc(var(--i) * -0.07s);
    }
    :global(.ix-card:hover) .sa-sweep {
      animation: sa-sweep 2.4s linear infinite;
    }
    :global(.ix-card:hover) .sa-sync {
      stroke-dasharray: 6 5;
      animation: sa-sync 0.8s linear infinite;
    }
    :global(.ix-card:hover) .sa-wl {
      animation: sa-lift 1.2s var(--ix-ease) both;
    }
    :global(.ix-card:hover) .sa-progress {
      animation: sa-fill 1.2s var(--ix-ease) both;
    }
    :global(.ix-card:hover) .sa-seal {
      animation: sa-stamp 0.6s var(--ix-ease);
    }
    :global(.ix-card:hover) .sa-wl--1 {
      animation-delay: 0.12s;
    }
    :global(.ix-card:hover) .sa-wl--2 {
      animation-delay: 0.24s;
    }
  }
  @keyframes sa-trace {
    from {
      stroke-dashoffset: 100;
    }
  }
  @keyframes sa-packet {
    0% {
      opacity: 1;
      transform: translate(0, 0);
    }
    100% {
      opacity: 0;
      transform: translate(102px, -36px);
    }
  }
  @keyframes sa-wave {
    to {
      transform: scaleY(0.45);
    }
  }
  @keyframes sa-sweep {
    to {
      transform: rotate(-360deg);
    }
  }
  @keyframes sa-sync {
    to {
      stroke-dashoffset: -11;
    }
  }
  @keyframes sa-lift {
    40% {
      transform: translateY(-6px);
    }
  }
  @keyframes sa-fill {
    from {
      width: 0;
    }
  }
  @keyframes sa-stamp {
    0% {
      transform: translate(206px, 112px) scale(1.25);
      opacity: 0.4;
    }
    100% {
      transform: translate(206px, 112px) scale(1);
      opacity: 1;
    }
  }
</style>
