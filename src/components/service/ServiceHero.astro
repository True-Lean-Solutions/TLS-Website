---
/**
 * The cinematic hero shared by Managed IT and Cloud & Infrastructure
 * (2026-11-18): the Atmosphere backdrop, the page's copy, and a slot for its
 * isometric scene. As the visitor scrolls away the copy eases down and fades
 * and the scene lifts (scroll progress --p, from scrub.ts); without motion
 * everything sits still.
 */
import Atmosphere from './Atmosphere.astro';
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
import { cta, href } from '../../data/site';

interface Props {
  name: string;
  title: string;
  accent: string;
  lede: string;
  ctaLabel: string;
  hue?: 'blue' | 'violet';
}
const { name, title, accent, lede, ctaLabel, hue = 'blue' } = Astro.props;
---

<section class:list={['sh', `sh--${hue}`]} data-scrub data-scrub-start="top top" data-scrub-end="bottom top">
  <Atmosphere hue={hue} />
  <div class="wrap sh-grid">
    <div class="sh-copy">
      <div data-reveal="load">
        <nav class="sh-crumbs" aria-label="Breadcrumb">
          <a href={href('/services/')}>Solutions</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">{name}</span>
        </nav>
        <Eyebrow label={name} />
        <h1>{title}<span class="accent">{accent}</span></h1>
        <p class="sh-lede">{lede}</p>
        <div class="sh-actions">
          <Button href={cta.primary.href} variant="primary" arrow>{ctaLabel}</Button>
          <Button href={cta.email.href} variant="ghost-light" external>{cta.email.label}</Button>
        </div>
      </div>
    </div>
    <div class="sh-art">
      <slot />
    </div>
  </div>
  <span class="sh-cue" aria-hidden="true"><span></span></span>
</section>

<style>
  .sh {
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: #fff;
    background: linear-gradient(180deg, #070b16 0%, #0a1020 60%, #0b1226 100%);
    padding-block: clamp(2.5rem, 4.5vw, 4rem) clamp(4rem, 7vw, 6rem);
  }
  .sh--violet {
    background: linear-gradient(180deg, #0a0818 0%, #0d0c24 60%, #0b1228 100%);
  }
  .sh-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    min-height: clamp(560px, 46vw, 680px);
  }
  .sh-copy {
    translate: 0 calc(var(--p, 0) * 70px);
    opacity: calc(1 - var(--p, 0) * 1.3);
  }
  .sh-art {
    translate: 0 calc(var(--p, 0) * -36px);
    min-width: 0;
  }
  .sh-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }
  .sh-crumbs a {
    color: #fff;
    text-decoration: none;
  }
  .sh-crumbs a:hover {
    text-decoration: underline;
  }
  .sh-copy :global(.eyebrow) {
    color: rgba(255, 255, 255, 0.82);
  }
  .sh-copy h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.4rem, 4.8vw, 3.9rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: #fff;
    max-width: 13ch;
  }
  .sh-copy h1 .accent {
    color: #ff6b6b;
    background: linear-gradient(100deg, #ff7a7a 0%, #e04848 50%, #6cc8ff 135%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .sh-lede {
    margin-top: 1.4rem;
    max-width: 42ch;
    font-size: 1.1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
  }
  .sh-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  /* Scroll cue: a small capsule with a falling dot. */
  .sh-cue {
    position: absolute;
    left: 50%;
    bottom: 1.4rem;
    translate: -50% 0;
    width: 24px;
    height: 38px;
    border-radius: 12px;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    opacity: calc(1 - var(--p, 0) * 6);
  }
  .sh-cue span {
    position: absolute;
    left: 50%;
    top: 7px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: #fff;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sh-cue span {
      animation: sh-cue 1.8s var(--ix-ease) infinite;
    }
  }
  @keyframes sh-cue {
    60%,
    100% {
      transform: translateY(13px);
      opacity: 0;
    }
  }
  @media (max-width: 960px) {
    .sh-grid {
      grid-template-columns: 1fr;
      min-height: 0;
      gap: 2rem;
    }
    .sh-copy {
      translate: none;
      opacity: 1;
    }
    .sh-art {
      translate: none;
      max-width: 640px;
      width: 100%;
      margin-inline: auto;
    }
    .sh-cue {
      display: none;
    }
  }
</style>
