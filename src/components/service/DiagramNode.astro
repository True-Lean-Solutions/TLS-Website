---
/**
 * One node of a staged diagram (StagedFigure, 2026-11-18): an icon tile
 * centered on a point given in percent, with a short label beside it.
 * Icons come from the site's family; a few diagram-only glyphs (globe,
 * Wi-Fi, switch, key, wrench, API, gauge) are drawn here in the same style.
 */
import Icon from '../Icon.astro';
import type { IconName } from '../iconTypes';

export type Glyph = 'globe' | 'wifi' | 'switch' | 'key' | 'wrench' | 'api' | 'gauge' | 'bell';

interface Props {
  /** Position in percent of the canvas: [x, y]. */
  p: [number, number];
  label?: string;
  icon?: IconName;
  glyph?: Glyph;
  /** CSS color for the icon and its edge. */
  tone?: string;
  /** Where the label sits. */
  side?: 'down' | 'up' | 'r' | 'l' | 'ur' | 'in';
  class?: string;
  style?: string;
}
const { p, label, icon, glyph, tone, side = 'down', class: cls, style = '' } = Astro.props;
const g = { width: 20, height: 20, viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': 1.75, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

<span
  class:list={['dg-node', side !== 'down' && `dg-node--${side}`, cls]}
  style={`left: ${p[0]}%; top: ${p[1]}%;${tone ? ` --t: ${tone};` : ''} ${style}`}
>
  {icon && <Icon name={icon} size={20} />}
  {
    glyph === 'globe' && (
      <svg {...g}>
        <circle cx="12" cy="12" r="8.5" fill="currentColor" fill-opacity="0.18" />
        <path d="M3.5 12h17M12 3.5c3.2 3 3.2 14 0 17M12 3.5c-3.2 3-3.2 14 0 17" />
      </svg>
    )
  }
  {
    glyph === 'wifi' && (
      <svg {...g}>
        <path d="M4 9.5a11.5 11.5 0 0 1 16 0M7.2 13a7 7 0 0 1 9.6 0" />
        <circle cx="12" cy="16.8" r="1.4" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    glyph === 'switch' && (
      <svg {...g}>
        <rect x="3" y="8" width="18" height="8" rx="2" fill="currentColor" fill-opacity="0.18" />
        <path d="M7 12h.01M10.5 12h.01M14 12h.01M17.5 12h.01" stroke-width="2.4" />
      </svg>
    )
  }
  {
    glyph === 'key' && (
      <svg {...g}>
        <circle cx="8" cy="12" r="3.5" fill="currentColor" fill-opacity="0.18" />
        <path d="M11.5 12H20M17 12v3M20 12v2.2" />
      </svg>
    )
  }
  {
    glyph === 'wrench' && (
      <svg {...g}>
        <path d="M14.5 6.2a3.8 3.8 0 0 0-4.9 4.9L4.5 16.2a1.6 1.6 0 0 0 2.3 2.3l5.1-5.1a3.8 3.8 0 0 0 4.9-4.9l-2.3 2.3-2-.5-.5-2z" fill="currentColor" fill-opacity="0.18" />
      </svg>
    )
  }
  {
    glyph === 'api' && (
      <svg {...g}>
        <rect x="3.5" y="6" width="17" height="12" rx="2.5" fill="currentColor" fill-opacity="0.18" />
        <path d="M9.5 10l-2 2 2 2M14.5 10l2 2-2 2" />
      </svg>
    )
  }
  {
    glyph === 'gauge' && (
      <svg {...g}>
        <path d="M4.5 16a7.5 7.5 0 1 1 15 0" fill="currentColor" fill-opacity="0.18" />
        <path d="M12 16l3.5-4.5" />
        <circle cx="12" cy="16" r="1.2" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    glyph === 'bell' && (
      <svg {...g}>
        <path d="M6.5 16.5V11a5.5 5.5 0 0 1 11 0v5.5l1.5 1.5H5z" fill="currentColor" fill-opacity="0.18" />
        <path d="M10.2 20.2a2 2 0 0 0 3.6 0" />
      </svg>
    )
  }
  {label && <span class="dg-lbl">{label}</span>}
  <slot />
</span>
