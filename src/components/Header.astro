---
import Lockup from './Lockup.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import { cta, href as withBase } from '../data/site';
import { primaryNav, type NavItem } from '../data/nav';
import type { Accent } from '../data/services';
import {
  getPublishedPosts,
  categoriesWithPosts,
  categoryMeta,
  allTopics,
} from '../data/insights';

const path = Astro.url.pathname;

// The Insights menu lists only categories that have posts (so Guides and News
// stay hidden until they do), plus Browse by Topic from post front matter.
const posts = await getPublishedPosts();
const navItems: NavItem[] = primaryNav.map((item) =>
  item.label === 'Insights' && item.menu
    ? {
        ...item,
        menu: {
          ...item.menu,
          items: categoriesWithPosts(posts).map((c) => ({
            label: categoryMeta[c].label,
            href: `/insights/${c}/`,
            description: categoryMeta[c].description,
            icon: categoryMeta[c].icon,
            accent: categoryMeta[c].accent,
          })),
          topics: allTopics(posts),
        },
      }
    : item
);

const accentVars: Record<Accent, string> = {
  red: '--c: var(--red); --c-text: var(--red-text);',
  blue: '--c: var(--blue); --c-text: var(--blue-text);',
  plum: '--c: var(--plum); --c-text: var(--plum);',
};

function isCurrent(linkHref: string): boolean {
  const target = withBase(linkHref);
  if (linkHref === '/') return path === withBase('/');
  return path === target || path.startsWith(target);
}
const menuId = (label: string) => `menu-${label.toLowerCase().replace(/\s+/g, '-')}`;
---

<header class="site-header">
  <div class="wrap bar">
    <Lockup variant="dark" class="header-lockup" />

    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menu"
    >
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul class="nav-list">
        {
          navItems.map((item) =>
            item.menu ? (
              <li class="has-menu">
                <button
                  class="nav-link menu-trigger"
                  aria-expanded="false"
                  aria-controls={menuId(item.label)}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  <svg class="caret" width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="nav-indicator" aria-hidden="true"></span>
                </button>

                {/* Mega-menu panel. Every link carries .submenu-link so the
                    keyboard handling below walks all of them in order. */}
                <div class="submenu mega" id={menuId(item.label)}>
                  <ul class="mega-grid" role="list">
                    {item.menu.items.map((child) => (
                      <li>
                        <a
                          class="submenu-link mega-item ix-group"
                          href={withBase(child.href)}
                          style={accentVars[child.accent]}
                          aria-current={isCurrent(child.href) ? 'page' : undefined}
                        >
                          <span class="mega-ic glass-icon">
                            <Icon name={child.icon} size={18} />
                          </span>
                          <span class="mega-text">
                            <span class="submenu-label">{child.label}</span>
                            {child.description && (
                              <span class="submenu-desc">{child.description}</span>
                            )}
                          </span>
                          <span class="mega-arrow" aria-hidden="true">
                            <Icon name="arrow" size={14} />
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>

                  <div class="mega-foot">
                    <a
                      class="submenu-link mega-all"
                      href={withBase(item.menu.all.href)}
                      aria-current={path === withBase(item.menu.all.href) ? 'page' : undefined}
                    >
                      <span class="submenu-label">{item.menu.all.label}</span>
                      {item.menu.all.description && (
                        <span class="mega-all-desc">{item.menu.all.description}</span>
                      )}
                      <Icon name="arrow" size={16} class="mega-all-arrow" />
                    </a>
                    {item.menu.topics && item.menu.topics.length > 0 && (
                      <div class="mega-topics">
                        <span class="mega-topics-label">Browse by topic</span>
                        {item.menu.topics.map((t) => (
                          <a
                            class="submenu-link mega-chip"
                            href={withBase(`/insights/?topic=${encodeURIComponent(t)}`)}
                          >
                            {t}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a
                  class="nav-link"
                  href={withBase(item.href)}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                  <span class="nav-indicator" aria-hidden="true"></span>
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="search-btn glass-icon glass-icon--dark" href={withBase('/insights/')} aria-label="Search insights">
        <Icon name="search" size={20} />
      </a>
      <span class="cta-wrap">
        <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
      </span>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--ink);
    /* Gets view-transition-name: ix-header only during page transitions
       (head script in BaseLayout), so it holds still while the page swaps. */
    transition:
      transform var(--ix-base) var(--ix-ease),
      box-shadow var(--ix-base) var(--ix-ease);
  }
  /* Scrolled (the scroll layer sets .is-compact): the bar tucks 8px up —
     transform only, so nothing below it moves — its contents re-centre in
     the 64px that stays in view, the lockup eases down a touch, and a soft
     lift shadow defines its edge. Still solid ink: blur behind the nav would
     cost its text subpixel rendering. */
  .site-header.is-compact {
    transform: translateY(-8px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06),
      0 12px 28px -16px rgba(0, 0, 0, 0.55);
  }
  .bar,
  .bar :global(.header-lockup) {
    transition:
      translate var(--ix-base) var(--ix-ease),
      scale var(--ix-base) var(--ix-ease);
  }
  .site-header.is-compact .bar {
    translate: 0 4px;
  }
  .site-header.is-compact .bar :global(.header-lockup) {
    scale: 0.94;
    transform-origin: left center;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--header-h);
  }
  /* Nav centered between the lockup (left) and the actions (right) */
  .primary-nav {
    margin-inline: auto;
  }

  /* ---- Nav ---- */
  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
  }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--border);
    background: none;
    border: 0;
    padding: 0.5rem 0.7rem;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--ix-fast) ease;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'],
  .nav-link[aria-expanded='true'] {
    color: #fff;
  }
  /* The 2px Execution Red underline, drawn over the link's bottom border.
     Hover grows it from the center; the current page's indicator carries a
     view-transition-name so it glides to the new item between pages. */
  .nav-indicator {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--red);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--ix-fast) var(--ix-ease);
    pointer-events: none;
  }
  .nav-link:hover .nav-indicator,
  .nav-link[aria-current='page'] .nav-indicator,
  .nav-link[aria-expanded='true'] .nav-indicator {
    transform: scaleX(1);
  }
  .nav-link[aria-current='page'] .nav-indicator {
    view-transition-name: ix-nav-indicator;
  }
  .caret {
    transition: transform var(--ix-fast) var(--ix-ease);
  }
  .menu-trigger[aria-expanded='true'] .caret {
    transform: rotate(180deg);
  }

  /* ---- Mega menu (desktop) ---- */
  .has-menu {
    position: relative;
  }
  /* A compact floating glass panel, centered under its trigger. Closed =
     invisible and inert (visibility removes it from keyboard and screen
     readers exactly as display:none did), so it can float into place. */
  .mega {
    position: absolute;
    top: calc(100% + 22px);
    left: 50%;
    width: min(680px, calc(100vw - 2rem));
    translate: -50% 0;
    padding: 10px;
    border-radius: 18px;
    background:
      radial-gradient(55% 80% at 0% 100%, rgba(217, 64, 64, 0.04), transparent 65%),
      radial-gradient(55% 80% at 100% 100%, rgba(18, 136, 207, 0.05), transparent 65%),
      rgba(255, 255, 255, 0.9);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      0 0 0 1px rgba(13, 13, 13, 0.06),
      0 20px 44px -18px rgba(13, 13, 13, 0.24),
      0 6px 16px -10px rgba(13, 13, 13, 0.1);
    transform-origin: 50% 0;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-8px) scale(0.98);
    pointer-events: none;
    transition:
      opacity 240ms var(--ix-ease),
      transform 280ms var(--ix-ease),
      visibility 0s linear 280ms;
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .mega {
      background-color: var(--surface);
    }
  }
  .has-menu[data-open='true'] .mega {
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
    transition:
      opacity 240ms var(--ix-ease),
      transform 280ms var(--ix-ease),
      visibility 0s;
  }
  /* Invisible bridge over the gap under the trigger, so moving the pointer
     down into the panel never counts as leaving the menu. */
  .mega::before {
    content: '';
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: 100%;
    height: 26px;
  }
  /* Notch pointing up at the trigger, so the panel reads as attached to it. */
  .mega::after {
    content: '';
    position: absolute;
    top: -6px;
    left: 50%;
    width: 12px;
    height: 12px;
    translate: -50% 0;
    rotate: 45deg;
    background: rgba(255, 255, 255, 0.96);
    border-top-left-radius: 3px;
    box-shadow: -1px -1px 0 rgba(13, 13, 13, 0.06);
  }

  .submenu-link {
    text-decoration: none;
    color: var(--ink);
  }
  .mega-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* One compact row per item: [icon]  Title          →
                                        Short summary          */
  .mega-item {
    display: grid;
    grid-template-columns: 38px minmax(0, 1fr) 14px;
    align-items: center;
    column-gap: 12px;
    min-height: 72px;
    padding: 10px 12px;
    border: 1px solid transparent;
    border-radius: 12px;
    transition:
      background-color 280ms var(--ix-ease),
      border-color 280ms var(--ix-ease),
      box-shadow 280ms var(--ix-ease);
  }
  .mega-item:is(:hover, :focus-visible),
  .mega-item[aria-current='page'] {
    background-color: rgba(255, 255, 255, 0.78);
    border-color: color-mix(in srgb, var(--c) 16%, rgba(226, 226, 238, 0.9));
    box-shadow:
      inset 0 1px 0 #fff,
      0 6px 16px -12px color-mix(in srgb, var(--c) 45%, transparent);
  }
  .mega-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    color: var(--c);
  }
  /* The open panel sits over live content, so its icon panes may blur too.
     Safe for text rendering: a closed panel is not painted at all. */
  .mega-ic::after {
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .mega-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }
  .submenu-label {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.3;
    color: #2a2a36;
    transition:
      color 280ms var(--ix-ease),
      transform 280ms var(--ix-ease);
  }
  .mega-item:is(:hover, :focus-visible) .submenu-label {
    color: var(--ink);
  }
  .submenu-desc {
    font-size: 12.5px;
    line-height: 1.4;
    color: var(--text-2);
  }
  /* Small arrow on the title line. */
  .mega-arrow {
    display: inline-flex;
    align-self: start;
    margin-top: 3px;
    color: var(--muted);
    opacity: 0.6;
    transition:
      transform 280ms var(--ix-ease),
      color 280ms var(--ix-ease),
      opacity 280ms var(--ix-ease);
  }
  .mega-item:is(:hover, :focus-visible) .mega-arrow {
    color: var(--c-text);
    opacity: 1;
  }
  /* Very short desktop screens: the item grid scrolls inside the panel so the
     footer link stays in view (height-scoped so focus rings aren't clipped
     on normal screens). */
  @media (min-width: 961px) and (max-height: 520px) {
    .mega-grid {
      max-height: calc(100vh - 170px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 6px;
      margin: -6px;
    }
  }

  /* Compact footer: one quiet row under a hairline. */
  .mega-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 1rem;
    min-height: 50px;
    margin: 8px 4px 0;
    padding: 4px 0;
    border-top: 1px solid rgba(13, 13, 13, 0.06);
  }
  .mega-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 8px;
    color: var(--red-text);
    transition: background-color 280ms var(--ix-ease);
  }
  .mega-all .submenu-label {
    color: inherit;
    font-size: 14px;
  }
  .mega-all-desc {
    font-size: 12.5px;
    color: var(--text-2);
  }
  .mega-all :global(.mega-all-arrow) {
    transition: transform 280ms var(--ix-ease);
  }
  .mega-all:is(:hover, :focus-visible),
  .mega-all[aria-current='page'] {
    background-color: rgba(217, 64, 64, 0.05);
  }
  .mega-topics {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .mega-topics-label {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-right: 2px;
  }
  .mega-chip {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 12px;
    padding: 4px 11px;
    border: 1px solid var(--border-2);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.7);
    transition:
      border-color var(--ix-fast) ease,
      color var(--ix-fast) ease;
  }
  .mega-chip:is(:hover, :focus-visible) {
    border-color: var(--red-text);
    color: var(--red-text);
  }

  /* Motion: arrows glide 4px, the title nudges, the icon lifts gently. The
     item itself never moves. */
  @media (prefers-reduced-motion: no-preference) {
    .mega-item:is(:hover, :focus-visible) .mega-arrow,
    .mega-all:is(:hover, :focus-visible) :global(.mega-all-arrow) {
      transform: translateX(4px);
    }
    .mega-item:is(:hover, :focus-visible) .submenu-label {
      transform: translateX(1px);
    }
    .mega-item:is(:hover, :focus-visible) .mega-ic {
      transform: translateY(-2px) scale(1.04);
    }
  }

  /* ---- Actions ---- */
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .search-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--border);
    border: 0;
    border-radius: var(--radius);
    background: none;
    cursor: pointer;
  }
  /* Hover surface comes from .glass-icon--dark (motion.css). */
  .search-btn:hover {
    color: #fff;
  }

  /* ---- Mobile toggle (hidden on desktop) ---- */
  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    background: none;
    border: 0;
    cursor: pointer;
    color: #fff;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .bars {
    position: relative;
    margin: 0 auto;
  }
  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .bars::before {
    top: -7px;
  }
  .bars::after {
    top: 7px;
  }
  .menu-toggle[aria-expanded='true'] .bars {
    background: transparent;
  }
  .menu-toggle[aria-expanded='true'] .bars::before {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bars::after {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ---- Responsive ---- */
  @media (max-width: 960px) {
    .menu-toggle {
      display: block;
      order: 3;
    }
    .actions {
      order: 2;
    }
    .cta-wrap {
      display: none;
    }
    .primary-nav {
      order: 4;
      flex-basis: 100%;
      display: none;
    }
    .primary-nav.open {
      display: block;
    }
    .bar {
      flex-wrap: wrap;
      padding-block: 0.75rem;
    }
    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding-block: 0.5rem 1rem;
    }
    .nav-link {
      width: 100%;
      justify-content: space-between;
      padding: 0.9rem 0.5rem;
      font-size: 1.05rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .nav-link:hover,
    .nav-link[aria-current='page'],
    .nav-link[aria-expanded='true'] {
      border-bottom-color: rgba(255, 255, 255, 0.08);
    }
    .nav-indicator {
      display: none;
    }
    /* Stacked mobile menu: the panel sits in flow as a plain expandable list
       (icon + name, 48px rows) with none of the desktop glass, notch,
       descriptions or motion. */
    .mega {
      position: static;
      display: none;
      width: auto;
      translate: none;
      visibility: visible;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      transition: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      background: transparent;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      padding: 0.25rem 0 0.75rem;
    }
    .mega::before,
    .mega::after {
      display: none;
    }
    .has-menu[data-open='true'] .mega {
      display: block;
    }
    .mega-grid {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
    .mega-item {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 0.8rem;
      min-height: 48px;
      padding: 0.45rem 0.5rem;
      border-radius: 10px;
      color: var(--border);
    }
    .mega-item:is(:hover, :focus-visible),
    .mega-item[aria-current='page'] {
      background-color: rgba(255, 255, 255, 0.06);
      border-color: transparent;
      box-shadow: none;
      color: #fff;
    }
    .submenu-label,
    .mega-item:is(:hover, :focus-visible) .submenu-label {
      color: inherit;
      font-size: 1rem;
    }
    .submenu-desc,
    .mega-arrow,
    .mega-topics,
    .mega-all-desc {
      display: none;
    }
    .mega-ic {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      color: color-mix(in srgb, var(--c) 60%, #fff);
    }
    /* Smoked glass on the black menu instead of the light pane. */
    .mega-ic::after {
      background: color-mix(in srgb, var(--c) 18%, transparent);
      border-color: rgba(255, 255, 255, 0.1);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .mega-ic::before {
      opacity: 0.5;
    }
    .mega-foot {
      margin: 0;
      padding: 0.15rem 0 0;
      border-top: 0;
    }
    .mega-all {
      width: 100%;
      min-height: 48px;
      padding: 0.45rem 0.5rem;
      color: var(--border);
    }
    .mega-all:is(:hover, :focus-visible),
    .mega-all[aria-current='page'] {
      background-color: rgba(255, 255, 255, 0.06);
      color: #fff;
    }
    .cta-wrap {
      display: none;
    }
  }
</style>

<script>
  // Accessible dropdowns + mobile menu.
  // (Bundled module scripts have no document.currentScript, so query directly.)
  const header = document.querySelector('.site-header');

  const mq = window.matchMedia('(max-width: 960px)');
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('primary-nav');
  const menus = Array.from(document.querySelectorAll<HTMLElement>('.has-menu'));

  function closeAllMenus(except?: HTMLElement) {
    for (const m of menus) {
      if (m === except) continue;
      m.dataset.open = 'false';
      m.querySelector('.menu-trigger')?.setAttribute('aria-expanded', 'false');
    }
  }

  // Mobile hamburger
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    if (!open) closeAllMenus();
  });

  for (const menu of menus) {
    const trigger = menu.querySelector<HTMLButtonElement>('.menu-trigger');
    const links = Array.from(menu.querySelectorAll<HTMLAnchorElement>('.submenu-link'));
    if (!trigger) continue;

    let closeTimer = 0;
    let openedByHover = false;

    const open = () => {
      window.clearTimeout(closeTimer);
      closeAllMenus(menu);
      menu.dataset.open = 'true';
      trigger.setAttribute('aria-expanded', 'true');
    };
    const close = (focusTrigger = false) => {
      window.clearTimeout(closeTimer);
      openedByHover = false;
      menu.dataset.open = 'false';
      trigger.setAttribute('aria-expanded', 'false');
      if (focusTrigger) trigger.focus();
    };

    // Enter / Space (native button) and clicks toggle. A click right after
    // hover opened the menu keeps it open rather than snapping it shut.
    trigger.addEventListener('click', () => {
      if (menu.dataset.open === 'true' && openedByHover) {
        openedByHover = false;
        return;
      }
      menu.dataset.open === 'true' ? close() : open();
    });

    // Hover intent: real mice/pens on the desktop layout only (a tap on a
    // tablet fires emulated pointer events that must not double-toggle).
    // Closing waits a beat so diagonal paths into the panel are forgiven.
    const isHoverPointer = (e: PointerEvent) => e.pointerType !== 'touch' && !mq.matches;
    menu.addEventListener('pointerenter', (e) => {
      if (!isHoverPointer(e)) return;
      if (menu.dataset.open !== 'true') openedByHover = true;
      open();
    });
    menu.addEventListener('pointerleave', (e) => {
      if (!isHoverPointer(e)) return;
      closeTimer = window.setTimeout(() => close(), 140);
    });

    // Keyboard focus leaving the panel (e.g. Tab past the last link) closes it.
    menu.addEventListener('focusout', (e) => {
      if (mq.matches) return;
      const next = e.relatedTarget as Node | null;
      if (next && !menu.contains(next)) close();
    });

    trigger.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        open();
        links[0]?.focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        open();
        links[links.length - 1]?.focus();
      } else if (e.key === 'Escape') {
        close(true);
      }
    });

    // Inside the panel: Down/Right next, Up/Left previous (Up from the first
    // item returns to the trigger), Home/End jump, Esc closes to the trigger.
    links.forEach((link, i) => {
      link.addEventListener('keydown', (e) => {
        let target: HTMLElement | undefined;
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') target = links[i + 1] ?? links[0];
        else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') target = links[i - 1] ?? trigger;
        else if (e.key === 'Home') target = links[0];
        else if (e.key === 'End') target = links[links.length - 1];
        else if (e.key === 'Escape') {
          e.preventDefault();
          close(true);
          return;
        }
        if (target) {
          e.preventDefault();
          target.focus();
        }
      });
    });
  }

  // Click outside / Esc closes open desktop menus
  document.addEventListener('click', (e) => {
    if (header && !header.contains(e.target as Node)) closeAllMenus();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAllMenus();
  });
</script>
