---
/**
 * Client logo rail. Real logos only (src/data/clients.ts), each shown at full
 * strength in its own colors (ClientLogoItem): no grayscale, no fading.
 * - Fewer than MARQUEE_MIN logos: a calm static row that drifts slightly with
 *   scroll (scroll layer). A marquee needs the set repeated across the screen,
 *   and with a couple of genuine clients that repetition would look padded.
 * - MARQUEE_MIN or more: a slow infinite marquee (30 s per loop, linear),
 *   faded at both edges, paused on hover/focus, static under reduced motion.
 */
import { clients } from '../data/clients';
import ClientLogoItem from './ClientLogoItem.astro';

interface Props {
  /** Override for testing/layout reuse; defaults to all clients. */
  items?: typeof clients;
}
const { items = clients } = Astro.props;
const MARQUEE_MIN = 6;
const marquee = items.length >= MARQUEE_MIN;
---

<div class:list={['logos', marquee ? 'logos--marquee' : 'logos--static']}>
  {
    marquee ? (
      <div class="logos-viewport">
        <ul class="logos-track">
          {[0, 1].map((copy) => items.map((c) => <ClientLogoItem client={c} copy={copy === 1} />))}
        </ul>
      </div>
    ) : (
      <ul class="logos-row">
        {items.map((c) => (
          <ClientLogoItem client={c} />
        ))}
      </ul>
    )
  }
</div>

<style>
  /* A clean rail: hairlines above and below that fade toward both ends. */
  .logos {
    position: relative;
    padding-block: 1.75rem;
  }
  .logos::before,
  .logos::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-2) 20%, var(--border-2) 80%, transparent);
  }
  .logos::before {
    top: 0;
  }
  .logos::after {
    bottom: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Static row: logos side by side, a hairline between neighbours. */
  .logos-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 3rem;
  }
  .logos-row > :global(.cl-item + .cl-item) {
    position: relative;
  }
  .logos-row > :global(.cl-item + .cl-item)::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 50%;
    width: 1px;
    height: 48px;
    translate: 0 -50%;
    background: linear-gradient(transparent, var(--border-2), transparent);
  }

  /* Marquee */
  .logos-viewport {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .logos-track {
    display: flex;
    align-items: center;
    gap: 3rem;
    width: max-content;
    padding-right: 3rem; /* the gap that joins the two copies */
  }
  @media (prefers-reduced-motion: no-preference) {
    .logos-track {
      animation: logos-scroll 30s linear infinite;
    }
    .logos--marquee:is(:hover, :focus-within) .logos-track {
      animation-play-state: paused;
    }
  }
  @keyframes logos-scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .logos-track {
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
    }
    .logos-track > [aria-hidden='true'] {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .logos-row {
      gap: 1rem;
    }
    .logos-row > :global(.cl-item + .cl-item)::before {
      left: -0.5rem;
      height: 40px;
    }
  }
</style>
