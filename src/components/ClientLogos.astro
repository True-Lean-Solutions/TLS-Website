---
/**
 * Client logo rail. Real logos only (src/data/clients.ts), each shown at full
 * strength in its own colors (ClientLogoItem): no grayscale, no fading.
 * - Fewer than MARQUEE_MIN logos: a calm static row that drifts slightly with
 *   scroll (scroll layer). A marquee needs the set repeated across the screen,
 *   and with a couple of genuine clients that repetition would look padded.
 * - MARQUEE_MIN or more: a slow infinite marquee (SECONDS_PER_LOGO per logo
 *   per loop, linear: ~37 px/s on desktop, calm enough to read every logo),
 *   faded at both edges, paused on hover/focus, static under reduced motion.
 *   The marquee itself is the shared Marquee component (since 2026-10-28);
 *   the rail is its host, so hovering anywhere on the rail pauses it.
 */
import { clients } from '../data/clients';
import ClientLogoItem from './ClientLogoItem.astro';
import Marquee from './Marquee.astro';

interface Props {
  /** Override for testing/layout reuse; defaults to all clients. */
  items?: typeof clients;
}
const { items = clients } = Astro.props;
const MARQUEE_MIN = 6;
const SECONDS_PER_LOGO = 8;
const marquee = items.length >= MARQUEE_MIN;
---

<div class:list={['logos', marquee ? 'logos--marquee' : 'logos--static']} data-marquee-host>
  {
    marquee ? (
      <Marquee loop={`${items.length * SECONDS_PER_LOGO}s`} gap="3rem">
        {[0, 1].map((copy) => items.map((c) => <ClientLogoItem client={c} copy={copy === 1} />))}
      </Marquee>
    ) : (
      <ul class="logos-row">
        {items.map((c) => (
          <ClientLogoItem client={c} />
        ))}
      </ul>
    )
  }
</div>

<style>
  /* A clean rail: hairlines above and below that fade toward both ends. */
  .logos {
    position: relative;
    padding-block: 1.75rem;
  }
  .logos::before,
  .logos::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-2) 20%, var(--border-2) 80%, transparent);
  }
  .logos::before {
    top: 0;
  }
  .logos::after {
    bottom: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Static row: logos side by side, a hairline between neighbours. */
  .logos-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 3rem;
  }
  .logos-row > :global(.cl-item + .cl-item) {
    position: relative;
  }
  .logos-row > :global(.cl-item + .cl-item)::before {
    content: '';
    position: absolute;
    left: -1.5rem;
    top: 50%;
    width: 1px;
    height: 48px;
    translate: 0 -50%;
    background: linear-gradient(transparent, var(--border-2), transparent);
  }

  @media (max-width: 560px) {
    .logos-row {
      gap: 1rem;
    }
    .logos-row > :global(.cl-item + .cl-item)::before {
      left: -0.5rem;
      height: 40px;
    }
  }
</style>
