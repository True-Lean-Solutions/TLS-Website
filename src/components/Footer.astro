---
import Lockup from './Lockup.astro';
import { site, href as withBase } from '../data/site';
import { quickLinks, services, legalLinks } from '../data/nav';

interface Props {
  /** Three newest published posts; column is hidden when empty. */
  latestPosts?: { title: string; href: string }[];
}
const { latestPosts = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <Lockup variant="light" />
        <p class="positioning">{site.positioning}</p>
        <ul class="social" aria-label="Social media">
          <li>
            <a href={site.social.linkedin} aria-label="TLS on LinkedIn" target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21H19v-5.4c0-1.3 0-2.96-1.8-2.96-1.8 0-2.08 1.4-2.08 2.86V21H9z"/></svg>
            </a>
          </li>
          <li>
            <a href={site.social.facebook} aria-label="TLS on Facebook" target="_blank" rel="noopener noreferrer">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.05 1.47-4.05 4.16v2.32H7.5V13h2.7v8z"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <nav class="col" aria-label="Quick links">
        <h2 class="col-head">Quick Links</h2>
        <ul>
          {quickLinks.map((l) => (
            <li><a href={withBase(l.href)}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="col" aria-label="Services">
        <h2 class="col-head">Services</h2>
        <ul>
          {services.map((l) => (
            <li><a href={withBase(l.href)}>{l.label}</a></li>
          ))}
        </ul>
      </nav>

      {
        latestPosts.length > 0 && (
          <nav class="col" aria-label="Latest insights">
            <h2 class="col-head">Latest Insights</h2>
            <ul>
              {latestPosts.map((p) => (
                <li><a href={p.href}>{p.title}</a></li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="col">
        <h2 class="col-head">Contact</h2>
        <ul class="contact">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
        </ul>
      </div>
    </div>

    <div class="bottom">
      <p class="copyright">© {year} {site.name}. All rights reserved.</p>
      <ul class="legal">
        {legalLinks.map((l) => (
          <li><a href={withBase(l.href)}>{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--section);
    color: var(--text-2);
    padding-block: var(--space-6) var(--space-4);
    border-top: 1px solid var(--border);
  }
  .top {
    display: grid;
    grid-template-columns: 1.6fr repeat(3, 1fr);
    gap: 2.5rem;
  }
  .positioning {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: 0.95rem;
    color: var(--text-2);
  }
  .social {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--ink);
  }
  .social a:hover {
    color: var(--red-text);
    border-color: var(--red-text);
  }

  .col-head {
    font-family: var(--font-head);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 0.9rem;
  }
  .col ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .col a {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .col a:hover {
    color: var(--blue-text);
    text-decoration: underline;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: var(--space-5);
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .copyright {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .legal {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    padding: 0;
  }
  .legal a {
    color: var(--text-2);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .legal a:hover {
    color: var(--blue-text);
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .top {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
