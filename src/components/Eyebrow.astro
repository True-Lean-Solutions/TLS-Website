---
/** Section eyebrow: a short red rule + tracked uppercase label (mock-up motif). */
interface Props {
  label: string;
  /** Center for centered section headings. */
  align?: 'start' | 'center';
}
const { label, align = 'start' } = Astro.props;
---

<p class:list={['eyebrow', align]}>
  <span class="rule" aria-hidden="true"></span>
  {label}
</p>

<style>
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-2);
    margin-bottom: var(--gap-tag);
  }
  .eyebrow.center {
    justify-content: center;
  }
  .rule {
    display: block;
    width: 2.5rem;
    height: 2px;
    background: var(--red);
    flex: none;
  }
</style>
