---
/**
 * Pill button for CTAs (mock-up house style: fully rounded, optional arrow).
 * Filled buttons use Action Red (#C23636), AA on white (5.42:1).
 * Labels come from v2.3 §09 — never "Get Started" / "Request a Quote".
 */
import Icon from './Icon.astro';
import { href as withBase } from '../data/site';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost-light';
  external?: boolean;
  /** Show a trailing arrow (mock-up default for primary CTAs). */
  arrow?: boolean;
  class?: string;
}
const {
  href,
  variant = 'primary',
  external = false,
  arrow = false,
  class: className,
} = Astro.props;

// In-page anchors (#id) stay relative so they scroll instead of navigating.
const resolved = external || href.startsWith('#') ? href : withBase(href);
const extAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
// Primary CTAs lean very slightly toward the cursor (motion.ts, desktop only).
const magnetic = variant === 'primary' ? { 'data-magnetic': '' } : {};
---

<a class:list={['btn', variant, className]} href={resolved} {...extAttrs} {...magnetic}>
  <span><slot /></span>
  {arrow && <Icon name="arrow" size={18} class="btn-arrow" />}
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    padding: 0.9rem 1.6rem;
    border-radius: 999px;
    border: 2px solid transparent;
    text-decoration: none;
    cursor: pointer;
    /* Magnetic offset (motion.ts) rides on `translate`, hover lift on
       `transform`, so the two compose instead of fighting. */
    translate: var(--mag-x, 0) var(--mag-y, 0);
    transition:
      background-color var(--ix-fast) ease,
      color var(--ix-fast) ease,
      border-color var(--ix-fast) ease,
      transform var(--ix-base) var(--ix-ease),
      box-shadow var(--ix-base) var(--ix-ease),
      translate 300ms var(--ix-ease);
  }
  .btn :global(.btn-arrow) {
    transition: transform var(--ix-base) var(--ix-ease);
  }
  .btn:hover :global(.btn-arrow) {
    transform: translateX(4px);
  }

  .primary {
    background: var(--red-text);
    color: #fff;
    box-shadow: 0 6px 18px rgba(194, 54, 54, 0.28);
    overflow: hidden;
    isolation: isolate;
  }
  .primary:hover {
    background: #a82f2f;
    color: #fff;
    box-shadow: 0 10px 24px -4px rgba(194, 54, 54, 0.38);
  }
  /* A faint highlight that crosses the button once per hover. */
  .primary::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 30%,
      rgba(255, 255, 255, 0.16) 50%,
      transparent 70%
    );
    transform: translateX(-110%);
    pointer-events: none;
  }

  .secondary {
    background: var(--surface);
    color: var(--ink);
    border-color: var(--border-2);
  }
  .secondary:hover {
    border-color: var(--red-text);
    color: var(--red-text);
    box-shadow: 0 8px 20px -8px rgba(13, 13, 13, 0.16);
  }

  .ghost-light {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.5);
  }
  .ghost-light:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: #fff;
    color: #fff;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .btn:hover {
      transform: translateY(-2px);
    }
    .primary:hover::after {
      transform: translateX(110%);
      transition: transform 800ms var(--ix-ease);
    }
  }
  .btn:active {
    transform: translateY(1px);
  }
</style>
