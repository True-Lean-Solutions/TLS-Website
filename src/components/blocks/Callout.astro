---
interface Props {
  title?: string;
  body: string;
  tag?: string;
  variant?: 'light' | 'dark';
}
const { title, body, tag, variant = 'dark' } = Astro.props;
const tags = tag ? tag.split('·').map((t) => t.trim()).filter(Boolean) : [];
---

<aside class:list={['callout', 'block-reading', variant]}>
  {title && <h3>{title}</h3>}
  <p>{body}</p>
  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
    )
  }
</aside>

<style>
  .callout {
    border-radius: var(--radius-xl);
    padding: 2rem;
    border-top: 3px solid transparent;
    border-image: var(--grad-h) 1;
  }
  .dark {
    background: var(--ink);
    color: #fff;
  }
  .light {
    background: var(--section);
    color: var(--ink);
    border: 1px solid var(--border);
    border-top: 3px solid var(--red);
    border-image: none;
  }
  h3 {
    font-size: var(--step-1);
    margin-bottom: 0.6rem;
  }
  .dark h3 {
    color: #fff;
  }
  .callout p {
    line-height: 1.6;
  }
  .dark p {
    color: var(--border);
  }
  .light p {
    color: var(--text-2);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
  }
  .tags li {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .dark .tags li {
    background: rgba(255, 255, 255, 0.1);
    color: var(--border);
  }
  .light .tags li {
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-2);
  }
</style>
