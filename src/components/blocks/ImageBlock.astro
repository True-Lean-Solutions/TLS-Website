---
import { href as withBase } from '../../data/site';
interface Props {
  src: string;
  alt: string;
  caption?: string;
}
const { src, alt, caption } = Astro.props;
---

<figure class="img-block block-wide">
  <img src={withBase(src)} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .img-block {
    margin: 0;
  }
  img {
    width: 100%;
    border-radius: var(--radius-lg);
    display: block;
  }
  figcaption {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
    text-align: center;
  }
</style>
