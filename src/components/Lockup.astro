---
/**
 * Brand lockup, built in markup from the symbol + live text.
 * Never uses the low-res reference screenshot (CLAUDE.md § Lockup).
 *  - dark  : on the Ink Black header — TLS white, wordmark Execution Red.
 *  - light : on light surfaces (footer) — TLS Ink Black, wordmark Execution Red.
 */
import { site, href } from '../data/site';

interface Props {
  variant?: 'dark' | 'light';
  /** Link target; defaults to home. Pass null to render without a link. */
  home?: boolean;
  showTagline?: boolean;
  class?: string;
}
const {
  variant = 'dark',
  home = true,
  showTagline = true,
  class: className,
} = Astro.props;

const Tag = home ? 'a' : 'div';
const linkAttrs = home
  ? { href: href('/'), 'aria-label': `${site.name} — home` }
  : {};
---

<Tag class:list={['lockup', variant, className]} {...linkAttrs}>
  <img
    class="mark"
    src={href('/brand/tls-mark.png')}
    alt=""
    width="44"
    height="44"
    decoding="async"
  />
  <span class="text">
    <span class="tls">{site.shortName}</span>
    <span class="wordmark">True Lean Solutions</span>
    {showTagline && <span class="tagline">{site.tagline}</span>}
  </span>
</Tag>

<style>
  .lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
    line-height: 1;
  }
  .mark {
    width: 50px;
    height: 50px;
    flex: none;
  }
  .text {
    display: grid;
    gap: 0.14em;
  }
  .tls {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.7rem;
    letter-spacing: 0.01em;
    line-height: 0.95;
  }
  .wordmark {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.74rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--red);
  }
  .tagline {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.56rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  /* On the black header */
  .dark .tls {
    color: #fff;
  }
  .dark .tagline {
    color: var(--border);
  }

  /* On light surfaces */
  .light .tls {
    color: var(--ink);
  }
  .light .tagline {
    color: var(--text-2);
  }

  @media (max-width: 480px) {
    .wordmark {
      font-size: 0.6rem;
      letter-spacing: 0.12em;
    }
    .tagline {
      display: none;
    }
  }
</style>
