---
/**
 * Footer social links: only the accounts TLS has (src/data/site.ts), plus
 * email. LinkedIn and Facebook show their own logos in their brand colors;
 * each sits in a white circle that takes its color on hover and lifts.
 */
import { site } from '../data/site';

const items = [
  {
    label: 'TLS on LinkedIn',
    href: site.social.linkedin,
    external: true,
    // LinkedIn's own mark, in LinkedIn blue.
    c: '#0a66c2',
    icon: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  },
  {
    label: 'TLS on Facebook',
    href: site.social.facebook,
    external: true,
    // Facebook's own mark (the "f" in a circle), in Facebook blue.
    c: '#0866ff',
    icon: '<path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/>',
  },
  {
    label: `Email ${site.email}`,
    href: `mailto:${site.email}`,
    external: false,
    c: 'var(--plum)',
    icon: '<path d="M4 6h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V7a1 1 0 011-1zm.9 2l7.1 5.1L19.1 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];
---

<ul class="fs" aria-label="Social media">
  {
    items.map((s) => (
      <li>
        <a
          href={s.href}
          aria-label={s.label}
          style={`--c: ${s.c}`}
          {...(s.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={s.icon} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .fs {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--c);
    transition:
      translate 300ms var(--ix-ease),
      border-color 250ms ease,
      background-color 250ms ease,
      box-shadow 300ms var(--ix-ease);
  }
  a:is(:hover, :focus-visible) {
    color: var(--c); /* keep the logo's own color (links turn red on hover site-wide) */
    border-color: color-mix(in srgb, var(--c) 45%, var(--border));
    background: color-mix(in srgb, var(--c) 11%, var(--surface));
    box-shadow: 0 10px 20px -12px color-mix(in srgb, var(--c) 70%, transparent);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a:hover {
      translate: 0 -2px;
    }
  }
</style>
