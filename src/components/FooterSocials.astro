---
/**
 * Footer social links: only the accounts TLS has (src/data/site.ts), plus
 * email. Each sits in a light circle carrying its accent; hovering lifts it.
 */
import { site } from '../data/site';

const items = [
  {
    label: 'TLS on LinkedIn',
    href: site.social.linkedin,
    external: true,
    c: 'var(--blue)',
    icon: '<path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21H19v-5.4c0-1.3 0-2.96-1.8-2.96-1.8 0-2.08 1.4-2.08 2.86V21H9z"/>',
  },
  {
    label: 'TLS on Facebook',
    href: site.social.facebook,
    external: true,
    c: 'var(--blue-text)',
    icon: '<path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.6c-.29-.04-1.27-.12-2.42-.12-2.4 0-4.05 1.47-4.05 4.16v2.32H7.5V13h2.7v8z"/>',
  },
  {
    label: `Email ${site.email}`,
    href: `mailto:${site.email}`,
    external: false,
    c: 'var(--plum)',
    icon: '<path d="M4 6h16a1 1 0 011 1v10a1 1 0 01-1 1H4a1 1 0 01-1-1V7a1 1 0 011-1zm.9 2l7.1 5.1L19.1 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  },
];
---

<ul class="fs" aria-label="Social media">
  {
    items.map((s) => (
      <li>
        <a
          href={s.href}
          aria-label={s.label}
          style={`--c: ${s.c}`}
          {...(s.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={s.icon} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .fs {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--c) 22%, var(--border));
    background: color-mix(in srgb, var(--c) 6%, var(--surface));
    color: var(--c);
    transition:
      translate 300ms var(--ix-ease),
      border-color 250ms ease,
      background-color 250ms ease,
      box-shadow 300ms var(--ix-ease);
  }
  a:is(:hover, :focus-visible) {
    border-color: color-mix(in srgb, var(--c) 45%, var(--border));
    background: color-mix(in srgb, var(--c) 11%, var(--surface));
    box-shadow: 0 10px 20px -12px color-mix(in srgb, var(--c) 70%, transparent);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    a:hover {
      translate: 0 -2px;
    }
  }
</style>
