---
/**
 * Verbatim client testimonial. Long reviews keep their full text in the DOM
 * and clamp visually (max-height + fade); a button expands them. Nothing is
 * truncated or reworded (CLAUDE.md: testimonials are verbatim).
 */
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
}
const { testimonial } = Astro.props;
const paragraphs = testimonial.quote.split('\n\n');
const long = testimonial.quote.length > 320;
const attribution = [testimonial.position, testimonial.company]
  .filter(Boolean)
  .join(', ');
---

<figure class:list={['testimonial', { 'is-long': long }]}>
  <div class="stars" role="img" aria-label={`${testimonial.stars} out of 5 stars`}>
    {
      Array.from({ length: testimonial.stars }).map(() => (
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.5 1.3 6.6L12 18.9 6.1 21.2l1.3-6.6L2.5 9.5l6.6-.8z" />
        </svg>
      ))
    }
  </div>

  <blockquote class="quote">
    {paragraphs.map((p) => <p>{p}</p>)}
  </blockquote>

  {long && <button class="toggle" type="button" aria-expanded="false">Read full review</button>}

  <figcaption>
    <span class="avatar" aria-hidden="true">{testimonial.initials}</span>
    <span class="who">
      <span class="name">{testimonial.name}</span>
      {attribution && <span class="role">{attribution}</span>}
    </span>
  </figcaption>
</figure>

<style>
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.6rem;
    margin: 0;
  }
  .stars {
    color: var(--red);
    display: flex;
    gap: 2px;
  }
  .quote {
    margin: 0;
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.6;
    position: relative;
  }
  .quote p + p {
    margin-top: 0.75rem;
  }

  /* Long reviews clamp until expanded */
  .is-long .quote {
    max-height: 11em;
    overflow: hidden;
  }
  .is-long .quote::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 3.5em;
    background: linear-gradient(to bottom, transparent, var(--surface));
  }
  .is-long .quote.open {
    max-height: none;
  }
  .is-long .quote.open::after {
    display: none;
  }

  .toggle {
    align-self: flex-start;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--blue-text);
  }
  .toggle:hover {
    color: var(--red-text);
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--section);
    color: var(--text-2);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.8rem;
    flex: none;
  }
  .who {
    display: grid;
  }
  .name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .role {
    font-size: 0.85rem;
    color: var(--text-2);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.testimonial .toggle').forEach((btn) => {
    const quote = btn.parentElement?.querySelector('.quote');
    btn.addEventListener('click', () => {
      const open = quote?.classList.toggle('open') ?? false;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Show less' : 'Read full review';
    });
  });
</script>
