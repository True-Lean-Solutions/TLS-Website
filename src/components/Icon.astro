---
import type { IconName } from './iconTypes';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 28, class: className } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.8,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
  class: className,
} as const;
---

