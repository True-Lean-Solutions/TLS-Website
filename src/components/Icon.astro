---
/**
 * Inline line icons in brand style. Abstract/geometric only — no brains,
 * circuit boards, robots, or invented people (v2.3 §13). `talent` is a plain
 * UI person glyph, not illustrated people imagery.
 */
import type { IconName } from './iconTypes';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 28, class: className } = Astro.props;
const common = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': 1.8,
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  'aria-hidden': 'true',
  class: className,
} as const;
---

{
  name === 'ai' && (
    <svg {...common}>
      <path d="M12 3.2l1.7 4.6 4.6 1.7-4.6 1.7L12 15.8l-1.7-4.6L5.7 9.5l4.6-1.7z" />
      <path d="M18.5 15.5l.7 1.9 1.9.7-1.9.7-.7 1.9-.7-1.9-1.9-.7 1.9-.7z" />
    </svg>
  )
}
{
  name === 'software' && (
    <svg {...common}>
      <path d="M9 8l-4 4 4 4" />
      <path d="M15 8l4 4-4 4" />
    </svg>
  )
}
{
  name === 'integration' && (
    <svg {...common}>
      <path d="M12 3l8.5 4.5L12 12 3.5 7.5z" />
      <path d="M3.5 12L12 16.5 20.5 12" />
      <path d="M3.5 16.5L12 21l8.5-4.5" />
    </svg>
  )
}
{
  name === 'talent' && (
    <svg {...common}>
      <circle cx="9" cy="8.5" r="3" />
      <path d="M3.4 19a5.6 5.6 0 0111.2 0" />
      <circle cx="17" cy="9" r="2.2" />
      <path d="M16 13.6A4.8 4.8 0 0121 18" />
    </svg>
  )
}
{
  name === 'arrow' && (
    <svg {...common}>
      <path d="M4 12h14" />
      <path d="M13 7l5 5-5 5" />
    </svg>
  )
}
{
  name === 'chart' && (
    <svg {...common}>
      <path d="M4 20h16" />
      <path d="M7 20v-5" />
      <path d="M12 20v-9" />
      <path d="M17 20v-13" />
    </svg>
  )
}
{
  name === 'clock' && (
    <svg {...common}>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </svg>
  )
}
