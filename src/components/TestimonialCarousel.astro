---
/**
 * Featured client testimonial with navigation. Reviews are verbatim from the
 * reviews sheet (src/data/testimonials.ts) and attributed exactly; the company
 * logo stands in for a portrait where we have one, otherwise initials.
 *
 * Progressive: without JS every review renders in full, stacked. With JS it
 * becomes a carousel (one review at a time, arrows + dots, 01 / 03), with long
 * reviews clamped behind "Read full review". Auto-advances every 7 s; pauses on
 * hover, focus, an open review, a hidden tab or when off-screen, and has a
 * pause button (WCAG 2.2.2). No auto-advance under reduced motion.
 */
import Icon from './Icon.astro';
import type { Testimonial } from '../data/testimonials';
import { clientFor } from '../data/clients';
import { href } from '../data/site';

interface Props {
  testimonials: Testimonial[];
}
const { testimonials } = Astro.props;
const n = testimonials.length;
const pad = (i: number) => String(i).padStart(2, '0');
---

<div class="tc" data-tc aria-roledescription="carousel" aria-label="Client testimonials" role="region">
  <div class="tc-card">
    <span class="tc-mark" aria-hidden="true">&ldquo;</span>
    <div class="tc-slides" id="tc-slides" aria-live="off">
      {
        testimonials.map((t, i) => {
          const client = clientFor(t.company);
          const long = t.quote.length > 320;
          const role = [t.position, t.company].filter(Boolean).join(', ');
          return (
            <figure
              class:list={['tc-slide', { 'is-active': i === 0, 'is-long': long }]}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${n}`}
            >
              <div class="tc-stars" role="img" aria-label={`${t.stars} out of 5 stars`}>
                {Array.from({ length: t.stars }).map(() => (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.5 1.3 6.6L12 18.9 6.1 21.2l1.3-6.6L2.5 9.5l6.6-.8z" />
                  </svg>
                ))}
              </div>
              <blockquote class="tc-quote">
                {t.quote.split('\n\n').map((p) => <p>{p}</p>)}
              </blockquote>
              {long && (
                <button class="tc-more" type="button" aria-expanded="false">
                  <span>Read full review</span>
                  <Icon name="arrow" size={16} class="tc-more-arrow" />
                </button>
              )}
              <figcaption class="tc-who">
                {client ? (
                  <span class="tc-logo">
                    <img
                      src={href(client.logo)}
                      alt={client.name}
                      width={client.width}
                      height={client.height}
                      style={`height: ${Math.round(client.displayHeight * 0.8)}px`}
                      loading="lazy"
                    />
                  </span>
                ) : (
                  <span class="tc-avatar" aria-hidden="true">{t.initials}</span>
                )}
                <span class="tc-id">
                  <span class="tc-name">{t.name}</span>
                  {role && <span class="tc-role">{role}</span>}
                </span>
              </figcaption>
            </figure>
          );
        })
      }
    </div>
  </div>

  {
    n > 1 && (
      <div class="tc-nav" hidden>
        <button class="tc-arrow tc-prev" type="button" aria-label="Previous testimonial" aria-controls="tc-slides">
          <Icon name="arrow" size={18} />
        </button>
        <div class="tc-dots">
          {testimonials.map((t, i) => (
            <button
              class="tc-dot"
              type="button"
              aria-label={`Show testimonial ${i + 1} of ${n}: ${t.name}`}
              aria-controls="tc-slides"
              aria-current={i === 0 ? 'true' : undefined}
            >
              <span />
            </button>
          ))}
        </div>
        <button class="tc-arrow tc-next" type="button" aria-label="Next testimonial" aria-controls="tc-slides">
          <Icon name="arrow" size={18} />
        </button>
        <span class="tc-count" aria-hidden="true">
          <span class="tc-count-now">{pad(1)}</span> / {pad(n)}
        </span>
        <button class="tc-pause" type="button" aria-label="Pause automatic rotation" aria-pressed="false">
          <svg class="i-pause" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><rect x="3" y="2" width="2.6" height="10" rx="1" fill="currentColor" /><rect x="8.4" y="2" width="2.6" height="10" rx="1" fill="currentColor" /></svg>
          <svg class="i-play" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M4 2.2v9.6a.6.6 0 00.9.5l7.4-4.8a.6.6 0 000-1L4.9 1.7a.6.6 0 00-.9.5z" fill="currentColor" /></svg>
        </button>
      </div>
    )
  }
</div>

<style>
  .tc {
    position: relative;
    max-width: 920px;
    margin-inline: auto;
    isolation: isolate;
  }
  /* A soft TLS red/blue light behind the card. */
  .tc::before {
    content: '';
    position: absolute;
    inset: 8% -4% 14%;
    z-index: -1;
    background:
      radial-gradient(40% 55% at 8% 70%, rgba(217, 64, 64, 0.14), transparent 70%),
      radial-gradient(40% 55% at 92% 25%, rgba(18, 136, 207, 0.14), transparent 70%),
      radial-gradient(30% 40% at 55% 100%, rgba(135, 54, 98, 0.08), transparent 70%);
    filter: blur(8px);
    pointer-events: none;
  }
  /* Glass card. The light behind is already soft, so a backdrop blur would add
     nothing visible — and at rest it costs the page subpixel text rendering. */
  .tc-card {
    position: relative;
    padding: clamp(2rem, 1.2rem + 3vw, 3.5rem) clamp(1.5rem, 0.8rem + 3vw, 3.75rem) clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(226, 226, 238, 0.95);
    border-radius: var(--radius-xl);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 24px 60px -30px rgba(13, 13, 13, 0.22),
      0 4px 16px -8px rgba(13, 13, 13, 0.06);
    transition:
      transform var(--ix-base) var(--ix-ease),
      box-shadow var(--ix-base) var(--ix-ease);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tc-card:hover {
      transform: translateY(-3px);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.9),
        0 30px 70px -30px rgba(13, 13, 13, 0.26),
        0 6px 18px -8px rgba(13, 13, 13, 0.08);
    }
  }
  .tc-mark {
    position: absolute;
    top: -0.2em;
    left: clamp(1rem, 0.4rem + 2.5vw, 2.75rem);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(5rem, 3rem + 6vw, 8rem);
    line-height: 1;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.22;
    pointer-events: none;
    user-select: none;
  }

  /* Slides: without JS, all stacked in full. */
  .tc-slides {
    display: grid;
    gap: 2.5rem;
  }
  .tc-slide {
    display: flex;
    flex-direction: column;
    margin: 0;
  }
  .tc-stars {
    display: flex;
    gap: 3px;
    color: var(--red);
    margin-bottom: 1.1rem;
  }
  .tc-quote {
    margin: 0;
    position: relative;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1.15rem, 0.95rem + 0.7vw, 1.5rem);
    line-height: 1.55;
    color: var(--ink);
  }
  .tc-quote p + p {
    margin-top: 0.8em;
  }
  .tc-more {
    display: none;
  }
  .tc-who {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.9rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--border);
  }
  .tc-logo {
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  .tc-logo img {
    width: auto;
    max-width: none;
  }
  .tc-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--section);
    color: var(--text-2);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.82rem;
  }
  .tc-id {
    display: grid;
  }
  .tc-name {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 1.02rem;
  }
  .tc-role {
    font-size: 0.9rem;
    color: var(--text-2);
  }

  /* ---- Carousel mode (JS ready) ---- */
  .tc[data-ready] .tc-slides {
    gap: 0;
  }
  /* All slides share one cell: the card keeps the tallest slide's height, so
     switching never shifts the page. */
  .tc[data-ready] .tc-slide {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transform: translateX(var(--from, 20px));
    transition:
      opacity 250ms ease,
      transform 250ms ease,
      visibility 0s linear 250ms;
  }
  .tc[data-ready] .tc-slide.is-active {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition:
      opacity 450ms var(--ix-ease),
      transform 450ms var(--ix-ease),
      visibility 0s;
  }
  .tc[data-ready] .tc-who {
    margin-top: auto;
  }
  .tc[data-ready] .tc-quote {
    margin-bottom: 1.9rem;
  }
  /* Long reviews: clamped with a fade until opened. */
  /* The text itself fades (a mask), so no overlay box shows on the glass. */
  .tc[data-ready] .is-long .tc-quote {
    max-height: calc(1.55em * 5);
    overflow: hidden;
    margin-bottom: 0.9rem;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .tc[data-ready] .is-long.is-open .tc-quote {
    max-height: none;
    -webkit-mask-image: none;
    mask-image: none;
  }
  .tc[data-ready] .tc-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    min-height: 44px;
    margin-bottom: 1rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--blue-text);
    transition: color var(--ix-fast) ease;
  }
  .tc-more :global(.tc-more-arrow) {
    transition: transform var(--ix-base) var(--ix-ease);
  }
  .tc-more:hover {
    color: var(--red-text);
  }
  .is-open .tc-more :global(.tc-more-arrow) {
    transform: rotate(-90deg);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tc-slide:not(.is-open) .tc-more:hover :global(.tc-more-arrow) {
      transform: translateX(4px);
    }
  }

  /* Navigation */
  .tc[data-ready] .tc-nav {
    display: flex;
  }
  .tc-nav {
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    position: relative;
  }
  .tc-arrow,
  .tc-pause {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border-2);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    transition:
      border-color var(--ix-fast) ease,
      color var(--ix-fast) ease,
      box-shadow var(--ix-base) var(--ix-ease);
  }
  .tc-prev :global(svg) {
    transform: scaleX(-1);
  }
  .tc-arrow :global(svg) {
    transition: translate var(--ix-base) var(--ix-ease);
  }
  .tc-arrow:hover,
  .tc-pause:hover {
    border-color: var(--red-text);
    color: var(--red-text);
    box-shadow: 0 6px 16px -8px rgba(194, 54, 54, 0.4);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tc-next:hover :global(svg) {
      translate: 4px 0;
    }
    .tc-prev:hover :global(svg) {
      translate: -4px 0;
    }
  }
  .tc-dots {
    display: flex;
    align-items: center;
    margin-inline: 0.5rem;
  }
  .tc-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 44px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .tc-dot span {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--border-2);
    transition:
      width var(--ix-base) var(--ix-ease),
      background-color var(--ix-base) var(--ix-ease);
  }
  .tc-dot:hover span {
    background: var(--muted);
  }
  .tc-dot[aria-current='true'] span {
    width: 24px;
    background: var(--red);
  }
  .tc-count {
    position: absolute;
    right: 52px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .tc-count-now {
    color: var(--ink);
  }
  .tc-pause {
    position: absolute;
    right: 0;
  }
  .tc-pause[hidden] {
    display: none;
  }
  .tc-pause .i-play,
  .tc-pause[aria-pressed='true'] .i-pause {
    display: none;
  }
  .tc-pause[aria-pressed='true'] .i-play {
    display: block;
  }

  @media (max-width: 640px) {
    .tc-count {
      position: static;
      order: -1;
      width: 100%;
      text-align: center;
      margin-bottom: 0.25rem;
    }
    .tc-nav {
      flex-wrap: wrap;
    }
    .tc-pause {
      position: static;
      width: 44px;
      height: 44px;
      margin-left: 0.25rem;
    }
    .tc-who {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }
</style>

<script>
  const ROTATE_MS = 7000;
  const RESUME_AFTER_MS = 12000;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('[data-tc]')) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.tc-slide'));
    const region = root.querySelector<HTMLElement>('.tc-slides')!;
    const nav = root.querySelector<HTMLElement>('.tc-nav');
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.tc-dot'));
    const countNow = root.querySelector<HTMLElement>('.tc-count-now');
    const pauseBtn = root.querySelector<HTMLButtonElement>('.tc-pause');
    let index = 0;
    let timer = 0;
    let resumeTimer = 0;
    let hovered = false;
    let focused = false;
    let inView = false;
    let stopped = reduceMotion; // pause button state (or reduced motion)
    let holding = false; // brief pause after the visitor navigates

    // "Read full review" (verbatim text stays in the DOM; only the clamp lifts).
    for (const btn of root.querySelectorAll<HTMLButtonElement>('.tc-more')) {
      const slide = btn.closest<HTMLElement>('.tc-slide')!;
      btn.addEventListener('click', () => {
        const open = slide.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
        btn.querySelector('span')!.textContent = open ? 'Show less' : 'Read full review';
        schedule();
      });
    }

    if (slides.length < 2 || !nav) {
      root.dataset.ready = '';
      continue;
    }
    nav.hidden = false;

    const running = () =>
      !stopped && !holding && !hovered && !focused && inView && !document.hidden &&
      !slides[index].classList.contains('is-open');

    function schedule() {
      window.clearTimeout(timer);
      if (running()) timer = window.setTimeout(() => show(index + 1, 1, false), ROTATE_MS);
    }

    function show(next: number, dir: 1 | -1, byUser: boolean) {
      const target = (next + slides.length) % slides.length;
      if (target === index) return;
      const current = slides[index];
      const incoming = slides[target];
      // Outgoing drifts slightly the other way; incoming starts 20px behind.
      current.style.setProperty('--from', `${-dir * 12}px`);
      incoming.style.setProperty('--from', `${dir * 20}px`);
      void incoming.offsetWidth; // commit the start position before animating
      current.classList.remove('is-active');
      incoming.classList.add('is-active');
      index = target;
      dots.forEach((d, i) => (i === index ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      if (countNow) countNow.textContent = String(index + 1).padStart(2, '0');
      // Announce only changes the visitor asked for.
      region.setAttribute('aria-live', byUser ? 'polite' : 'off');
      if (byUser) {
        holding = true;
        window.clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => {
          holding = false;
          schedule();
        }, RESUME_AFTER_MS);
      }
      schedule();
    }

    root.querySelector('.tc-prev')?.addEventListener('click', () => show(index - 1, -1, true));
    root.querySelector('.tc-next')?.addEventListener('click', () => show(index + 1, 1, true));
    dots.forEach((d, i) => d.addEventListener('click', () => show(i, i > index ? 1 : -1, true)));

    root.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('.tc-more')) return;
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1, 1, true); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1, -1, true); }
    });

    pauseBtn?.addEventListener('click', () => {
      stopped = !stopped;
      pauseBtn.setAttribute('aria-pressed', String(stopped));
      pauseBtn.setAttribute('aria-label', stopped ? 'Resume automatic rotation' : 'Pause automatic rotation');
      schedule();
    });
    if (reduceMotion && pauseBtn) pauseBtn.hidden = true;

    root.addEventListener('pointerenter', () => { hovered = true; schedule(); });
    root.addEventListener('pointerleave', () => { hovered = false; schedule(); });
    root.addEventListener('focusin', () => { focused = true; schedule(); });
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) { focused = false; schedule(); }
    });
    document.addEventListener('visibilitychange', schedule);
    new IntersectionObserver((entries) => {
      inView = entries.some((en) => en.isIntersecting);
      schedule();
    }, { threshold: 0.4 }).observe(root);

    root.dataset.ready = '';
    schedule();
  }
</script>
