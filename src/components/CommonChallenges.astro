---
/**
 * Home › Common Business Challenges — between Why TLS and What We Do.
 * Layout and copy: the "Fold 4" reference (Hemang, 2026-09-29;
 * docs/references/pages/home/fold-4-common-challenges.png), copy verbatim.
 * Visual: the TLS isometric platform image (Hemang, 2026-09-29), sharp in the
 * middle and softly blurred toward its edges (public/home/challenges-visual.webp),
 * dissolved into the canvas on every edge with CSS masks, so it reads as part
 * of the section, not a rectangle.
 * Each card links to the solution that answers that challenge.
 */
import Eyebrow from './Eyebrow.astro';
import Icon from './Icon.astro';
import type { IconName } from './iconTypes';
import type { Accent } from '../data/services';
import { href } from '../data/site';

interface Challenge {
  title: string;
  text: string;
  icon: IconName;
  accent: Accent;
  href: string;
}
const challenges: Challenge[] = [
  {
    title: 'Inefficient Processes',
    text: 'Eliminate waste and improve performance across your operations.',
    icon: 'chart',
    accent: 'red',
    href: '/services/workflow-automation/',
  },
  {
    title: 'Disconnected Systems',
    text: 'Integrate your tools and data for a unified, streamlined environment.',
    icon: 'database',
    accent: 'blue',
    href: '/services/integrations/',
  },
  {
    title: 'Scaling Teams',
    text: 'Build the right structure, processes, and technology to support growth.',
    icon: 'talent',
    accent: 'plum',
    href: '/services/technical-talent/',
  },
  {
    title: 'Underutilized Technology',
    text: 'Maximize the value of your current and new technology investments.',
    icon: 'gear',
    accent: 'red',
    href: '/services/technology-strategy/',
  },
];

const accents: Record<Accent, string> = {
  red: '--c: var(--red); --c-text: var(--red-text);',
  blue: '--c: var(--blue); --c-text: var(--blue-text);',
  plum: '--c: var(--plum); --c-text: var(--plum);',
};

const visual = href('/home/challenges-visual.webp');
---

<section class="cc" aria-labelledby="cc-title">
  <!-- Atmosphere (desktop): the platform image itself, deeply blurred, as a
       colour-matched haze reaching past the picture's edges. -->
  <div class="cc-aura" aria-hidden="true" style={`background-image: url(${visual})`}></div>
  <div class="wrap">
    <div class="cc-copy">
      <div class="cc-intro" data-reveal="stagger">
        <Eyebrow label="Common Business Challenges" />
        <h2 id="cc-title">Complex Challenges.<br /><span class="hl">Practical</span> Solutions.</h2>
        <p class="cc-lede">
          We help organizations turn real business challenges into clear,
          actionable solutions using a pragmatic, lean approach and the right
          technology.
        </p>
      </div>

      <!-- The cards and the image read together: on desktop (≥1280px) the
           image sits beside the cards, centered on them; below that it is a
           band between the intro and the cards. -->
      <div class="cc-body">
        <div class="cc-visual" data-reveal>
          <img
            src={visual}
            alt=""
            width="1672"
            height="941"
            loading="lazy"
            decoding="async"
          />
        </div>

        <ul class="cc-list" data-reveal="stagger">
          {
            challenges.map((c) => (
              <li>
                <a class="cc-card ix-card ix-card--quiet ix-light" href={href(c.href)} style={accents[c.accent]}>
                  <span class="cc-ic glass-icon">
                    <Icon name={c.icon} size={26} />
                  </span>
                  <span class="cc-text">
                    <h3 class="cc-title">{c.title}</h3>
                    <span class="cc-desc">{c.text}</span>
                  </span>
                  <span class="cc-arrow glass-icon" aria-hidden="true">
                    <Icon name="arrow" size={18} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .cc {
    /* The copy column: as wide as the h2 at its 3.5rem cap. The image is
       fully opaque only to its right; under the copy it is at most a faint
       haze, so it never costs the text any contrast. */
    --cc-col: 620px;
    /* The geometry below is resolved where it is used, by elements
       positioned in the section itself, so 100% is the section's width. */
    --cc-start: calc(max(0px, (100% - var(--wrap)) / 2) + var(--gutter));
    --cc-right: calc(var(--cc-start) + var(--cc-col)); /* the copy column's right edge */
    /* Desktop image width: the platform (0.203–0.855 of the image's width)
       fills the room from 40px right of the copy column to the screen edge;
       the image's faded left tiles run behind the cards and its right side
       runs off the screen. 1360px cap: its top and bottom fades stay inside
       the section. */
    --cc-img-w: clamp(760px, (100% - var(--cc-right) - 44px) / 0.652, 1360px);
    --cc-img-x: calc(var(--cc-right) + 40px - 0.203 * var(--cc-img-w)); /* image's left edge */
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg);
  }
  /* The image's glow on the page: a soft Build Blue / Bridge Plum wash
     centered on the image and reaching past its faded edges. closest-side
     ends both gradients inside the box, so they never stop on a line. */
  .cc::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    left: calc(var(--cc-img-x) - 0.1 * var(--cc-img-w));
    width: calc(1.4 * var(--cc-img-w));
    background:
      radial-gradient(closest-side at 50% 30%, rgba(135, 54, 98, 0.1), transparent),
      radial-gradient(closest-side at 46% 52%, rgba(18, 136, 207, 0.13), transparent);
    pointer-events: none;
  }
  .cc-aura {
    display: none;
  }
  .cc .wrap {
    display: flex;
    align-items: center;
    min-height: 700px;
    padding-block: var(--space-7); /* the site's section rhythm (.section) */
  }
  .cc-copy {
    width: 100%;
  }
  .cc-intro,
  .cc-list {
    max-width: var(--cc-col);
  }

  /* The visual. Desktop: the platform stands beside the whole copy column,
     level with the heading, and runs off the right of the screen. Its faded
     left tiles emerge from behind the cards (frosted, so only a faint tint
     shows through); the platform starts 40px right of them.
     It is positioned in the section (nothing between them is positioned),
     centered on its height, which is the copy column's.
     The image's own edges are already softly blurred; two masks (left/right
     × top/bottom, intersected) dissolve them into the haze behind, so the
     corners fade sharp → soft → page. The masks sit on the wrapper, over the
     image's area only: its 4px padding keeps the wrapper's own edges clear
     of the image (a masked edge that falls between pixels lets a sliver of
     that pixel through). */
  .cc-visual {
    /* The platform starts at 20.3% of the image, 40px right of the copy
       column. Up to the column's edge the image stays a faint tint (≤ 12%),
       so the lede keeps its AA contrast at every width, then it rises
       quickly to full by the platform's cards. */
    --cc-mask-x: linear-gradient(
      90deg,
      transparent 0%,
      rgba(0, 0, 0, 0.05) calc(20.3% - 160px),
      rgba(0, 0, 0, 0.12) calc(20.3% - 40px),
      rgba(0, 0, 0, 0.42) calc(20.3% - 18px),
      rgba(0, 0, 0, 0.8) calc(20.3% + 2px),
      #000 calc(20.3% + 24px),
      #000 82%,
      rgba(0, 0, 0, 0.75) 88%,
      rgba(0, 0, 0, 0.35) 94%,
      transparent 100%
    );
    --cc-mask-y: linear-gradient(
      180deg,
      transparent 0%,
      rgba(0, 0, 0, 0.2) 4%,
      rgba(0, 0, 0, 0.55) 9%,
      rgba(0, 0, 0, 0.85) 14%,
      #000 19%,
      #000 76%,
      rgba(0, 0, 0, 0.8) 83%,
      rgba(0, 0, 0, 0.45) 90%,
      rgba(0, 0, 0, 0.15) 96%,
      transparent 100%
    );
    /* Corners: an ellipse around the platform rounds off where the edge
       fades meet, so no corner of the picture ever shows. */
    --cc-mask-r: radial-gradient(
      ellipse 62% 64% at 56% 50%,
      #000 62%,
      rgba(0, 0, 0, 0.6) 80%,
      transparent 100%
    );
    position: absolute;
    z-index: -1;
    top: 50%;
    left: calc(var(--cc-img-x) - 4px);
    width: calc(var(--cc-img-w) + 8px);
    padding: 4px;
    translate: 0 -50%;
    pointer-events: none;
    -webkit-mask-image: var(--cc-mask-x), var(--cc-mask-y), var(--cc-mask-r);
    -webkit-mask-composite: source-in, source-in;
    mask-image: var(--cc-mask-x), var(--cc-mask-y), var(--cc-mask-r);
    mask-composite: intersect, intersect;
    mask-size: 100% 100%;
    mask-origin: content-box;
    mask-repeat: no-repeat;
  }
  .cc-visual img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Desktop atmosphere around the platform. */
  @media (min-width: 1280px) {
    /* The platform image, deeply blurred and lifted: a haze in its own
       colours that carries the scene up to the top of the section and past
       the picture's faded edges, like light in fog. Masked to nothing at
       every edge of the section. */
    .cc-aura {
      --aura-x: linear-gradient(90deg, transparent, #000 34%);
      --aura-y: linear-gradient(180deg, transparent 2%, #000 30%, #000 70%, transparent 98%);
      display: block;
      position: absolute;
      z-index: -1;
      top: 0;
      bottom: 0;
      left: var(--cc-right); /* never behind the copy */
      right: 0;
      background-size: cover;
      background-position: 42% 50%;
      background-repeat: no-repeat;
      filter: blur(28px) saturate(1.35) brightness(1.15);
      opacity: 0.5;
      -webkit-mask-image: var(--aura-x), var(--aura-y);
      -webkit-mask-composite: source-in;
      mask-image: var(--aura-x), var(--aura-y);
      mask-composite: intersect;
      pointer-events: none;
    }
  }

  .cc-intro :global(.eyebrow) {
    color: var(--text-2);
  }
  .cc h2 {
    font-size: clamp(2.3rem, 1.4rem + 2.8vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }
  .cc-lede {
    margin-top: var(--gap-lead);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-2);
  }

  .cc-list {
    display: grid;
    gap: 0.75rem;
    list-style: none;
    margin: var(--gap-block) 0 0;
    padding: 0;
  }
  .cc-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.1rem;
    padding: 0.8rem 1.1rem 0.8rem 0.8rem;
    background: rgba(255, 255, 255, 0.84);
    border: 1px solid rgba(226, 226, 238, 0.95);
    border-radius: var(--radius-lg);
    box-shadow: 0 6px 22px -14px rgba(13, 13, 13, 0.18);
    text-decoration: none;
    color: var(--ink);
  }
  .cc-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    color: var(--c);
  }
  .cc-text {
    display: grid;
    gap: 0.2rem;
    padding-left: 1.25rem;
    border-left: 1px solid var(--border);
  }
  .cc-title {
    font-size: 1.12rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .cc-desc {
    font-size: 0.93rem;
    line-height: 1.5;
    color: var(--text-2);
  }
  .cc-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--c);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cc-card:hover .cc-arrow {
      transform: translateX(5px);
    }
  }

  /* Story (wide desktop; the scroll layer pins the section and sets
     .is-story / .is-active): one challenge at a time comes forward — lifted
     surface, accent edge and light, full-colour icon — while the others sit
     back: flatter, title in secondary grey, icon desaturated. Text keeps full
     AA contrast in both states (nothing is faded with opacity). */
  .cc-card {
    transition:
      scale 520ms var(--ix-ease),
      background-color 520ms var(--ix-ease),
      border-color 520ms var(--ix-ease),
      box-shadow 520ms var(--ix-ease);
  }
  .cc-title {
    transition: color 420ms var(--ix-ease);
  }
  .cc-ic,
  .cc-arrow {
    transition:
      transform var(--ix-base) var(--ix-ease),
      filter 520ms var(--ix-ease),
      opacity 520ms var(--ix-ease);
  }
  .cc:global(.is-story) .cc-card {
    background: rgba(255, 255, 255, 0.62);
    box-shadow: none;
  }
  .cc:global(.is-story) .cc-card .cc-title {
    color: var(--text-2);
  }
  .cc:global(.is-story) .cc-card :is(.cc-ic, .cc-arrow) {
    filter: saturate(0.3);
    opacity: 0.7;
  }
  .cc:global(.is-story) .cc-card:global(.is-active) {
    scale: 1.012;
    background: color-mix(in srgb, var(--c) 3%, #fff);
    border-color: color-mix(in srgb, var(--c) 45%, var(--border));
    box-shadow:
      0 22px 44px -22px color-mix(in srgb, var(--c) 60%, transparent),
      0 0 0 1px color-mix(in srgb, var(--c) 14%, transparent),
      0 2px 6px rgba(13, 13, 13, 0.04);
  }
  /* Desktop: the cards are frosted glass over the platform's haze. */
  @media (min-width: 1280px) {
    .cc-card {
      background: rgba(255, 255, 255, 0.8);
      -webkit-backdrop-filter: blur(14px) saturate(1.4);
      backdrop-filter: blur(14px) saturate(1.4);
    }
  }
  .cc:global(.is-story) .cc-card:global(.is-active) .cc-title {
    color: var(--ink);
  }
  .cc:global(.is-story) .cc-card:global(.is-active) :is(.cc-ic, .cc-arrow) {
    filter: none;
    opacity: 1;
  }
  .cc:global(.is-story) .cc-card:global(.is-active) .cc-arrow {
    transform: translateX(5px);
  }

  /* Entrance: copy and cards rise in sequence (reveal system); the image
     settles from a hair larger with a fade. */
  .cc-intro,
  .cc-list {
    --ix-rise: 18px;
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    :global(html.ix) .cc-visual[data-reveal]:global(.is-in) {
      animation: cc-settle 900ms var(--ix-ease) backwards;
    }
  }
  @keyframes cc-settle {
    from {
      opacity: 0;
      scale: 1.02;
    }
  }

  /* Below 1280px the room beside the copy is too narrow for the whole
     platform, so: intro, then the image, then the cards. The image keeps its
     shape and dissolves on all four sides (edge to edge on phones; up to
     1000px wide, centered, on tablets). */
  @media (max-width: 1279px) {
    .cc .wrap {
      display: block;
      min-height: 0;
    }
    .cc::before {
      display: none;
    }
    .cc-list {
      max-width: none;
    }
    .cc-intro {
      max-width: 680px;
    }
    .cc-visual {
      --cc-mask-x: linear-gradient(
        90deg,
        transparent 0%,
        rgba(0, 0, 0, 0.45) 5.5%,
        #000 12%,
        #000 88%,
        rgba(0, 0, 0, 0.45) 94.5%,
        transparent 100%
      );
      --cc-mask-y: linear-gradient(
        180deg,
        transparent 0%,
        rgba(0, 0, 0, 0.45) 7.5%,
        #000 16%,
        #000 86%,
        rgba(0, 0, 0, 0.45) 93%,
        transparent 100%
      );
      --cc-mask-r: radial-gradient(ellipse 58% 60% at 50% 50%, #000 64%, rgba(0, 0, 0, 0.6) 82%, transparent 100%);
      position: relative;
      z-index: 0;
      top: auto;
      left: auto;
      translate: none;
      width: min(100% + 2 * var(--gutter), 1000px);
      margin: 0.25rem 0 0 max(-1 * var(--gutter), (100% - 1000px) / 2);
    }
    .cc-list {
      grid-template-columns: 1fr 1fr;
      margin-top: 0.5rem; /* the image's own bottom fade is the gap */
    }
  }
  @media (max-width: 768px) {
    .cc .wrap {
      padding-block: var(--space-6);
    }
  }
  @media (max-width: 640px) {
    .cc-list {
      grid-template-columns: 1fr;
    }
    .cc-card {
      gap: 1rem;
    }
    .cc-ic {
      width: 48px;
      height: 48px;
    }
    .cc-text {
      padding-left: 1rem;
    }
  }
  /* Small phones: give the copy the room. */
  @media (max-width: 480px) {
    .cc-card {
      gap: 0.8rem;
      padding: 0.75rem 0.85rem 0.75rem 0.75rem;
    }
    .cc-ic {
      width: 44px;
      height: 44px;
    }
    .cc-text {
      padding-left: 0.8rem;
    }
    .cc-arrow {
      width: 34px;
      height: 34px;
    }
  }
</style>
