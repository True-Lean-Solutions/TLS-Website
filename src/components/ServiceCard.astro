---
import Icon from './Icon.astro';
import type { IconName } from './iconTypes';
import type { Accent } from '../data/services';
import { href as withBase } from '../data/site';

interface Props {
  title: string;
  href: string;
  icon: IconName;
  accent: Accent;
  blurb: string;
}
const { title, href, icon, accent, blurb } = Astro.props;

const accents: Record<Accent, string> = {
  red: '--c: var(--red); --c-tint: var(--red-tint);',
  blue: '--c: var(--blue); --c-tint: var(--blue-tint);',
  plum: '--c: var(--plum); --c-tint: var(--plum-tint);',
};
---

<a class="service-card" href={withBase(href)} style={accents[accent]}>
  <span class="icon"><Icon name={icon} size={26} /></span>
  <span class="rule" aria-hidden="true"></span>
  <h3>{title}</h3>
  <p>{blurb}</p>
  <span class="arrow" aria-hidden="true"><Icon name="arrow" size={18} /></span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    text-decoration: none;
    color: var(--ink);
    box-shadow: var(--shadow);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-m);
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    background: var(--c-tint);
    color: var(--c);
  }
  .rule {
    display: block;
    width: 2rem;
    height: 3px;
    border-radius: 999px;
    background: var(--c);
    margin: 0.35rem 0 0.15rem;
  }
  h3 {
    font-size: var(--step-1);
  }
  p {
    color: var(--text-2);
    font-size: 0.96rem;
    flex-grow: 1;
  }
  .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--c-tint);
    color: var(--c);
    margin-top: 0.6rem;
    transition: transform 0.18s ease;
  }
  .service-card:hover .arrow {
    transform: translateX(4px);
  }
</style>
