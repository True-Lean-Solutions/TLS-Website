---
import Icon from './Icon.astro';
import type { IconName } from './iconTypes';
import type { Accent } from '../data/services';
import { href as withBase } from '../data/site';

interface Props {
  title: string;
  href: string;
  icon: IconName;
  accent: Accent;
  blurb: string;
}
const { title, href, icon, accent, blurb } = Astro.props;

const accents: Record<Accent, string> = {
  red: '--c: var(--red); --c-tint: var(--red-tint);',
  blue: '--c: var(--blue); --c-tint: var(--blue-tint);',
  plum: '--c: var(--plum); --c-tint: var(--plum-tint);',
};
---

<a class="service-card ix-card ix-light" href={withBase(href)} style={accents[accent]}>
  <span class="icon glass-icon"><Icon name={icon} size={26} /></span>
  <span class="rule" aria-hidden="true"></span>
  <h3>{title}</h3>
  {blurb ? <p>{blurb}</p> : <span class="grow" aria-hidden="true"></span>}
  <span class="arrow glass-icon" aria-hidden="true"><Icon name="arrow" size={18} /></span>
</a>

<style>
  /* Hover lift, cursor light and glass icons: motion.css (.ix-card, .ix-light, .glass-icon). */
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    text-decoration: none;
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    color: var(--c);
  }
  .rule {
    display: block;
    width: 2rem;
    height: 3px;
    border-radius: 999px;
    background: var(--c);
    margin: 0.35rem 0 0.15rem;
  }
  h3 {
    font-size: var(--step-1);
  }
  p {
    color: var(--text-2);
    font-size: 0.96rem;
    flex-grow: 1;
  }
  /* A name-only card keeps its arrow at the bottom like the others. */
  .grow {
    flex-grow: 1;
  }
  .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: var(--c);
    margin-top: 0.6rem;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .service-card:hover .arrow {
      transform: translateX(5px);
    }
  }
</style>
