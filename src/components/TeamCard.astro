---
import type { Person } from '../data/team';
import { href as withBase } from '../data/site';

interface Props {
  person: Person;
}
const { person } = Astro.props;
const paras = Array.isArray(person.bio) ? person.bio : [person.bio];
const bioId = `bio-${person.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<article class="team-card ix-card ix-card--quiet ix-light">
  <div class="photo-wrap">
    <img
      class="photo"
      src={withBase(person.photo)}
      alt={`${person.name}, ${person.role}`}
      width="400"
      height="400"
      loading="lazy"
    />
  </div>
  <div class="body">
    <div class="head">
      <div>
        <h3>{person.name}</h3>
        <p class="role">{person.role}</p>
      </div>
      {
        person.linkedin && (
          <a class="li" href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} on LinkedIn`}>
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              />
            </svg>
          </a>
        )
      }
    </div>
    <div class="bio-wrap" id={bioId} data-bio>
      {paras.map((para) => <p class="bio">{para}</p>)}
    </div>
    <button type="button" class="bio-more" aria-expanded="false" aria-controls={bioId} hidden>
      <span>See more</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    </button>
  </div>
</article>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  /* Hover: lift + light from motion.css; here the photo eases in ~2.5% and a
     faint reflection crosses it once. The wrapper clips both to the frame. */
  .photo-wrap {
    position: relative;
    overflow: hidden;
  }
  .photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: var(--section);
    transition: transform 800ms var(--ix-ease);
  }
  .photo-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 35%,
      rgba(255, 255, 255, 0.14) 50%,
      transparent 65%
    );
    transform: translateX(-100%);
    pointer-events: none;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .team-card:hover .photo {
      transform: scale(1.025);
    }
    .team-card:hover .photo-wrap::after {
      transform: translateX(100%);
      transition: transform 1000ms var(--ix-ease);
    }
  }
  .body {
    padding: 1.4rem;
    display: grid;
    gap: 0.7rem;
  }
  .head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  h3 {
    font-size: var(--step-1);
  }
  .role {
    color: var(--red-text);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  /* LinkedIn's own mark, in LinkedIn blue; a 34px hit area around it. */
  .li {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    color: #0a66c2;
    transition:
      color var(--ix-fast) var(--ix-ease),
      transform var(--ix-fast) var(--ix-ease);
  }
  .li:hover {
    color: #004182;
  }
  .li:focus-visible {
    outline: 2px solid var(--blue-text);
    outline-offset: 2px;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .li:hover {
      transform: translateY(-1px);
    }
  }
  .bio {
    color: var(--text-2);
    font-size: 0.92rem;
    line-height: 1.55;
  }
  .bio + .bio {
    margin-top: 0.6rem;
  }
  /* Every bio shows the same five lines; "See more" opens the rest. The
     clamp only applies once the script finds a bio longer than that, so
     without JS every bio reads in full. */
  .bio-wrap.is-clamped:not(.is-open) {
    max-height: calc(0.92rem * 1.55 * 5);
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, #000 55%, transparent);
    mask-image: linear-gradient(180deg, #000 55%, transparent);
  }
  .bio-more {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: -0.2rem;
    padding: 0.25rem 0;
    border: 0;
    background: none;
    cursor: pointer;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.86rem;
    color: var(--red-text);
  }
  .bio-more[hidden] {
    display: none;
  }
  .bio-more:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .bio-more:focus-visible {
    outline: 2px solid var(--blue-text);
    outline-offset: 2px;
    border-radius: 4px;
  }
  .bio-more svg {
    transition: transform var(--ix-fast) var(--ix-ease);
  }
  .bio-more[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }
</style>

<script>
  // Clamp each bio that runs longer than five lines and give it a "See more"
  // toggle; re-measured when fonts load and when the width changes.
  const bios = [...document.querySelectorAll<HTMLElement>('[data-bio]')];
  const measure = () => {
    for (const wrap of bios) {
      const btn = wrap.nextElementSibling as HTMLButtonElement | null;
      if (!btn || wrap.classList.contains('is-open')) continue;
      wrap.classList.add('is-clamped');
      const overflows = wrap.scrollHeight > wrap.clientHeight + 2;
      wrap.classList.toggle('is-clamped', overflows);
      btn.hidden = !overflows;
    }
  };
  for (const wrap of bios) {
    const btn = wrap.nextElementSibling as HTMLButtonElement | null;
    btn?.addEventListener('click', () => {
      const open = wrap.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('span')!.textContent = open ? 'See less' : 'See more';
      // The page got taller or shorter: let the scroll layer re-measure.
      window.dispatchEvent(new Event('resize'));
    });
  }
  measure();
  document.fonts?.ready.then(measure);
  let width = window.innerWidth;
  window.addEventListener('resize', () => {
    if (window.innerWidth === width) return;
    width = window.innerWidth;
    measure();
  });
</script>
