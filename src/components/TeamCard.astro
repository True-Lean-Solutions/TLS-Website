---
import type { Person } from '../data/team';
import { href as withBase } from '../data/site';

interface Props {
  person: Person;
}
const { person } = Astro.props;
---

<article class="team-card ix-card ix-card--quiet ix-light">
  <div class="photo-wrap">
    <img
      class="photo"
      src={withBase(person.photo)}
      alt={`${person.name}, ${person.role}`}
      width="400"
      height="400"
      loading="lazy"
    />
  </div>
  <div class="body">
    <div class="head">
      <div>
        <h3>{person.name}</h3>
        <p class="role">{person.role}</p>
      </div>
      <a class="li glass-icon glass-icon--neutral" href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} on LinkedIn`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.02 5 2.5 2.5 0 01.02-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21H19v-5.4c0-1.3 0-2.96-1.8-2.96-1.8 0-2.08 1.4-2.08 2.86V21H9z"/></svg>
      </a>
    </div>
    <p class="bio">{person.bio}</p>
  </div>
</article>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  /* Hover: lift + light from motion.css; here the photo eases in ~2.5% and a
     faint reflection crosses it once. The wrapper clips both to the frame. */
  .photo-wrap {
    position: relative;
    overflow: hidden;
  }
  .photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: var(--section);
    transition: transform 800ms var(--ix-ease);
  }
  .photo-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 35%,
      rgba(255, 255, 255, 0.14) 50%,
      transparent 65%
    );
    transform: translateX(-100%);
    pointer-events: none;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .team-card:hover .photo {
      transform: scale(1.025);
    }
    .team-card:hover .photo-wrap::after {
      transform: translateX(100%);
      transition: transform 1000ms var(--ix-ease);
    }
  }
  .body {
    padding: 1.4rem;
    display: grid;
    gap: 0.7rem;
  }
  .head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  h3 {
    font-size: var(--step-1);
  }
  .role {
    color: var(--red-text);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  .li {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    color: var(--ink);
    --gi-hover: var(--blue);
  }
  .li:hover {
    color: var(--blue-text);
  }
  .bio {
    color: var(--text-2);
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>
