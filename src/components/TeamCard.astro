---
import type { Person } from '../data/team';
import { href as withBase } from '../data/site';

interface Props {
  person: Person;
}
const { person } = Astro.props;
---

<article class="team-card ix-card ix-card--quiet ix-light">
  <div class="photo-wrap">
    <img
      class="photo"
      src={withBase(person.photo)}
      alt={`${person.name}, ${person.role}`}
      width="400"
      height="400"
      loading="lazy"
    />
  </div>
  <div class="body">
    <div class="head">
      <div>
        <h3>{person.name}</h3>
        <p class="role">{person.role}</p>
      </div>
      {
        person.linkedin && (
          <a class="li" href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} on LinkedIn`}>
            <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
              />
            </svg>
          </a>
        )
      }
    </div>
    <p class="bio">{person.bio}</p>
  </div>
</article>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  /* Hover: lift + light from motion.css; here the photo eases in ~2.5% and a
     faint reflection crosses it once. The wrapper clips both to the frame. */
  .photo-wrap {
    position: relative;
    overflow: hidden;
  }
  .photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    background: var(--section);
    transition: transform 800ms var(--ix-ease);
  }
  .photo-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      transparent 35%,
      rgba(255, 255, 255, 0.14) 50%,
      transparent 65%
    );
    transform: translateX(-100%);
    pointer-events: none;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .team-card:hover .photo {
      transform: scale(1.025);
    }
    .team-card:hover .photo-wrap::after {
      transform: translateX(100%);
      transition: transform 1000ms var(--ix-ease);
    }
  }
  .body {
    padding: 1.4rem;
    display: grid;
    gap: 0.7rem;
  }
  .head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.75rem;
  }
  h3 {
    font-size: var(--step-1);
  }
  .role {
    color: var(--red-text);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    margin-top: 0.15rem;
  }
  /* LinkedIn's own mark, in LinkedIn blue; a 34px hit area around it. */
  .li {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    color: #0a66c2;
    transition:
      color var(--ix-fast) var(--ix-ease),
      transform var(--ix-fast) var(--ix-ease);
  }
  .li:hover {
    color: #004182;
  }
  .li:focus-visible {
    outline: 2px solid var(--blue-text);
    outline-offset: 2px;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .li:hover {
      transform: translateY(-1px);
    }
  }
  .bio {
    color: var(--text-2);
    font-size: 0.92rem;
    line-height: 1.55;
  }
</style>
