      padding-top: 0.75rem;
    }
    .cs-benefits li {
      padding-bottom: 0.4rem;
    }
  }

  /* ---------- 2. Why it matters ---------- */
  .cs-why {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: linear-gradient(180deg, #fff 0%, var(--bg) 70%);
  }
  .cs-why-waves {
