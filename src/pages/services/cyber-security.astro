---
/**
 * Cyber Security (Hemang's brief and fold references, 2026-10-06;
 * docs/references/pages/services/cyber-security/). Replaces the short
 * [solution].astro page for this route.
 *
 * Copy: the approved headline (Hemang, 2026-09-29), then the brief's and the
 * references' own lines. No Cyber Security source doc exists yet
 * (docs/sources.md §5), so the capability lines are to confirm. No proof is
 * shown: there is no Cyber Security case study, review or client to cite.
 *
 * Visuals follow v2.3 §13 (isometric system art, a restrained red/blue edge
 * light), not the references' security-operations photos (v2.3 §13 rules out
 * cyber/SOC imagery). The signature section builds its stack with the scroll
 * (src/scripts/scroll/security.ts); without motion every visual is complete.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import FaqList from '../../components/FaqList.astro';
import type { IconName } from '../../components/iconTypes';
import { cta, href } from '../../data/site';

const title = 'True Lean Solutions — Cyber Security';
const lede =
  'Strengthen your security posture, reduce risk and keep your operations running with practical, business-focused cybersecurity solutions.';
const description =
  'Protect what your business depends on. True Lean Solutions helps you strengthen your security posture, reduce risk and keep your operations running, across people, processes and technology.';

type Accent = 'red' | 'blue' | 'violet' | 'green';
const tone: Record<Accent, string> = { red: 'var(--red)', blue: 'var(--blue)', violet: 'var(--cs-violet)', green: 'var(--cs-green)' };

/* ---------- Isometric drawing (hero and layer stack) ---------- */
type Pt = [number, number];
const COS = Math.cos(Math.PI / 6);
const r1 = (n: number) => Math.round(n * 10) / 10;
/** Ground point (x, y) at height z, projected around the screen origin o. */
const iso = (o: Pt, x: number, y: number, z = 0): Pt => [r1(o[0] + (x - y) * COS), r1(o[1] + (x + y) / 2 - z)];
const poly = (ps: Pt[]) => ps.map((p) => p.join(',')).join(' ');
const at = (p: Pt) => p.join(' ');
/** A square slab (half-size a) from height z0 to z1: visible faces, lit front edge, glass inset. */
function slab(o: Pt, a: number, z0: number, z1: number, c: Pt = [0, 0]) {
  const p = (x: number, y: number, z: number) => iso(o, c[0] + x, c[1] + y, z);
  const i = a * 0.78;
  return {
    top: poly([p(-a, -a, z1), p(a, -a, z1), p(a, a, z1), p(-a, a, z1)]),
    left: poly([p(-a, a, z0), p(a, a, z0), p(a, a, z1), p(-a, a, z1)]),
    right: poly([p(a, -a, z0), p(a, a, z0), p(a, a, z1), p(a, -a, z1)]),
    edge: `M${at(p(-a, a, z1))} L${at(p(a, a, z1))} L${at(p(a, -a, z1))}`,
    inset: poly([p(-i, -i, z1), p(i, -i, z1), p(i, i, z1), p(-i, i, z1)]),
  };
}
/** A circle of radius r on the ground plane at height z: an ellipse on screen. */
const ring = (o: Pt, r: number, z = 0) => ({ cx: o[0], cy: r1(o[1] - z), rx: r1(r * Math.SQRT2 * COS), ry: r1((r * Math.SQRT2) / 2) });
/** Shield outline, 120 × 150, drawn from its top center. */
const SHIELD = 'M0 0 C20 12 40 16 60 16 L60 72 C60 112 32 136 0 150 C-32 136 -60 112 -60 72 L-60 16 C-40 16 -20 12 0 0 Z';
const CHECK = 'M-22 74 L-6 90 L24 58';
/** Flowing lines (the page's red/blue motif), in a 1440 × 360 box. */
const waves = (n: number) =>
  Array.from({ length: n }, (_, i) => `M0 ${250 + i * 9} C 300 ${180 + i * 12}, 520 ${330 - i * 6}, 820 ${240 + i * 5} S 1260 ${120 + i * 14}, 1440 ${170 + i * 10}`);

/* Hero: what the business depends on, inside one protected perimeter around the TLS platform. */
const HO: Pt = [360, 330];
/** The hero scene's crop of its 720 × 600 drawing (labels are placed against it). */
const HV = { x: 60, y: 78, w: 600, h: 444 };
const heroGrid: string[] = [];
for (let g = -240; g <= 240; g += 48) {
  heroGrid.push(`M${at(iso(HO, g, -240))} L${at(iso(HO, g, 240))}`, `M${at(iso(HO, -240, g))} L${at(iso(HO, 240, g))}`);
}
const perimeter = ring(HO, 218);
const innerRing = ring(HO, 150);
const plinth = slab(HO, 92, 0, 20);
const deck = slab(HO, 74, 20, 36);
const deckGlow = ring(HO, 52, 36);
const sats = (
  [
    { c: [-200, 0], label: 'Your data', icon: 'database' },
    { c: [0, -200], label: 'Your systems', icon: 'server' },
    { c: [0, 200], label: 'Your people', icon: 'users' },
    { c: [200, 0], label: 'Your operations', icon: 'workflow' },
  ] as { c: Pt; label: string; icon: IconName }[]
).map((s, i) => {
  const top = iso(HO, s.c[0], s.c[1], 14);
  const along = (k: number) => iso(HO, s.c[0] * k, s.c[1] * k);
  return {
    ...s,
    i,
    back: s.c[0] + s.c[1] < 0,
    shape: slab(HO, 28, 0, 14, s.c),
    link: `M${at(along(0.84))} L${at(along(0.5))}`,
    stem: `M${at(top)} L${top[0]} ${top[1] - 34}`,
    x: (((top[0] - HV.x) / HV.w) * 100).toFixed(2),
    y: (((top[1] - 34 - HV.y) / HV.h) * 100).toFixed(2),
  };
});

const benefits: { title: string; text: string; icon: IconName; c: Accent }[] = [
  { title: 'Risk-based approach', text: 'Focus on what matters to your business.', icon: 'target', c: 'red' },
  { title: 'Practical solutions', text: 'Aligned to your operations and goals.', icon: 'check', c: 'blue' },
  { title: 'People, process and technology', text: 'A holistic approach to security.', icon: 'users', c: 'violet' },
  { title: 'Ongoing support', text: 'Helping you stay resilient as you grow.', icon: 'chart', c: 'green' },
];

/* Why it matters: four outcomes, all serving the business at the center. */
const outcomes: { title: string; text: string; icon: IconName; c: Accent; link: string }[] = [
  { title: 'Reduce Risk', text: 'Identify and mitigate security risks before they become problems.', icon: 'shield', c: 'red', link: 'M50 50 L24 26' },
  { title: 'Protect Critical Data', text: 'Safeguard sensitive information and business assets.', icon: 'database', c: 'blue', link: 'M50 50 L76 26' },
  { title: 'Maintain Business Continuity', text: 'Keep your operations running with strong security practices.', icon: 'workflow', c: 'violet', link: 'M50 50 L24 74' },
  { title: 'Meet Compliance Requirements', text: 'Align with industry standards and regulatory needs.', icon: 'checklist', c: 'green', link: 'M50 50 L76 74' },
];

/* Our approach: three circles that meet in the middle. */
const pillars: { k: string; title: string; text: string; icon: IconName; c: Accent; cx: number; cy: number; dx: number; dy: number; lx: number; ly: number }[] = [
  {
    k: 'people',
    title: 'People',
    text: 'Security depends on everyday decisions. Your team should know what to look for and what to do.',
    icon: 'users',
    c: 'red',
    cx: 230, cy: 150, dx: 0, dy: -1, lx: 230, ly: 100,
  },
  {
    k: 'process',
    title: 'Process',
    text: 'Clear policies turn good intentions into consistent practice: for access, for change and for incidents.',
    icon: 'document',
    c: 'violet',
    cx: 162, cy: 268, dx: -0.87, dy: 0.5, lx: 122, ly: 306,
  },
  {
    k: 'technology',
    title: 'Technology',
    text: 'Controls work best when they fit how you operate. We set them up around your business, not the other way round.',
    icon: 'server',
    c: 'blue',
    cx: 298, cy: 268, dx: 0.87, dy: 0.5, lx: 338, ly: 306,
  },
];

/* Security at every layer: six layers, built bottom to top. */
const LO: Pt = [450, 505];
const LAYER_TOP = 44 * 5 + 12;
const layers = (
  [
    { title: 'People & Awareness', text: 'Awareness and training, so your team recognizes risks and knows how to respond.', icon: 'users', c: '#e25a5a' },
    { title: 'Processes & Policies', text: 'Risk management, access control and clear policies that make security part of how work gets done.', icon: 'document', c: '#c35b9c' },
    { title: 'Infrastructure & Technology', text: 'The right security controls for your systems, networks and devices.', icon: 'server', c: '#8b6cf0' },
    { title: 'Threat Detection & Response', text: 'Detect threats early and respond before they impact your business.', icon: 'alert', c: '#3b9fe6' },
    { title: 'Data Protection', text: 'Safeguard sensitive information and business assets.', icon: 'database', c: '#22b8cf' },
    { title: 'Compliance & Governance', text: 'Align with industry standards and regulatory needs, with clear ownership and oversight.', icon: 'checklist', c: '#2fbf8f' },
  ] as { title: string; text: string; icon: IconName; c: string }[]
).map((l, k) => {
  const a = 108 - 6 * k;
  const z0 = 44 * k;
  const left = k % 2 === 0;
  const corner = iso(LO, left ? -a : a, left ? a : -a, z0 + 6);
  const end = left ? 210 : 690;
  return {
    ...l,
    k,
    left,
    shape: slab(LO, a, z0, z0 + 12),
    corner,
    link: `M${at(corner)} H${end}`,
    x: (((left ? end - 6 : end + 6) / 900) * 100).toFixed(2),
    y: ((corner[1] / 680) * 100).toFixed(2),
  };
});
const layerBase = slab(LO, 124, -26, -8);
const layerFloor = ring(LO, 200, -26);
const layerHalo = ring(LO, 84, LAYER_TOP);

/* How we help: four stages on one continuous loop. */
const stages: { title: string; text: string; icon: IconName; c: Accent; x: number; y: number }[] = [
  { title: 'Assess & Plan', text: 'Understand your current security posture, identify risks and define a clear plan.', icon: 'search', c: 'red', x: 50, y: 12.5 },
  { title: 'Implement & Secure', text: 'Deploy the right security controls, policies and processes for your business.', icon: 'lock', c: 'blue', x: 87.5, y: 50 },
  { title: 'Monitor & Detect', text: 'Detect threats early and respond before they impact your business.', icon: 'analytics', c: 'violet', x: 50, y: 87.5 },
  { title: 'Support & Improve', text: 'Ongoing support, training and continuous improvement as your business grows.', icon: 'chart', c: 'green', x: 12.5, y: 50 },
];

/* FAQ: answers from this page's own copy and the approved positioning only. */
const faqs: { q: string; a: string[] }[] = [
  {
    q: 'What cyber security services do you offer?',
    a: [
      'End-to-end support in four stages: we assess your current security posture and define a clear plan; implement the right security controls, policies and processes; monitor so threats are detected early and handled before they impact your business; and provide ongoing support, training and continuous improvement as your business grows.',
    ],
  },
  {
    q: 'How do you assess security risks?',
    a: [
      'We start with your business: what it depends on and what matters most. Then we review your current security posture across people, processes and technology, identify the risks and define a clear plan that deals with the most important ones first.',
    ],
  },
  {
    q: 'Is cyber security only about technology?',
    a: [
      'No. Security is strongest when people, processes and technology work together: awareness and training for your team, clear policies for risk and access, and the right controls for your systems and data.',
    ],
  },
  {
    q: 'What happens after implementation?',
    a: [
      "Security doesn't stop at go-live. We stay engaged with ongoing support, training and continuous improvement, so your protection keeps pace as your business grows.",
    ],
  },
  {
    q: 'What types of businesses do you work with?',
    a: [
      'Growing small and mid-sized businesses. Everything we do is scoped and priced for the constraints you work under.',
      "Most businesses we work with know something isn't working but aren't sure which lever to pull first. That's a fine place to start.",
    ],
  },
];
---

<BaseLayout title={title} description={description} path="/services/cyber-security/">
  <!-- 1. Hero -->
  <section class="cs-hero">
    <svg class="cs-waves cs-hero-waves" viewBox="0 0 1440 360" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="csh-wave" x1="0" x2="1">
          <stop offset="0" stop-color="#D94040" stop-opacity="0.75" />
          <stop offset="0.5" stop-color="#873662" stop-opacity="0.35" />
          <stop offset="1" stop-color="#1288CF" stop-opacity="0.8" />
        </linearGradient>
      </defs>
      {waves(9).map((d) => <path d={d} stroke="url(#csh-wave)" />)}
    </svg>
    <div class="wrap cs-hero-grid">
      <div class="cs-hero-copy" data-reveal="load">
        <nav class="cs-crumbs" aria-label="Breadcrumb">
          <a href={href('/services/')}>Solutions</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Cyber Security</span>
        </nav>
        <Eyebrow label="Cyber Security" />
        <h1>Protect what <span class="accent">your business depends on.</span></h1>
        <p class="cs-lede">{lede}</p>
        <div class="cs-actions">
          <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
          <Button href={cta.email.href} variant="ghost-light" external>{cta.email.label}</Button>
        </div>
      </div>

      <div class="cs-hero-art">
        <div class="cs-hero-scene" data-hero-photo>
          <svg viewBox={`${HV.x} ${HV.y} ${HV.w} ${HV.h}`} aria-hidden="true">
            <defs>
              <radialGradient id="csh-fade" cx="0.5" cy="0.55" r="0.5">
                <stop offset="0.35" stop-color="#fff" />
                <stop offset="1" stop-color="#000" />
              </radialGradient>
              <mask id="csh-grid-mask"><rect width="720" height="600" fill="url(#csh-fade)" /></mask>
              <linearGradient id="csh-ring" x1="0" x2="1">
                <stop offset="0" stop-color="#D94040" />
                <stop offset="0.5" stop-color="#8b6cf0" />
                <stop offset="1" stop-color="#1288CF" />
              </linearGradient>
              <linearGradient id="csh-edge" gradientUnits="userSpaceOnUse" x1="200" y1="0" x2="520" y2="0">
                <stop offset="0" stop-color="#ff6b6b" />
                <stop offset="0.5" stop-color="#b86bd8" />
                <stop offset="1" stop-color="#4fb6ff" />
              </linearGradient>
              <linearGradient id="csh-face-l" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#1c2b55" />
                <stop offset="1" stop-color="#0c1430" />
              </linearGradient>
              <linearGradient id="csh-face-r" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#14224a" />
                <stop offset="1" stop-color="#090f24" />
              </linearGradient>
              <linearGradient id="csh-shield" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#1e5fa8" stop-opacity="0.55" />
                <stop offset="1" stop-color="#0b1a3a" stop-opacity="0.85" />
              </linearGradient>
              <linearGradient id="csh-shield-line" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#9fdcff" />
                <stop offset="1" stop-color="#2f8fe6" />
              </linearGradient>
              <linearGradient id="csh-beam" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#7cc4ff" stop-opacity="0" />
                <stop offset="0.5" stop-color="#7cc4ff" stop-opacity="0.75" />
                <stop offset="1" stop-color="#7cc4ff" stop-opacity="0.1" />
              </linearGradient>
              <radialGradient id="csh-pool">
                <stop offset="0" stop-color="#4fb6ff" stop-opacity="0.55" />
                <stop offset="1" stop-color="#4fb6ff" stop-opacity="0" />
              </radialGradient>
              <filter id="csh-soft" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="9" /></filter>
            </defs>

            <g class="cs-grid" mask="url(#csh-grid-mask)">{heroGrid.map((d) => <path d={d} />)}</g>
            <ellipse class="cs-ring-inner" {...innerRing} />
            <ellipse class="cs-perimeter" {...perimeter} />
            <ellipse class="cs-sweep" {...perimeter} pathLength="100" />

            {
              sats.filter((s) => s.back).map((s) => (
                <g class="cs-sat" style={`--i: ${s.i}`}>
                  <polygon class="cs-sat-l" points={s.shape.left} />
                  <polygon class="cs-sat-r" points={s.shape.right} />
                  <polygon class="cs-sat-top" points={s.shape.top} />
                  <path class="cs-stem" d={s.stem} />
                </g>
              ))
            }
            {
              sats.map((s) => (
                <g class="cs-flow" style={`--i: ${s.i}`}>
                  <path class="cs-link-base" d={s.link} />
                  <path class="cs-pulse" d={s.link} pathLength="100" />
                </g>
              ))
            }

            <g class="cs-platform">
              <polygon class="cs-plat-l" points={plinth.left} />
              <polygon class="cs-plat-r" points={plinth.right} />
              <polygon class="cs-plat-top" points={plinth.top} />
              <path class="cs-plat-edge" d={plinth.edge} />
              <polygon class="cs-plat-l" points={deck.left} />
              <polygon class="cs-plat-r" points={deck.right} />
              <polygon class="cs-plat-top" points={deck.top} />
              <polygon class="cs-plat-inset" points={deck.inset} />
              <path class="cs-plat-edge" d={deck.edge} />
              <ellipse class="cs-pool" {...deckGlow} fill="url(#csh-pool)" />
              <image
                href={href('/brand/tls-mark.png')}
                x="-38"
                y="-38"
                width="76"
                height="76"
                transform={`matrix(${r1(COS * 1000) / 1000} 0.5 ${-r1(COS * 1000) / 1000} 0.5 ${HO[0]} ${HO[1] - 36})`}
              />
            </g>

            {
              sats.filter((s) => !s.back).map((s) => (
                <g class="cs-sat" style={`--i: ${s.i}`}>
                  <polygon class="cs-sat-l" points={s.shape.left} />
                  <polygon class="cs-sat-r" points={s.shape.right} />
                  <polygon class="cs-sat-top" points={s.shape.top} />
                  <path class="cs-stem" d={s.stem} />
                </g>
              ))
            }

            <rect class="cs-beam" x="357" y="236" width="6" height="56" fill="url(#csh-beam)" />
            <g class="cs-shield" transform="translate(360 100) scale(0.9)">
              <path class="cs-shield-glow" d={SHIELD} filter="url(#csh-soft)" />
              <path class="cs-shield-body" d={SHIELD} fill="url(#csh-shield)" stroke="url(#csh-shield-line)" />
              <path class="cs-shield-inner" d={SHIELD} transform="translate(0 21) scale(0.72)" />
              <path class="cs-shield-check" d={CHECK} />
            </g>
          </svg>
          <ul class="cs-sat-tags" aria-label="What your business depends on" data-float="1">
            {
              sats.map((s) => (
                <li style={`--x: ${s.x}%; --y: ${s.y}%; --i: ${s.i}`}>
                  <span class="cs-glyph cs-glyph--sm" aria-hidden="true">
                    <Icon name={s.icon} size={16} />
                  </span>
                  {s.label}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
    <div class="wrap">
      <ul class="cs-benefits" data-reveal="stagger" aria-label="How we work">
        {
          benefits.map((b) => (
            <li style={`--c: ${tone[b.c]}`}>
              <span class="cs-glyph" aria-hidden="true">
                <Icon name={b.icon} size={20} />
              </span>
              <span>
                <strong>{b.title}</strong>
                <span>{b.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 2. Why cyber security matters -->
  <section class="section cs-why">
    <svg class="cs-waves cs-why-waves" viewBox="0 0 1440 360" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="csw-wave" x1="0" x2="1">
          <stop offset="0" stop-color="#D94040" stop-opacity="0.5" />
          <stop offset="0.5" stop-color="#873662" stop-opacity="0.15" />
          <stop offset="1" stop-color="#1288CF" stop-opacity="0.5" />
        </linearGradient>
      </defs>
      {waves(9).map((d) => <path d={d} stroke="url(#csw-wave)" />)}
    </svg>
    <div class="wrap cs-why-grid">
      <SectionHeading
        eyebrow="Why Cyber Security Matters"
        title="A stronger business starts with a stronger "
        accent="security foundation."
        lead="Cyber threats can disrupt operations, damage reputation and create significant financial and compliance risks. A proactive security strategy helps you stay resilient and focused on what matters most — your business."
      />
      <div class="cs-outcomes" data-draw>
        <svg class="cs-outcome-links" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {outcomes.map((o) => <path class="draw-path" d={o.link} style={`--c: ${tone[o.c]}`} />)}
        </svg>
        <ul class="cs-outcome-list">
          {
            outcomes.map((o) => (
              <li data-draw-mark style={`--c: ${tone[o.c]}`}>
                <div class="cs-outcome ix-card ix-card--quiet">
                  <span class="cs-tile" aria-hidden="true">
                    <Icon name={o.icon} size={22} />
                  </span>
                  <h3>{o.title}</h3>
                  <p>{o.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="cs-core" data-draw-mark aria-hidden="true">
          <span>
            <Icon name="briefcase" size={22} />
            Your business
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Our approach: people, process, technology -->
  <section class="section cs-ppt">
    <div class="wrap cs-ppt-grid">
      <figure class="cs-venn" data-converge aria-hidden="true">
        <svg viewBox="0 0 460 430">
          <defs>
            <linearGradient id="csp-core" x1="0" x2="1" y1="0" y2="1">
              <stop offset="0" stop-color="#D94040" />
              <stop offset="0.5" stop-color="#873662" />
              <stop offset="1" stop-color="#1288CF" />
            </linearGradient>
          </defs>
          {
            pillars.map((p) => (
              <g class="cs-circle" data-k={p.k} data-dx={p.dx} data-dy={p.dy} style={`--c: ${tone[p.c]}`}>
                <circle cx={p.cx} cy={p.cy} r="116" />
                <text x={p.lx} y={p.ly}>
                  {p.title}
                </text>
              </g>
            ))
          }
          <g class="cs-venn-core">
            <circle cx="230" cy="229" r="44" />
            <text x="230" y="233">Resilience</text>
          </g>
        </svg>
      </figure>
      <div>
        <SectionHeading
          eyebrow="Our Approach"
          title="Security is not just "
          accent="technology."
          lead="Strong security comes from people, processes and technology working together. We look at all three, so protection fits how your business actually runs."
        />
        <ul class="cs-pillars" data-reveal="stagger">
          {
            pillars.map((p) => (
              <li data-k={p.k} style={`--c: ${tone[p.c]}`}>
                <span class="cs-glyph cs-glyph--soft" aria-hidden="true">
                  <Icon name={p.icon} size={20} />
                </span>
                <div>
                  <h3>{p.title}</h3>
                  <p>{p.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. Security at every layer (signature: the stack builds with the scroll) -->
  <section class="cs-layers" data-layers aria-labelledby="cs-layers-title">
    <div class="wrap cs-layers-grid">
      <div class="cs-layers-intro section-heading" data-reveal="">
        <Eyebrow label="Security at Every Layer" />
        <h2 id="cs-layers-title">A comprehensive approach to <span class="accent">cybersecurity.</span></h2>
        <p class="lead">
          We help you strengthen security across your people, processes and technology — from risk management and access control to threat detection and incident
          response.
        </p>
      </div>

      <div class="cs-stage">
        <div class="cs-stack">
          <svg viewBox="0 0 900 680" aria-hidden="true">
            <defs>
              <radialGradient id="csl-floor">
                <stop offset="0" stop-color="#1288CF" stop-opacity="0.32" />
                <stop offset="0.6" stop-color="#873662" stop-opacity="0.12" />
                <stop offset="1" stop-color="#873662" stop-opacity="0" />
              </radialGradient>
              <linearGradient id="csl-beam" x1="0" y1="1" x2="0" y2="0">
                <stop offset="0" stop-color="#ff7a7a" stop-opacity="0.2" />
                <stop offset="0.5" stop-color="#b98cff" stop-opacity="0.85" />
                <stop offset="1" stop-color="#8fd0ff" stop-opacity="1" />
              </linearGradient>
              <linearGradient id="csl-shield" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#2a6fc0" stop-opacity="0.6" />
                <stop offset="1" stop-color="#0b1a3a" stop-opacity="0.9" />
              </linearGradient>
              <linearGradient id="csl-shield-line" x1="0" y1="1" x2="1" y2="0">
                <stop offset="0" stop-color="#ff6b6b" />
                <stop offset="0.5" stop-color="#b98cff" />
                <stop offset="1" stop-color="#8fd0ff" />
              </linearGradient>
              <radialGradient id="csl-halo">
                <stop offset="0" stop-color="#8fd0ff" stop-opacity="0.55" />
                <stop offset="1" stop-color="#8fd0ff" stop-opacity="0" />
              </radialGradient>
              <filter id="csl-soft" x="-60%" y="-60%" width="220%" height="220%"><feGaussianBlur stdDeviation="12" /></filter>
            </defs>
            <ellipse {...layerFloor} fill="url(#csl-floor)" />
            <g class="cs-base">
              <polygon class="cs-base-l" points={layerBase.left} />
              <polygon class="cs-base-r" points={layerBase.right} />
              <polygon class="cs-base-top" points={layerBase.top} />
              <polygon class="cs-base-inset" points={layerBase.inset} />
            </g>
            <g class="cs-beam-l">
              <rect x="438" y="248" width="24" height="257" fill="url(#csl-beam)" filter="url(#csl-soft)" opacity="0.7" />
              <rect x="448" y="248" width="4" height="257" fill="url(#csl-beam)" />
            </g>
            {
              layers.map((l) => (
                <>
                  <polygon class="cs-ghost" points={l.shape.top} />
                  <g class="cs-slab" data-k={l.k} style={`--c: ${l.c}`}>
                    <polygon class="cs-slab-l" points={l.shape.left} />
                    <polygon class="cs-slab-r" points={l.shape.right} />
                    <polygon class="cs-slab-top" points={l.shape.top} />
                    <polygon class="cs-slab-inset" points={l.shape.inset} />
                    <path class="cs-slab-edge" d={l.shape.edge} />
                  </g>
                </>
              ))
            }
            {
              layers.map((l) => (
                <g class="cs-wire" data-k={l.k} style={`--c: ${l.c}`}>
                  <path class="cs-wire-line" d={l.link} />
                  <circle cx={l.corner[0]} cy={l.corner[1]} r="3.5" />
                </g>
              ))
            }
            <g class="cs-crown">
              <ellipse class="cs-halo" {...layerHalo} fill="url(#csl-halo)" />
              <g transform="translate(450 102) scale(0.95)">
                <path class="cs-crown-glow" d={SHIELD} filter="url(#csl-soft)" />
                <path class="cs-crown-body" d={SHIELD} fill="url(#csl-shield)" stroke="url(#csl-shield-line)" />
                <path class="cs-shield-inner" d={SHIELD} transform="translate(0 21) scale(0.72)" />
                <path class="cs-shield-check" d={CHECK} />
              </g>
            </g>
          </svg>
          <ul class="cs-tags" aria-hidden="true">
            {
              layers.map((l) => (
                <li class:list={['cs-tag', { 'is-right': !l.left }]} data-k={l.k} style={`--c: ${l.c}; --x: ${l.x}%; --y: ${l.y}%`}>
                  <i />
                  {l.title}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <ol class="cs-layer-steps">
        {
          layers.map((l) => (
            <li data-k={l.k} style={`--c: ${l.c}`}>
              <span class="cs-layer-num" aria-hidden="true">
                <Icon name={l.icon} size={20} />
              </span>
              <span class="cs-layer-count" aria-hidden="true">
                Layer {l.k + 1} of {layers.length}
              </span>
              <h3>{l.title}</h3>
              <p>{l.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="cs-layers-close" data-reveal="">
        <p>Security is strongest when every layer works together.</p>
        <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
      </div>
    </div>
  </section>

  <!-- 5. How we help: four stages, one continuous loop -->
  <section class="section cs-help">
    <div class="wrap">
      <div class="cs-split-head">
        <SectionHeading
          eyebrow="How We Help"
          title="End-to-end cybersecurity support "
          accent="for your business."
          lead="We take a practical, risk-based approach to help you build a stronger security posture across people, processes and technology."
        />
        <Button href={cta.primary.href} variant="secondary" arrow>{cta.primary.label}</Button>
      </div>
      <div class="cs-cycle" data-progress>
        <figure class="cs-ring">
          <svg viewBox="0 0 400 400" aria-hidden="true">
            <defs>
              <linearGradient id="csc-ring" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#D94040" />
                <stop offset="0.45" stop-color="#1288CF" />
                <stop offset="0.75" stop-color="#7c5cf0" />
                <stop offset="1" stop-color="#16a34a" />
              </linearGradient>
              <marker id="csc-arrow" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M1 1 L8 5 L1 9" fill="none" stroke="#94A3B8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </marker>
            </defs>
            <circle class="cs-ring-track" cx="200" cy="200" r="150" />
            <path class="cs-ring-loop" d="M50 200 A150 150 0 0 1 188 50.5" marker-end="url(#csc-arrow)" />
            <path class="cs-ring-fill" d="M200 50 A150 150 0 1 1 199.99 50" pathLength="1" />
          </svg>
          {
            stages.map((s, i) => (
              <span class="cs-ring-node" data-n={i} style={`--c: ${tone[s.c]}; --x: ${s.x}%; --y: ${s.y}%`} aria-hidden="true">
                <Icon name={s.icon} size={24} />
              </span>
            ))
          }
          <figcaption class="cs-ring-core">
            <strong>Security doesn't stop at go-live.</strong>
            <span>Each stage feeds the next, so your protection keeps pace as your business grows.</span>
          </figcaption>
        </figure>
        <ol class="cs-stages">
          {
            stages.map((s, i) => (
              <li data-step style={`--c: ${tone[s.c]}`}>
                <span class="cs-tile" aria-hidden="true">
                  <Icon name={s.icon} size={22} />
                </span>
                <div>
                  <span class="cs-stage-num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- 6. FAQ -->
  <section class="section cs-faq">
    <div class="wrap cs-faq-grid">
      <div>
        <SectionHeading
          eyebrow="Frequently Asked Questions"
          title="Common questions about "
          accent="cyber security."
          lead="Quick answers about our approach, the process and how we can help your business."
        />
        <aside class="cs-ask" data-reveal="">
          <span class="cs-glyph" style="--c: #4fb6ff" aria-hidden="true"><Icon name="message" size={20} /></span>
          <div>
            <h3>Still have questions?</h3>
            <p>Talk to our team about your business and where security fits.</p>
            <div class="cs-actions">
              <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
              <Button href={cta.email.href} variant="ghost-light" external>{cta.email.label}</Button>
            </div>
          </div>
        </aside>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>

  <!-- 7. Final CTA -->
  <section class="cs-final">
    <svg class="cs-waves" viewBox="0 0 1440 360" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="csf-wave" x1="0" x2="1">
          <stop offset="0" stop-color="#1288CF" stop-opacity="0" />
          <stop offset="0.45" stop-color="#1288CF" stop-opacity="0.55" />
          <stop offset="1" stop-color="#D94040" stop-opacity="0.9" />
        </linearGradient>
      </defs>
      {waves(9).map((d) => <path d={d} stroke="url(#csf-wave)" />)}
    </svg>
    <div class="wrap cs-final-grid">
      <div data-reveal="">
        <Eyebrow label="Let's Solve What Matters" />
        <h2>Let's protect what your business <span class="accent">depends on.</span></h2>
      </div>
      <div class="cs-final-cta" data-reveal="">
        <p>Tell us how your business runs and what concerns you. We'll help you understand the risks, prioritize what matters and plan practical next steps.</p>
        <div class="cs-actions">
          <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
          <Button href={cta.email.href} variant="ghost-light" external>{cta.email.label}</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(:root) {
    --cs-navy: #0a0f1d;
    --cs-violet: #7c5cf0;
    --cs-green: #16a34a;
    --cs-on-dark: #c7cedc;
  }
  .accent {
    color: var(--red);
  }
  h2 {
    font-size: clamp(2rem, 1.35rem + 2.1vw, 2.85rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .cs-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--gap-actions);
  }
  /* Small glass icon chip, tinted by --c. */
  .cs-glyph {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: var(--c, #fff);
    background: color-mix(in srgb, var(--c, #fff) 14%, rgba(255, 255, 255, 0.04));
    border: 1px solid color-mix(in srgb, var(--c, #fff) 30%, transparent);
    box-shadow: 0 8px 22px -12px var(--c, transparent);
  }
  .cs-glyph--soft {
    background: color-mix(in srgb, var(--c) 10%, #fff);
    border-color: color-mix(in srgb, var(--c) 18%, transparent);
  }
  .cs-glyph--sm {
    width: 28px;
    height: 28px;
    border-radius: 9px;
  }
  /* Solid icon tile for cards. */
  .cs-tile {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(145deg, color-mix(in srgb, var(--c) 82%, #fff), var(--c));
    box-shadow: 0 12px 24px -12px var(--c);
    transition: transform var(--ix-base) var(--ix-ease);
  }
  /* The page's motif: flowing red/blue lines. */
  .cs-waves {
    position: absolute;
    left: 0;
    width: 100%;
    z-index: -1;
    pointer-events: none;
  }
  .cs-waves path {
    fill: none;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    .cs-waves {
      animation: cs-drift 22s ease-in-out infinite alternate;
    }
  }
  @keyframes cs-drift {
    to {
      transform: translateX(-3%) scaleY(1.06);
    }
  }

  /* Dark sections share one palette: headings white, copy soft gray. */
  .cs-hero,
  .cs-layers,
  .cs-final {
    color: #fff;
  }
  .cs-hero h1,
  .cs-layers h2,
  .cs-final h2 {
    color: #fff;
  }
  .cs-hero :global(.eyebrow),
  .cs-layers :global(.eyebrow),
  .cs-final :global(.eyebrow) {
    color: var(--cs-on-dark);
  }

  /* ---------- 1. Hero ---------- */
  .cs-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(2rem, 4vw, 3rem) clamp(1.75rem, 3vw, 2.5rem);
    background:
      radial-gradient(42% 60% at 6% 22%, rgba(217, 64, 64, 0.16), transparent 70%),
      radial-gradient(46% 64% at 76% 44%, rgba(18, 136, 207, 0.18), transparent 72%),
      var(--cs-navy);
  }
  .cs-hero-waves {
    bottom: -40px;
    height: 240px;
    opacity: 0.7;
  }
  .cs-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: center;
    min-height: clamp(500px, 40vw, 600px);
  }
  .cs-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
