  }
  .cs-crumbs a {
    color: #9fd3f5;
    text-decoration: none;
  }
  .cs-crumbs a:hover {
    text-decoration: underline;
  }
  .cs-hero h1 {
    font-size: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .cs-hero h1 .accent {
    display: block;
  }
  .cs-lede {
    margin-top: var(--gap-lead);
    max-width: 44ch;
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--cs-on-dark);
  }
  .cs-hero-art {
    position: relative;
    margin-right: calc(-1 * clamp(0px, 4vw, 3rem));
  }
  .cs-hero-scene {
    position: relative;
    aspect-ratio: 600 / 444;
  }
  .cs-hero-scene svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .cs-grid path {
    fill: none;
    stroke: rgba(140, 175, 235, 0.13);
    stroke-width: 1;
  }
  .cs-perimeter {
    fill: none;
    stroke: url(#csh-ring);
    stroke-width: 1.6;
    opacity: 0.7;
  }
  .cs-ring-inner {
    fill: rgba(18, 136, 207, 0.05);
    stroke: rgba(255, 255, 255, 0.12);
    stroke-dasharray: 2 7;
  }
  .cs-sweep {
    fill: none;
    stroke: #a6dcff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 7 93;
    opacity: 0;
  }
  .cs-link-base {
    stroke: rgba(110, 180, 255, 0.28);
    stroke-width: 1.4;
  }
  .cs-pulse {
    stroke: #a6dcff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 12 88;
    opacity: 0;
  }
  .cs-sat-top {
    fill: rgba(30, 90, 170, 0.55);
    stroke: rgba(150, 205, 255, 0.85);
    stroke-width: 1.2;
  }
  .cs-sat-l {
    fill: #10244a;
  }
  .cs-sat-r {
    fill: #0a1834;
  }
  .cs-stem {
    stroke: rgba(150, 205, 255, 0.45);
    stroke-width: 1.2;
    stroke-dasharray: 2 3;
  }
  .cs-plat-l {
    fill: url(#csh-face-l);
  }
  .cs-plat-r {
    fill: url(#csh-face-r);
  }
  .cs-plat-top {
    fill: #15244b;
    stroke: rgba(255, 255, 255, 0.1);
  }
  .cs-plat-inset {
    fill: rgba(18, 136, 207, 0.12);
    stroke: rgba(160, 210, 255, 0.35);
    stroke-width: 1;
  }
  .cs-plat-edge {
    fill: none;
    stroke: url(#csh-edge);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .cs-beam {
    opacity: 0.9;
  }
  .cs-shield-glow {
    fill: none;
    stroke: #3aa0ff;
    stroke-width: 14;
    opacity: 0.55;
  }
  .cs-shield-body,
  .cs-crown-body {
    stroke-width: 2.6;
    stroke-linejoin: round;
  }
  .cs-shield-inner {
    fill: none;
    stroke: rgba(170, 220, 255, 0.45);
    stroke-width: 1.6;
  }
  .cs-shield-check {
    fill: none;
    stroke: #fff;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cs-sat-tags {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }
  .cs-sat-tags li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -100%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem 0.35rem 0.35rem;
    border-radius: 12px;
    background: rgba(12, 20, 42, 0.78);
    border: 1px solid rgba(120, 185, 255, 0.3);
    box-shadow: 0 12px 30px -14px rgba(18, 136, 207, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: clamp(0.72rem, 0.6rem + 0.35vw, 0.86rem);
    white-space: nowrap;
    color: #eef3ff;
    --c: #6cc0ff;
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    .cs-hero-art {
      animation: cs-rise 1300ms var(--ix-ease) 60ms backwards;
    }
    .cs-sat {
      animation: cs-pop 700ms var(--ix-ease) calc(500ms + var(--i) * 110ms) backwards;
    }
    .cs-sat-tags li {
      animation: cs-fade 700ms var(--ix-ease) calc(800ms + var(--i) * 120ms) backwards;
    }
    .cs-shield {
      animation: cs-fade 1100ms var(--ix-ease) 350ms backwards;
    }
    .cs-shield-glow {
      animation: cs-breathe 5s ease-in-out 1.5s infinite alternate;
    }
    .cs-sweep {
      opacity: 0.9;
      animation: cs-orbit 16s linear infinite;
    }
    .cs-pulse {
      opacity: 1;
      animation: cs-flow 3.2s linear calc(var(--i) * 0.8s) infinite;
    }
  }
  @keyframes cs-rise {
    from {
      opacity: 0;
      transform: translateY(26px) scale(0.98);
    }
  }
  @keyframes cs-pop {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }
  }
  @keyframes cs-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes cs-breathe {
    from {
      opacity: 0.3;
    }
    to {
      opacity: 0.75;
    }
  }
  @keyframes cs-orbit {
    to {
      stroke-dashoffset: -100;
    }
  }
  @keyframes cs-flow {
    from {
      stroke-dashoffset: 12;
    }
    to {
      stroke-dashoffset: -100;
    }
  }
  .cs-benefits {
    list-style: none;
    margin: clamp(1rem, 2vw, 1.5rem) 0 0;
    padding: 1rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    border-radius: var(--radius-lg);
    background: rgba(10, 15, 29, 0.66);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .cs-benefits li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.35rem 0.75rem;
  }
  .cs-benefits li + li {
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }
  .cs-benefits strong {
    display: block;
    font-family: var(--font-head);
    font-size: 0.95rem;
    line-height: 1.3;
    color: #fff;
  }
  .cs-benefits li > span:last-child > span {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.86rem;
    line-height: 1.4;
    color: var(--cs-on-dark);
  }
  @media (max-width: 1100px) {
