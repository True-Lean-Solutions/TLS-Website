---
import { SOLUTION_HERO, preloadFor } from '../../data/images';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import SolutionHero from '../../components/SolutionHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Button from '../../components/Button.astro';
import { cta, href } from '../../data/site';
import { moreSolutions, aiProducts } from '../../data/services';

// Meta — source: TLS: Website Pages (2026-09-27), 1w1w7ClLF7Ts7M-FSFJeopTP6Z_13FhXn_q9Qxy2hlT0
// Title and description: SEO brief T2.3 (2026-11-11), drafted from this page's own copy; pending Hemang's approval.
const title = 'Business Technology Solutions | True Lean Solutions';
const description =
  'AI and automation, custom software, system integration and technical talent: practical tools for real business problems. Not sure which? We start there.';

// Copy — source: Services - Overview (2026-09-27), 1adf8kbl7pTD1AGhmQZYNl4e9vMiNvL4QTugmMiteBBg
const services = [
  {
    title: 'AI & Automation',
    href: '/services/enterprise-ai/',
    icon: 'ai' as const,
    accent: 'red' as const,
    blurb:
      'Give your team AI that works on your business data — with access controls, audit logs, and no public exposure.',
  },
  {
    title: 'Custom Software',
    href: '/services/software/',
    icon: 'software' as const,
    accent: 'blue' as const,
    blurb:
      'Web applications, internal tools, customer portals, and platforms designed specifically for your business — your workflows, your data, your customers.',
  },
  {
    title: 'System Integration',
    href: '/services/integrations/',
    icon: 'integration' as const,
    accent: 'plum' as const,
    blurb:
      'Connect your disconnected tools and platforms to create seamless workflows, eliminate manual handoffs, and give you real-time visibility across your business.',
  },
  {
    title: 'Technical Talent',
    href: '/services/technical-talent/',
    icon: 'talent' as const,
    accent: 'red' as const,
    blurb:
      'Source and place high-quality technology talent sized right for small businesses — no enterprise overhead, just the right person for the role at the right time.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  path="/services/"
  preloadImage={preloadFor(SOLUTION_HERO.src, SOLUTION_HERO.sizes)}
  breadcrumbs={[{ name: 'Solutions', path: '/services/' }]}
>
  <!-- Cinematic hero (SolutionHero). Copy — Hemang (2026-09-28), from Mack's
       mock-up in SOLUTIONS (Drive 16e-mNdSFPZwzHvqeJhGRmbcycAHLEXeR); CTA per
       v2.3 §09. -->
  <SolutionHero
    size="xl"
    eyebrow="Technology that turns"
    title="From Ideas to"
    highlight="Real Impact."
    description="We help organizations strategize, build, integrate and optimize technology to operate smarter and achieve greater value."
    primaryCta={cta.primary}
  />

  <section class="section sol-intro">
    <div class="wrap">
      <SectionHeading
        eyebrow="Our Solutions"
        title="Practical tools for "
        accent="real business problems."
        lead="Each solution below is a tool for a specific business problem — and if you're not sure which one you need, that's where we start."
      />
      <div class="cards" data-reveal="stagger">
        {[...services, ...moreSolutions].map((s) => <ServiceCard {...s} />)}
      </div>
      <p class="sol-products">
        Featured AI Solutions:
        {aiProducts.map((p, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={href(p.href)}>{p.title}</a>
          </>
        ))}
      </p>
    </div>
  </section>

  <CtaBand
    booking
    eyebrow="Let's solve what matters"
    heading="Not sure where to "
    accent="start?"
    text="Most businesses we work with know something isn't working but aren't sure which lever to pull first. Book a free strategy call and we'll help you figure it out."
  >
    <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
    <Button href={cta.email.href} variant="secondary" external>{cta.email.label}</Button>
  </CtaBand>
</BaseLayout>

<style>
  /* The two AI products (brief T2.5): a quiet line under the grid. */
  .sol-products {
    margin-top: 1.75rem;
    text-align: center;
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .sol-products a {
    color: var(--blue-text);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  .sol-products a:hover {
    color: var(--red-text);
  }

  /* The intro keeps its page-title size now that the hero holds the h1. */
  .sol-intro :global(.section-heading h2) {
    font-size: var(--step-5);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  /* All eight solutions at once: four across on desktop, two on tablets,
     one on phones. */
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }
  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Horizontal sequence (desktop, when the scene fits the screen; the scroll
     layer sets .is-track and drives the row with vertical scroll): the same
     eight cards, in the same order, as one row that runs off the right edge.
     Tighter section padding so the pinned scene fits below the header. */
  .sol-intro:global(.is-track) {
    overflow: clip;
    padding-block: var(--space-5);
  }
  .sol-intro:global(.is-track) .cards {
    display: flex;
    align-items: stretch;
    gap: 1.5rem;
  }
  .sol-intro:global(.is-track) .cards > :global(*) {
    flex: 0 0 clamp(300px, 26vw, 370px);
  }
  @media (max-width: 640px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
