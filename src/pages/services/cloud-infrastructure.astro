---
/**
 * Cloud & Infrastructure (Hemang, 2026-11-18: service portfolio expansion).
 * Delivered with strategic partners under the TLS brand; partners are never
 * named. Capability lines are limited to what the partners advertise; no
 * uptime, availability or performance figure is stated. Unconfirmed items
 * (high-availability architecture as a named service, specific LAN/WAN/Wi-Fi
 * offerings) are left out: see docs/decisions.md 2026-11-18.
 *
 * Technical depth (Hemang's brief after customer feedback, 2026-11-18): the
 * capability lists say more about how the work is done, and five sections
 * were added between the existing ones: network engineering, security by
 * design (with the recovery timeline), technologies, illustrative use cases
 * and an FAQ. Existing sections, art and motion are unchanged. Named
 * technologies come from src/data/tech.ts, which shows confirmed ones only;
 * the use cases are labeled illustrative because no verified infrastructure
 * project exists yet. Evidence for every line: docs/capability-matrix.md.
 *
 * Hero: the foundation builds in layers — workplace, then network, then
 * cloud — then a server workload migrates to the cloud and a continuity copy
 * is made. One cycle loops while on screen (sequence.ts). Reduced motion / no
 * JS: the finished picture.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import InfoCard from '../../components/InfoCard.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import StackScene from '../../components/service/StackScene.astro';
import ScrollBand from '../../components/service/ScrollBand.astro';
import Journey, { type JourneyStep } from '../../components/service/Journey.astro';
import JourneyScene from '../../components/service/JourneyScene.astro';
import FlowMap, { type FlowItem, type FlowStage } from '../../components/service/FlowMap.astro';
import CtaBand from '../../components/CtaBand.astro';
import CapabilityGroups, { type CapabilityGroup } from '../../components/service/CapabilityGroups.astro';
import EngagementModels, { type EngagementModel } from '../../components/service/EngagementModels.astro';
import OutcomeList, { type Outcome } from '../../components/service/OutcomeList.astro';
import ConnectedServices from '../../components/service/ConnectedServices.astro';
import DeepDive, { type SpecGroup } from '../../components/service/DeepDive.astro';
import NetworkScene from '../../components/service/NetworkScene.astro';
import SecurityLayersScene from '../../components/service/SecurityLayersScene.astro';
import RecoveryBlock from '../../components/service/RecoveryBlock.astro';
import ScopeNote from '../../components/service/ScopeNote.astro';
import TechStack from '../../components/service/TechStack.astro';
import UseCases, { type UseCase } from '../../components/service/UseCases.astro';
import FaqList from '../../components/FaqList.astro';
import { cta, site } from '../../data/site';

// Draft copy (2026-11-18), pending Hemang's approval.
const title = 'Cloud & IT Infrastructure Services | True Lean Solutions';
const description =
  'Cloud migration and management, network design and implementation, structured cabling, office moves, VoIP and business continuity, built as one foundation.';
// v2.3 §09, "Implementation" context.
const ctaLabel = 'Discuss Your Implementation Need';


const challenges = [
  { title: 'Your infrastructure grew by accident', text: 'A server here, a second office there, a cloud subscription someone signed up for. It mostly works, but nobody has the whole picture.' },
  { title: "The network can't keep up", text: 'Slow connections, dead spots and dropped calls cost time that nobody tracks, and the workarounds become the way things are done.' },
  { title: 'Moving to the cloud feels risky', text: "You know some systems belong in the cloud, just not which ones, in what order, or how to move them without disrupting work." },
  { title: 'Change would expose the gaps', text: 'Opening an office, relocating or losing a key system would show how much depends on setups nobody documented.' },
];

const groups: CapabilityGroup[] = [
  {
    title: 'Cloud',
    line: 'Cloud environments designed around what you actually run, with identity, networking and recovery planned in, and moved there without disrupting the business.',
    icon: 'cloud',
    accent: 'red',
    art: 'cloud',
    items: [
      'Cloud readiness assessment and architecture',
      'Cloud migration and deployment, planned around dependencies',
      'Managed cloud on AWS, Microsoft Azure and Google Cloud',
      'Compute, storage, databases and virtual networks',
      'Hybrid, private and public cloud',
      'Virtualization and virtual desktops',
    ],
  },
  {
    title: 'Network and servers',
    line: 'Dependable, segmented connections between your people, your places and your systems.',
    icon: 'integration',
    accent: 'blue',
    art: 'network',
    items: [
      'Network design and implementation: LAN, WAN and Wi-Fi',
      'Routing, switching and network segmentation (VLANs)',
      'Firewalls, site-to-site VPN and secure remote access',
      'Internet connectivity planning, with failover and SD-WAN',
      'Network refresh and upgrades',
      'Server configuration, deployment and virtualization',
    ],
  },
  {
    title: 'Workplace infrastructure',
    line: 'The physical side of IT, planned and documented instead of improvised.',
    icon: 'building',
    accent: 'plum',
    art: 'workplace',
    items: [
      'Structured cabling, racks and patch panels',
      'Wireless access point placement',
      'Office IT setup, relocation and cutover planning',
      'Data center relocation and colocation',
      'Hardware procurement and lifecycle planning',
      'Network diagrams and technical documentation',
    ],
  },
  {
    title: 'Communications and continuity',
    line: 'Phones that move with your people, and a tested plan for the day something fails.',
    icon: 'phone',
    accent: 'red',
    art: 'comms',
    items: [
      'VoIP and unified communications',
      'Microsoft Teams phones, call queues and conferencing',
      'Cloud and off-site backup',
      'Recovery testing and failover planning',
      'Recovery targets (RTO and RPO) agreed for each system',
      'Business continuity planning',
    ],
  },
];

/* Network engineering (2026-11-18). */
const network: SpecGroup[] = [
  {
    title: 'Network architecture',
    why: 'A layout planned around your sites, people and applications, instead of equipment added as needs came up.',
    items: ['LAN and WAN design', 'Multi-location connectivity', 'Routing and switching', 'Network topology planning and diagrams', 'SD-WAN where it fits'],
  },
  {
    title: 'Secure connectivity',
    why: 'Connections are encrypted where they leave the building and limited to what each person or device needs.',
    items: ['Site-to-site VPN between offices', 'Secure remote access for staff', 'Firewall configuration', 'VLANs and network segmentation', 'Separate staff and guest networks'],
  },
  {
    title: 'Performance and availability',
    why: 'Enough coverage and capacity for a normal day, and a fallback for a bad one.',
    items: ['Wireless coverage planning', 'Capacity planning', 'Quality of Service for voice and video', 'Redundant connectivity and internet failover'],
  },
  {
    title: 'Network management',
    why: 'A network stays dependable when its records are current and changes are planned.',
    items: ['Network monitoring', 'Configuration documentation', 'Device lifecycle management', 'Planned upgrades', 'Troubleshooting and optimization'],
  },
];

/* Security by design (2026-11-18): five layers, matching the diagram. */
const security: SpecGroup[] = [
  {
    title: '1. Identity and access',
    why: 'Access is designed first: who can sign in, from where, and to what.',
    items: ['Multi-factor authentication and single sign-on', 'Role-based, least-privilege access', 'Conditional access policies', 'Access reviews, including administrator accounts'],
  },
  {
    title: '2. Network security',
    why: 'The network decides what can talk to what, and keeps the rest apart.',
    items: ['Firewall policies', 'Intrusion prevention', 'Network segmentation', 'VPN and secure remote access'],
  },
  {
    title: '3. Cloud and applications',
    why: 'A cloud platform is as secure as its configuration. The defaults are a starting point.',
    items: ['Security configuration reviews and hardening', 'Private networking for workloads', 'Encryption at rest and in transit', 'Cloud logging and monitoring'],
  },
  {
    title: '4. Servers and workloads',
    why: 'Systems that are patched and locked down give an attacker less to work with.',
    items: ['Operating system hardening', 'Patch management', 'Vulnerability assessments', 'Controlled administrative access'],
  },
];

/* Illustrative use cases (2026-11-18): scenarios, not client projects. */
const useCases: UseCase[] = [
  {
    title: 'Multi-location network modernization',
    challenge: 'Several offices, each with a network that grew independently. Connections between sites are unreliable, and nobody can see the whole picture.',
    approach: ['Topology assessment', 'Routing and switching redesign', 'VLAN segmentation', 'Site-to-site VPN', 'Wireless optimization', 'Redundant links', 'Central monitoring'],
    aim: 'Consistent connectivity between sites, a network you can see into, and room to add the next location.',
    icon: 'integration',
  },
  {
    title: 'Cloud migration and modernization',
    challenge: 'On-site servers are close to the end of their life, and adding capacity means buying more hardware.',
    approach: ['Workload assessment', 'Dependency mapping', 'Cloud architecture', 'Identity and network security', 'Staged migration', 'Monitoring', 'Recovery planning'],
    aim: 'Capacity that grows with the business, a clearer view of what is running, and less reliance on aging hardware.',
    icon: 'cloud',
  },
  {
    title: 'Secure office infrastructure',
    challenge: 'A business is opening an office or moving to a new one, and everything has to work on the first morning.',
    approach: ['Structured cabling', 'Managed switches', 'Wireless access points', 'Firewall configuration', 'Network segmentation', 'Phones and conferencing', 'Documentation'],
    aim: 'An office that is ready on the first day, and a move that disrupts work as little as possible.',
    icon: 'building',
  },
  {
    title: 'Infrastructure resilience',
    challenge: 'One internet line, one server and backups that have never been restored. A single failure would stop the business.',
    approach: ['Risk assessment', 'Redundant connectivity', 'Backup modernization', 'Failover planning', 'Restore testing'],
    aim: 'Fewer single points of failure, and a tested expectation of how long recovery takes.',
    icon: 'shield',
  },
];

/* Technical FAQ (2026-11-18). Answers restate what the page already says; no new commitments. */
const faqs: { q: string; a: string[] }[] = [
  {
    q: 'Which cloud platforms do you support?',
    a: ['We work with Amazon Web Services (AWS), Microsoft Azure and Google Cloud, in public, private and hybrid setups. We recommend a platform for each workload based on what you already run, how it has to be secured and operated, and your budget.'],
  },
  {
    q: 'Can you work with our existing network and equipment?',
    a: ['Yes. Every engagement starts by mapping what you have. Where existing equipment is sound we design around it, and plan a refresh for the parts that are holding you back, instead of replacing everything.'],
  },
  {
    q: 'Can you connect multiple offices and remote staff?',
    a: ['Yes. Multi-location design is part of network engineering: site-to-site VPN or SD-WAN between offices, secure remote access for staff, and the same segmentation rules at every site.'],
  },
  {
    q: 'How do you approach cloud and network security?',
    a: ['As part of the design, not as an add-on. Identity and access come first, then network controls, secure configuration, hardened and patched workloads, and data that is protected and recoverable. Security assessments, risk management and compliance support are covered by our Cybersecurity & Compliance service.'],
  },
  {
    q: 'How do you plan for outages?',
    a: [
      'We agree recovery targets for each important system: how much recent data you can afford to lose (RPO) and how quickly it has to be back (RTO). Backups, failover and redundant links are designed to meet those targets, then checked with restore tests.',
      'No plan can guarantee recovery in every situation, which is why the tests matter.',
    ],
  },
];

const accents = ['red', 'blue', 'plum'] as const;
const steps: JourneyStep[] = [
  { title: 'Map what you have', text: 'We document your current setup (locations, network, servers, cloud services) and how it all connects.', icon: 'search' },
  { title: 'Design the foundation', text: 'We design for where the business is going, then plan the order of work so nothing critical goes down.', icon: 'compass' },
  { title: 'Build and migrate', text: 'We install, configure and migrate in planned stages, with a rollback plan at each one.', icon: 'building' },
  { title: 'Document and hand over', text: 'You get a clear record of what was built, how it fits together and who to call.', icon: 'document' },
  { title: 'Run and improve', text: 'Ongoing management through Managed IT Services, or a clean handover to your own team.', icon: 'headset' },
];

/* Signature: from accumulated to designed (FlowMap). */
const flowIn: FlowItem[] = [
  { label: 'A server in a closet', icon: 'server' },
  { label: 'A patchwork network', icon: 'integration' },
  { label: 'An aging phone system', icon: 'phone' },
  { label: 'Scattered cloud apps', icon: 'cloud' },
  { label: 'Backups nobody has tested', icon: 'database' },
];
const flowStages: FlowStage[] = [
  { title: 'Map', sub: 'What you run and why', icon: 'search' },
  { title: 'Decide', sub: 'Keep, move or retire', icon: 'compass' },
  { title: 'Build', sub: 'In planned stages', icon: 'building' },
  { title: 'Run', sub: 'Monitored and maintained', icon: 'headset' },
];
const flowOut: FlowItem[] = [
  { label: 'Cloud environment', icon: 'cloud' },
  { label: 'Dependable network', icon: 'integration' },
  { label: 'Unified communications', icon: 'phone' },
  { label: 'Business continuity', icon: 'shield' },
];

const models: EngagementModel[] = [
  { title: 'Implementation projects', text: 'Networks, cabling, servers and office setup, scoped and delivered as a defined project.', fit: "you're building, moving or upgrading.", icon: 'building' },
  { title: 'Cloud migration', text: 'An assessment of what should move, then a staged migration planned around how your business works.', fit: 'systems need to move without stopping the business.', icon: 'cloud' },
  { title: 'Ongoing management', text: 'Your infrastructure monitored and maintained after it is built, as part of Managed IT Services.', fit: 'you want the foundation looked after, not just installed.', icon: 'headset' },
];

const outcomes: Outcome[] = [
  { title: 'A foundation you understand', text: 'Documented, so decisions are made on what you have instead of guesses.', icon: 'document' },
  { title: 'Room to grow', text: "Adding people, locations or systems doesn't mean starting over.", icon: 'rocket' },
  { title: 'Fewer disruptions', text: 'Planned changes instead of emergency fixes.', icon: 'shield' },
  { title: 'Work from anywhere', text: 'The same systems and phones in the office, at home or on the road.', icon: 'laptop' },
  { title: 'A plan for bad days', text: 'Backups and continuity planned before you need them.', icon: 'database' },
  { title: 'Clear choices about what runs where', text: 'Each system runs where it makes sense: in the cloud, on site, or both.', icon: 'compass' },
];
---

<BaseLayout title={title} description={description} path="/services/cloud-infrastructure/">
  <!-- 1. Hero: the cinematic scene (ServiceHero + StackScene) -->
  <ServiceHero
    name="Cloud & Infrastructure"
    title="A foundation that "
    accent="holds up as you grow."
    lede="Cloud environments, networks, connectivity and business communications, designed and built as one foundation, so the business on top of it can grow without starting over."
    ctaLabel={ctaLabel}
    hue="violet"
  >
    <StackScene />
  </ServiceHero>

  <!-- 1b. A band of capability chips, gliding with the scroll -->
  <ScrollBand
    items={[
      { label: 'Cloud migration', icon: 'cloud' },
      { label: 'Network design', icon: 'infrastructure' },
      { label: 'Structured cabling', icon: 'integration' },
      { label: 'VoIP', icon: 'phone' },
      { label: 'Virtual desktops', icon: 'monitor' },
      { label: 'Office moves', icon: 'building' },
      { label: 'Business continuity', icon: 'shield' },
      { label: 'Hybrid cloud', icon: 'server' },
    ]}
  />

  <!-- 2. Business challenges -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Sound Familiar?"
        title="Most infrastructure isn't designed. "
        accent="It accumulates."
        lead="That works until the business grows, moves or depends on something that fails."
      />
      <div class="cards-2" data-reveal="stagger">
        {challenges.map((c, i) => <InfoCard title={c.title} text={c.text} accent={accents[i % 3]} />)}
      </div>
    </div>
  </section>

  <!-- 2b. Signature: from accumulated to designed -->
  <FlowMap
    id="ci-flow"
    eyebrow="From Accumulated to Designed"
    title="Turn what you have into "
    accent="one foundation."
    lead="Most environments grew one decision at a time. We map what's there, decide what stays, moves or retires, and rebuild it as one design."
    columns={['What you have today', 'How we rebuild it', 'What you end up with']}
    inputs={flowIn}
    stages={flowStages}
    outputs={flowOut}
  />

  <!-- 3. Capabilities -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="What We Build and Look After"
        title="From the cloud down "
        accent="to the cabling."
        lead="One partner for the layers your business runs on, so they're planned to work together."
      />
      <CapabilityGroups groups={groups} />
    </div>
  </section>

  <!-- 3b. Network engineering (2026-11-18) -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Network Engineering"
        title="A network designed around "
        accent="how your business works."
        lead="Your network connects everything the business depends on: people, devices, applications, offices, cloud services and data. We treat it as an engineered system, designed and documented as a whole, rather than a collection of installed equipment."
      />
      <DeepDive groups={network}>
        <NetworkScene />
      </DeepDive>
    </div>
  </section>

  <!-- 3c. Security by design (2026-11-18) -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="Security by Design"
        title="Security belongs "
        accent="in the foundation."
        lead="Security added after the cloud and the network are built is expensive and full of gaps. We consider identity, networking, workload protection, data security and recovery while the foundation is being designed."
      />
      <DeepDive groups={security} flip>
        <SecurityLayersScene />
        <Fragment slot="after">
        <RecoveryBlock
          title="5. Data protection and recovery"
          why="A backup job that finishes is not proof that a system can be brought back. Recovery is planned around two numbers the business sets for each system, then tested."
          items={['Backup schedules set from the RPO', 'Off-site, access-controlled backups', 'Critical system dependencies mapped', 'Recovery priorities agreed in advance', 'Restore tests on a schedule', 'Documented recovery and failover procedures']}
        />
        <ScopeNote
          text="This is security built into the foundation. For security assessments, risk management and compliance support, see"
          links={[['/services/cyber-security/', 'Cybersecurity & Compliance']]}
        />
        </Fragment>
      </DeepDive>
    </div>
  </section>

  <!-- 4. How it works -->
  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="How It Works" title="Planned in order, " accent="built without surprises." />
      <Journey steps={steps}>
        <JourneyScene variant="cloud" />
      </Journey>
    </div>
  </section>

  <!-- 5. Engagement models -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="Ways to Work With Us"
        title="Build it, move it, "
        accent="or keep it running."
        lead="Most clients start with one project. Some keep us on to look after what we built."
      />
      <EngagementModels models={models} />
    </div>
  </section>

  <!-- 6. Outcomes -->
  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="What Changes" title="Infrastructure you can " accent="build a business on." />
      <OutcomeList outcomes={outcomes} />
    </div>
  </section>

  <!-- 6b. Technologies (2026-11-18): confirmed names only, from src/data/tech.ts -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="Technology"
        title="The right technology "
        accent="for the environment."
        lead="We choose technology against your requirements, what you already run, how it has to be secured and operated, your budget and where the business is going. Not every business needs the same stack."
      />
      <TechStack page="cloud" note="Running something that is not listed? Tell us what you have. We start from your existing environment, not from a preferred product." />
    </div>
  </section>

  <!-- 6c. Illustrative use cases (2026-11-18) -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Illustrative Infrastructure Use Cases"
        title="What infrastructure engineering looks like "
        accent="in practice."
        lead="Four common situations and how we would approach each one. These are illustrative scenarios, not client case studies: every environment is assessed before a design is proposed."
      />
      <UseCases cases={useCases} />
    </div>
  </section>

  <!-- 7. Connected services -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="Works Together With"
        title="The foundation for "
        accent="everything else."
        lead="Infrastructure is where your applications, data and security all live."
      />
      <ConnectedServices
        links={[
          ['/services/managed-it/', 'Keep the foundation monitored, maintained and supported once it is built.'],
          ['/services/cyber-security/', 'Secure the network, cloud and devices, with compliance support where you need it.'],
          ['/services/data-analytics/', 'Put the data your systems produce to work, on infrastructure built to hold it.'],
        ]}
      />
    </div>
  </section>

  <!-- 7b. Technical FAQ (2026-11-18) -->
  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="Questions" title="Technical questions, " accent="plain answers." />
      <FaqList items={faqs} openFirst={false} />
    </div>
  </section>

  <!-- 8. Conversation -->
  <CtaBand
    eyebrow="Let's talk"
    heading="Planning a move, a migration or an "
    accent="upgrade?"
    text="Tell us what's changing. We'll help you work out what your infrastructure needs to look like, and the order to get there."
  >
    <Button href={cta.primary.href} variant="primary" arrow>{ctaLabel}</Button>
    <Button href={site.booking} variant="secondary" external>Book a Free 30-Minute Call</Button>
  </CtaBand>
</BaseLayout>
