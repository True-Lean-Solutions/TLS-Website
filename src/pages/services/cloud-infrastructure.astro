---
/**
 * Cloud & Infrastructure (Hemang, 2026-11-18: service portfolio expansion).
 * Delivered with strategic partners under the TLS brand; partners are never
 * named. Capability lines are limited to what the partners advertise; no
 * uptime, availability or performance figure is stated. Unconfirmed items
 * (high-availability architecture as a named service, specific LAN/WAN/Wi-Fi
 * offerings) are left out: see docs/decisions.md 2026-11-18.
 *
 * Hero: the foundation builds in layers — workplace, then network, then
 * cloud — then a server workload migrates to the cloud and a continuity copy
 * is made. One cycle loops while on screen (sequence.ts). Reduced motion / no
 * JS: the finished picture.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import InfoCard from '../../components/InfoCard.astro';
import ProcessRail, { type RailStep } from '../../components/service/ProcessRail.astro';
import FlowMap, { type FlowItem, type FlowStage } from '../../components/service/FlowMap.astro';
import CtaBand from '../../components/CtaBand.astro';
import CapabilityGroups, { type CapabilityGroup } from '../../components/service/CapabilityGroups.astro';
import EngagementModels, { type EngagementModel } from '../../components/service/EngagementModels.astro';
import OutcomeList, { type Outcome } from '../../components/service/OutcomeList.astro';
import ConnectedServices from '../../components/service/ConnectedServices.astro';
import type { IconName } from '../../components/iconTypes';
import { cta, href, site } from '../../data/site';

// Draft copy (2026-11-18), pending Hemang's approval.
const title = 'Cloud & IT Infrastructure Services | True Lean Solutions';
const description =
  'Cloud migration and management, network design and implementation, structured cabling, office moves, VoIP and business continuity, built as one foundation.';
// v2.3 §09, "Implementation" context.
const ctaLabel = 'Discuss Your Implementation Need';

/* Hero diagram, viewBox 520 × 420: three tiers joined through the network. */
type Tile = { id: string; label: string; icon: IconName; x: number; y: number; tier: 'place' | 'net' | 'cloud' };
const HUB = { x: 260, y: 215 };
const tiles: Tile[] = [
  { id: 'apps', label: 'Cloud apps', icon: 'cloud', x: 130, y: 82, tier: 'cloud' },
  { id: 'data', label: 'Data', icon: 'database', x: 260, y: 82, tier: 'cloud' },
  { id: 'copy', label: 'Backup copy', icon: 'shield', x: 390, y: 82, tier: 'cloud' },
  { id: 'internet', label: 'Internet', icon: 'zap', x: 92, y: 215, tier: 'net' },
  { id: 'voice', label: 'Phones & Teams', icon: 'phone', x: 428, y: 215, tier: 'net' },
  { id: 'office', label: 'Office', icon: 'building', x: 110, y: 350, tier: 'place' },
  { id: 'remote', label: 'Remote team', icon: 'laptop', x: 260, y: 350, tier: 'place' },
  { id: 'servers', label: 'Server room', icon: 'server', x: 410, y: 350, tier: 'place' },
];
const at = (id: string) => tiles.find((t) => t.id === id)!;
const line = (a: { x: number; y: number }, b: { x: number; y: number }) => `M${a.x} ${a.y} L${b.x} ${b.y}`;
const links = [
  { tier: 'net', d: line(at('office'), HUB) },
  { tier: 'net', d: line(at('remote'), HUB) },
  { tier: 'net', d: line(at('servers'), HUB) },
  { tier: 'net', d: line(at('internet'), HUB) },
  { tier: 'net', d: line(HUB, at('voice')) },
  { tier: 'cloud', d: line(HUB, at('apps')) },
  { tier: 'cloud', d: line(HUB, at('data')) },
];
const migrate = `M${at('servers').x} ${at('servers').y} L${HUB.x} ${HUB.y} L${at('apps').x} ${at('apps').y}`;
const backup = `M${at('data').x + 34} ${at('data').y} L${at('copy').x - 34} ${at('copy').y}`;
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;

const challenges = [
  { title: 'Your infrastructure grew by accident', text: 'A server here, a second office there, a cloud subscription someone signed up for. It mostly works — but nobody has the whole picture.' },
  { title: "The network can't keep up", text: 'Slow connections, dead spots and dropped calls cost time that nobody tracks, and the workarounds become the way things are done.' },
  { title: 'Moving to the cloud feels risky', text: "You know some systems belong in the cloud — just not which ones, in what order, or how to move them without disrupting work." },
  { title: 'Change would expose the gaps', text: 'Opening an office, relocating or losing a key system would show how much depends on setups nobody documented.' },
];

const groups: CapabilityGroup[] = [
  {
    title: 'Cloud',
    line: 'Cloud environments sized for what you actually run — and moved there without disrupting the business.',
    icon: 'cloud',
    accent: 'red',
    art: 'cloud',
    items: ['Cloud migration and deployment', 'Managed cloud on AWS, Microsoft Azure and Google Cloud', 'Hybrid, private and public cloud', 'Virtualization and virtual desktops'],
  },
  {
    title: 'Network and servers',
    line: 'Dependable connections between your people, your places and your systems.',
    icon: 'integration',
    accent: 'blue',
    art: 'network',
    items: ['Network design and implementation', 'Network refresh and upgrades', 'Internet connectivity planning', 'Server configuration and deployment'],
  },
  {
    title: 'Workplace infrastructure',
    line: 'The physical side of IT, planned properly instead of improvised.',
    icon: 'building',
    accent: 'plum',
    art: 'workplace',
    items: ['Structured cabling', 'Office IT setup and relocation', 'Data center relocation and colocation', 'Hardware procurement'],
  },
  {
    title: 'Communications and continuity',
    line: 'Phones that move with your people, and a plan for the day something fails.',
    icon: 'phone',
    accent: 'red',
    art: 'comms',
    items: ['VoIP and unified communications', 'Microsoft Teams phones and conferencing', 'Cloud backup', 'Business continuity planning'],
  },
];

const accents = ['red', 'blue', 'plum'] as const;
const steps: RailStep[] = [
  { title: 'Map what you have', text: 'We document your current setup — locations, network, servers, cloud services — and how it all connects.', icon: 'search' },
  { title: 'Design the foundation', text: 'We design for where the business is going, then plan the order of work so nothing critical goes down.', icon: 'compass' },
  { title: 'Build and migrate', text: 'We install, configure and migrate in planned stages, with a rollback plan at each one.', icon: 'building' },
  { title: 'Document and hand over', text: 'You get a clear record of what was built, how it fits together and who to call.', icon: 'document' },
  { title: 'Run and improve', text: 'Ongoing management through Managed IT Services, or a clean handover to your own team.', icon: 'headset' },
];

/* Signature: from accumulated to designed (FlowMap). */
const flowIn: FlowItem[] = [
  { label: 'A server in a closet', icon: 'server' },
  { label: 'A patchwork network', icon: 'integration' },
  { label: 'An aging phone system', icon: 'phone' },
  { label: 'Scattered cloud apps', icon: 'cloud' },
  { label: 'Backups nobody has tested', icon: 'database' },
];
const flowStages: FlowStage[] = [
  { title: 'Map', sub: 'What you run and why', icon: 'search' },
  { title: 'Decide', sub: 'Keep, move or retire', icon: 'compass' },
  { title: 'Build', sub: 'In planned stages', icon: 'building' },
  { title: 'Run', sub: 'Monitored and maintained', icon: 'headset' },
];
const flowOut: FlowItem[] = [
  { label: 'Cloud environment', icon: 'cloud' },
  { label: 'Dependable network', icon: 'integration' },
  { label: 'Unified communications', icon: 'phone' },
  { label: 'Business continuity', icon: 'shield' },
];

const models: EngagementModel[] = [
  { title: 'Implementation projects', text: 'Networks, cabling, servers and office setup, scoped and delivered as a defined project.', fit: "you're building, moving or upgrading.", icon: 'building' },
  { title: 'Cloud migration', text: 'An assessment of what should move, then a staged migration planned around how your business works.', fit: 'systems need to move without stopping the business.', icon: 'cloud' },
  { title: 'Ongoing management', text: 'Your infrastructure monitored and maintained after it is built, as part of Managed IT Services.', fit: 'you want the foundation looked after, not just installed.', icon: 'headset' },
];

const outcomes: Outcome[] = [
  { title: 'A foundation you understand', text: 'Documented, so decisions are made on what you have instead of guesses.', icon: 'document' },
  { title: 'Room to grow', text: "Adding people, locations or systems doesn't mean starting over.", icon: 'rocket' },
  { title: 'Fewer disruptions', text: 'Planned changes instead of emergency fixes.', icon: 'shield' },
  { title: 'Work from anywhere', text: 'The same systems and phones in the office, at home or on the road.', icon: 'laptop' },
  { title: 'A plan for bad days', text: 'Backups and continuity planned before you need them.', icon: 'database' },
  { title: 'Clear choices about what runs where', text: 'Each system runs where it makes sense: in the cloud, on site, or both.', icon: 'compass' },
];
---

<BaseLayout title={title} description={description} path="/services/cloud-infrastructure/">
  <!-- 1. Hero: the foundation, in layers -->
  <section class="ci-hero">
    <div class="wrap ci-hero-grid">
      <div class="ci-copy" data-reveal="load">
        <nav class="ci-crumbs" aria-label="Breadcrumb">
          <a href={href('/services/')}>Solutions</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Cloud &amp; Infrastructure</span>
        </nav>
        <Eyebrow label="Cloud & Infrastructure" />
        <h1>A foundation that <span class="accent">holds up as you grow.</span></h1>
        <p class="ci-lede">
          Cloud environments, networks, connectivity and business communications — designed and built as one foundation,
          so the business on top of it can grow without starting over.
        </p>
        <div class="ci-actions">
          <Button href={cta.primary.href} variant="primary" arrow>{ctaLabel}</Button>
          <Button href={cta.email.href} variant="secondary" external>{cta.email.label}</Button>
        </div>
      </div>

      <figure class="ci-art" aria-labelledby="ci-art-cap" data-sequence="0,500,1400,2400,3500,4700" data-sequence-loop="3400">
        <div class="ci-scene">
          <svg class="ci-lines" viewBox="0 0 520 420" aria-hidden="true">
            <defs>
              <radialGradient id="ci-fade">
                <stop offset="0.5" stop-color="#fff" />
                <stop offset="1" stop-color="#000" />
              </radialGradient>
              <mask id="ci-mask"><rect x="0" y="0" width="520" height="420" fill="url(#ci-fade)" /></mask>
              <pattern id="ci-grid" width="26" height="26" patternUnits="userSpaceOnUse">
                <path d="M26 0H0V26" fill="none" stroke="rgba(13,13,13,0.05)" />
              </pattern>
            </defs>
            <rect x="0" y="0" width="520" height="420" fill="url(#ci-grid)" mask="url(#ci-mask)" />
            <!-- Tier bands -->
            <rect class="ci-band ci-band--cloud" x="34" y="26" width="452" height="112" rx="26" />
            <rect class="ci-band ci-band--net" x="34" y="182" width="452" height="66" rx="20" />
            <rect class="ci-band ci-band--place" x="34" y="300" width="452" height="100" rx="20" />
            <text class="ci-tier" x="52" y="48">Cloud</text>
            <text class="ci-tier" x="52" y="200">Network</text>
            <text class="ci-tier" x="52" y="320">Workplace</text>
            <text class="ci-platforms" x="468" y="48" text-anchor="end">AWS · Azure · Google Cloud</text>
            {links.map((l) => <path class:list={['ci-link', `ci-link--${l.tier}`]} d={l.d} pathLength="100" />)}
            <path class="ci-backup" d={backup} pathLength="100" />
            <path class="ci-migrate" d={migrate} pathLength="100" />
          </svg>

          <div class="ci-hub" style={`left: ${pct(HUB.x, 520)}; top: ${pct(HUB.y, 420)}`}>
            <Icon name="integration" size={22} />
            <span>Network</span>
          </div>
          {
            tiles.map((t) => (
              <div class:list={['ci-tile', `ci-tile--${t.tier}`]} data-tile={t.id} style={`left: ${pct(t.x, 520)}; top: ${pct(t.y, 420)}`}>
                <span class="ci-tile-icon">
                  <Icon name={t.icon} size={18} />
                </span>
                <span class="ci-tile-label">{t.label}</span>
              </div>
            ))
          }
          <span class="ci-tag ci-tag--moved" style={`left: ${pct(at('servers').x, 520)}; top: ${pct(at('servers').y, 420)}`}>Migrated</span>
        </div>

        <div class="ci-legend glass-panel ix-light" aria-hidden="true">
          <p class="ci-legend-title">Built in layers</p>
          <ol>
            <li>Workplace</li>
            <li>Network</li>
            <li>Cloud</li>
            <li>Continuity</li>
          </ol>
        </div>
        <figcaption id="ci-art-cap" class="visually-hidden">
          Illustration: a technology foundation in three layers — the workplace (office, remote team, server room), the
          network that connects them with internet and phones, and the cloud (apps, data and a backup copy). A server
          workload migrates to the cloud and a backup copy of the data is kept for continuity.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Business challenges -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Sound Familiar?"
        title="Most infrastructure isn't designed. "
        accent="It accumulates."
        lead="That works until the business grows, moves or depends on something that fails."
      />
      <div class="cards-2" data-reveal="stagger">
        {challenges.map((c, i) => <InfoCard title={c.title} text={c.text} accent={accents[i % 3]} />)}
      </div>
    </div>
  </section>

  <!-- 2b. Signature: from accumulated to designed -->
  <FlowMap
    id="ci-flow"
    eyebrow="From Accumulated to Designed"
    title="Turn what you have into "
    accent="one foundation."
    lead="Most environments grew one decision at a time. We map what's there, decide what stays, moves or retires, and rebuild it as one design."
    columns={['What you have today', 'How we rebuild it', 'What you end up with']}
    inputs={flowIn}
    stages={flowStages}
    outputs={flowOut}
  />

  <!-- 3. Capabilities -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="What We Build and Look After"
        title="From the cloud down "
        accent="to the cabling."
        lead="One partner for the layers your business runs on, so they're planned to work together."
      />
      <CapabilityGroups groups={groups} />
    </div>
  </section>

  <!-- 4. How it works -->
  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="How It Works" title="Planned in order, " accent="built without surprises." />
      <ProcessRail steps={steps} />
    </div>
  </section>

  <!-- 5. Engagement models -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="Ways to Work With Us"
        title="Build it, move it, "
        accent="or keep it running."
        lead="Most clients start with one project. Some keep us on to look after what we built."
      />
      <EngagementModels models={models} />
    </div>
  </section>

  <!-- 6. Outcomes -->
  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="What Changes" title="Infrastructure you can " accent="build a business on." />
      <OutcomeList outcomes={outcomes} />
    </div>
  </section>

  <!-- 7. Connected services -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="Works Together With"
        title="The foundation for "
        accent="everything else."
        lead="Infrastructure is where your applications, data and security all live."
      />
      <ConnectedServices
        links={[
          ['/services/managed-it/', 'Keep the foundation monitored, maintained and supported once it is built.'],
          ['/services/cyber-security/', 'Secure the network, cloud and devices, with compliance support where you need it.'],
          ['/services/data-analytics/', 'Put the data your systems produce to work, on infrastructure built to hold it.'],
        ]}
      />
    </div>
  </section>

  <!-- 8. Conversation -->
  <CtaBand
    eyebrow="Let's talk"
    heading="Planning a move, a migration or an "
    accent="upgrade?"
    text="Tell us what's changing. We'll help you work out what your infrastructure needs to look like, and the order to get there."
  >
    <Button href={cta.primary.href} variant="primary" arrow>{ctaLabel}</Button>
    <Button href={site.booking} variant="secondary" external>Book a Free 30-Minute Call</Button>
  </CtaBand>
</BaseLayout>

<style>
  /* ---- Hero ---------------------------------------------------------- */
  .ci-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background:
      radial-gradient(40% 60% at 82% 30%, rgba(18, 136, 207, 0.09), transparent 72%),
      radial-gradient(30% 45% at 8% 90%, rgba(217, 64, 64, 0.06), transparent 70%),
      var(--bg);
    border-bottom: 1px solid var(--border);
    padding-block: clamp(2.25rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  .ci-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    min-height: clamp(520px, 42vw, 620px);
  }
  .ci-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-2);
  }
  .ci-crumbs a {
    color: var(--blue-text);
    text-decoration: none;
  }
  .ci-crumbs a:hover {
    text-decoration: underline;
  }
  .ci-copy h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.3rem, 4.6vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .ci-copy h1 .accent {
    color: var(--red);
  }
  .ci-lede {
    margin-top: 1.4rem;
    max-width: 44ch;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--text-2);
  }
  .ci-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .ci-art {
    position: relative;
    margin: 0;
  }
  .ci-scene {
    position: relative;
    aspect-ratio: 520 / 420;
    width: 100%;
  }
  .ci-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ci-band {
    stroke-width: 1;
    transition: opacity 0.6s var(--ix-ease);
  }
  .ci-band--cloud {
    fill: rgba(18, 136, 207, 0.06);
    stroke: rgba(18, 136, 207, 0.22);
  }
  .ci-band--net {
    fill: rgba(135, 54, 98, 0.05);
    stroke: rgba(135, 54, 98, 0.2);
    stroke-dasharray: 4 5;
  }
  .ci-band--place {
    fill: rgba(13, 13, 13, 0.03);
    stroke: rgba(13, 13, 13, 0.12);
  }
  .ci-tier {
    font-family: var(--font-head);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--text-2);
  }
  .ci-platforms {
    font-family: var(--font-body);
    font-size: 10px;
    fill: var(--text-2);
  }
  .ci-link {
    fill: none;
    stroke: rgba(13, 13, 13, 0.28);
    stroke-width: 1.4;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }
  .ci-link--cloud {
    stroke: rgba(18, 136, 207, 0.55);
  }
  .ci-backup {
    fill: none;
    stroke: var(--plum);
    stroke-width: 2;
    stroke-dasharray: 3 4;
  }
  .ci-migrate {
    fill: none;
    stroke: var(--red);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }

  .ci-hub,
  .ci-tile,
  .ci-tag {
    position: absolute;
    transform: translate(-50%, -50%);
  }
  .ci-hub {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    padding: 0.55rem 0.8rem 0.45rem;
    border-radius: 14px;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-head);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: 0 10px 24px -10px rgba(13, 13, 13, 0.45);
  }
  .ci-tile {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    width: 17%;
    padding: 0.55rem 0.3rem 0.5rem;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 8px 18px -12px rgba(13, 13, 13, 0.3);
    text-align: center;
    transition:
      opacity 0.5s var(--ix-ease),
      transform 0.6s var(--ix-ease),
      border-color 0.4s ease;
  }
  .ci-tile-icon {
    display: inline-flex;
    color: var(--ink);
  }
  .ci-tile--cloud .ci-tile-icon {
    color: var(--blue);
  }
  .ci-tile--net .ci-tile-icon {
    color: var(--plum);
  }
  .ci-tile-label {
    font-size: 0.7rem;
    line-height: 1.2;
    color: var(--ink);
  }
  .ci-tag {
    margin-top: -2.9rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--red-text);
    color: #fff;
    font-family: var(--font-head);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    transition: opacity 0.4s ease;
  }

  .ci-legend {
    width: min(100%, 440px);
    margin: -1rem auto 0;
    padding: 0.9rem 1.15rem 1rem;
  }
  .ci-legend-title {
    font-family: var(--font-head);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .ci-legend ol {
    list-style: none;
    margin: 0.65rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .ci-legend li {
    padding-top: 0.6rem;
    border-top: 2px solid var(--blue);
    font-size: 0.8rem;
    color: var(--ink);
    transition:
      opacity 0.45s ease,
      border-color 0.45s ease;
  }
  .ci-legend li:nth-child(1) {
    border-top-color: var(--ink);
  }
  .ci-legend li:nth-child(2) {
    border-top-color: var(--plum);
  }
  .ci-legend li:nth-child(4) {
    border-top-color: var(--red);
  }

  /* ---- The build (only while the sequence hook runs) -------------------- */
  /* 0: clear. Each later stage adds a layer; nothing removes one. */
  .ci-art:global(.is-seq) :is(.ci-tile, .ci-hub, .ci-band, .ci-tier, .ci-platforms) {
    opacity: 0;
  }
  .ci-art:global(.is-seq) :is(.ci-link, .ci-migrate) {
    stroke-dashoffset: 100;
  }
  .ci-art:global(.is-seq) .ci-backup,
  .ci-art:global(.is-seq) .ci-tag {
    opacity: 0;
  }
  .ci-art:global(.is-seq) .ci-legend li {
    opacity: 0.35;
  }
  /* 1: the workplace. */
  .ci-art:global(.is-seq):not([data-stage='0']) :is(.ci-tile--place, .ci-band--place) {
    opacity: 1;
  }
  .ci-art:global(.is-seq):not([data-stage='0']) .ci-tier:nth-of-type(3) {
    opacity: 1;
  }
  .ci-art:global(.is-seq):not([data-stage='0']) .ci-legend li:nth-child(1) {
    opacity: 1;
  }
  /* 2: the network connects it. */
