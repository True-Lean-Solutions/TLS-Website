---
/**
 * Managed IT Services (Hemang, 2026-11-18: service portfolio expansion).
 * Delivered with strategic partners under the TLS brand; partners are never
 * named. Capability lines are limited to what the partners advertise, and no
 * response time, uptime, availability (24/7) or SLA is stated. Unconfirmed
 * capabilities (SRE, website maintenance, patch management as a named service)
 * are left out: see docs/decisions.md 2026-11-18.
 *
 * Hero: an operations map. One cycle plays in a loop while it is on screen
 * (scroll layer: sequence.ts) — healthy systems, an issue detected on a
 * server, routed to support, resolved, monitoring continues. Status words
 * only: no times, ticket numbers or metrics, so it never reads as live data.
 * Reduced motion / no JS: the finished, resolved picture.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import InfoCard from '../../components/InfoCard.astro';
import ProcessRail, { type RailStep } from '../../components/service/ProcessRail.astro';
import FlowMap, { type FlowItem, type FlowStage } from '../../components/service/FlowMap.astro';
import CtaBand from '../../components/CtaBand.astro';
import CapabilityGroups, { type CapabilityGroup } from '../../components/service/CapabilityGroups.astro';
import EngagementModels, { type EngagementModel } from '../../components/service/EngagementModels.astro';
import OutcomeList, { type Outcome } from '../../components/service/OutcomeList.astro';
import ConnectedServices from '../../components/service/ConnectedServices.astro';
import type { IconName } from '../../components/iconTypes';
import { cta, href, site } from '../../data/site';

// Draft copy (2026-11-18), pending Hemang's approval.
const title = 'Managed IT Services & IT Support | True Lean Solutions';
const description =
  'Managed IT for growing businesses: help desk support, proactive monitoring and maintenance, Microsoft 365, and backup and recovery, fully managed or co-managed.';

/* Hero map: a flat-topped hexagon of what a business runs on, around support. */
type MapNode = { id: string; label: string; icon: IconName; x: number; y: number };
const C = { x: 250, y: 200 };
const nodes: MapNode[] = [
  { id: 'devices', label: 'People & devices', icon: 'laptop', x: 155, y: 87 },
  { id: 'm365', label: 'Microsoft 365', icon: 'mail', x: 345, y: 87 },
  { id: 'servers', label: 'Servers', icon: 'server', x: 440, y: 200 },
  { id: 'apps', label: 'Business apps', icon: 'software', x: 345, y: 313 },
  { id: 'phones', label: 'Phones & mobile', icon: 'phone', x: 155, y: 313 },
  { id: 'backup', label: 'Backups', icon: 'database', x: 60, y: 200 },
];
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;

const challenges = [
  { title: 'IT falls to whoever is least busy', text: 'Someone on your team has become the IT person by default. Their real job waits while they reset passwords and chase printer problems.' },
  { title: "Problems surface when people can't work", text: 'Without monitoring, a failing device or a full disk only gets noticed once it has already stopped someone working.' },
  { title: 'Every new hire starts differently', text: "Onboarding and offboarding happen a different way each time — so people start without the tools they need, and leavers keep access they shouldn't." },
  { title: 'Nobody is sure the backups work', text: 'Backups were set up once. Whether you could actually restore from them is a question nobody wants to answer during an outage.' },
];

const groups: CapabilityGroup[] = [
  {
    title: 'Support for your people',
    line: "One place for your team to go when something isn't working — answered by people who know your setup.",
    icon: 'headset',
    accent: 'red',
    art: 'desk',
    items: ['IT help desk and end-user support', 'Employee onboarding and offboarding', 'Laptop, desktop and mobile device management', 'Hardware refresh and warranty replacement'],
  },
  {
    title: 'Systems kept healthy',
    line: 'Problems caught and dealt with before they become downtime, with the routine work done on schedule.',
    icon: 'monitor',
    accent: 'blue',
    art: 'health',
    items: ['Proactive monitoring and maintenance', 'Incident management and resolution', 'Microsoft 365 administration', 'Application support and maintenance'],
  },
  {
    title: 'Groundwork that prevents outages',
    line: 'The planning and records that stop a small problem from turning into a long one.',
    icon: 'database',
    accent: 'plum',
    art: 'backup',
    items: ['Backup and disaster recovery', 'IT asset management and procurement', 'IT documentation', 'Ongoing technology operations'],
  },
];

const accents = ['red', 'blue', 'plum'] as const;
const steps: RailStep[] = [
  { title: 'Understand your environment', text: 'We document what you run — people, devices, systems and accounts — and how your team actually works day to day.', icon: 'search' },
  { title: 'Stabilize what matters', text: 'We deal with the urgent issues first and close the gaps that put you at risk, like untested backups or unmanaged devices.', icon: 'shield' },
  { title: 'Transition support', text: 'Your team gets one clear way to ask for help, and we take over the routine work we agree on together.', icon: 'headset' },
  { title: 'Monitor and maintain', text: 'Systems are monitored and maintained, and when something needs attention, we respond and keep you informed.', icon: 'monitor' },
  { title: 'Review and improve', text: "We review what's working with you and plan the next improvements before they become problems.", icon: 'compass' },
];

/* Signature: every issue has a path (FlowMap). */
const flowIn: FlowItem[] = [
  { label: 'Your team asks for help', icon: 'message' },
  { label: 'Monitoring flags an issue', icon: 'monitor' },
  { label: 'Scheduled maintenance', icon: 'clock' },
  { label: 'Someone joins or leaves', icon: 'user' },
];
const flowStages: FlowStage[] = [
  { title: 'Logged', sub: 'One queue for everything', icon: 'checklist' },
  { title: 'Prioritized', sub: 'By business impact', icon: 'target' },
  { title: 'Resolved', sub: 'By people who know your setup', icon: 'headset' },
  { title: 'Prevented', sub: 'Root cause dealt with', icon: 'shield' },
];
const flowOut: FlowItem[] = [
  { label: 'People back to work', icon: 'users' },
  { label: 'Systems documented', icon: 'document' },
  { label: 'Fewer repeat issues', icon: 'chart' },
  { label: 'Clear view of your IT', icon: 'compass' },
];

const models: EngagementModel[] = [
  { title: 'Fully managed', text: 'We act as your IT team: user support, monitoring, maintenance and the routine work, under one agreement.', fit: "you don't have in-house IT, or don't want to build it.", icon: 'headset' },
  { title: 'Co-managed', text: 'We work alongside your in-house IT, taking on the support, monitoring or projects they don’t have time for.', fit: 'you have IT people who are stretched thin.', icon: 'users' },
  { title: 'Project-based', text: 'A defined piece of work with a clear scope, such as a device refresh, a Microsoft 365 rollout or a backup overhaul.', fit: 'you need a specific job done well, without an ongoing agreement.', icon: 'checklist' },
];

const outcomes: Outcome[] = [
  { title: 'Fewer interruptions', text: 'Issues are caught early and dealt with before they stop people working.', icon: 'shield' },
  { title: 'Your people back on their real jobs', text: 'IT stops landing on whoever happens to sit nearest the router.', icon: 'users' },
  { title: 'Predictable technology management', text: 'Maintenance happens on schedule instead of whenever something breaks.', icon: 'clock' },
  { title: 'Smoother starts and exits', text: 'New hires get what they need from day one, and access is removed when people leave.', icon: 'user' },
  { title: 'Backups you have checked', text: 'Recovery is planned and tested, not assumed.', icon: 'database' },
  { title: 'One partner, end to end', text: 'Support connects to the software, integrations and security we already help you with.', icon: 'integration' },
];
---

<BaseLayout title={title} description={description} path="/services/managed-it/">
  <!-- 1. Hero: the operations map -->
  <section class="mit-hero">
    <div class="wrap mit-hero-grid">
      <div class="mit-copy" data-reveal="load">
        <nav class="mit-crumbs" aria-label="Breadcrumb">
          <a href={href('/services/')}>Solutions</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Managed IT Services</span>
        </nav>
        <Eyebrow label="Managed IT Services" />
        <h1>Reliable IT, <span class="accent">without the firefighting.</span></h1>
        <p class="mit-lede">
          Keep your people, devices and systems running — with responsive support, proactive maintenance, and a team that
          already knows your environment when something needs attention.
        </p>
        <div class="mit-actions">
          <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
          <Button href={cta.email.href} variant="ghost-light" external>{cta.email.label}</Button>
        </div>
      </div>

      <figure class="mit-art" aria-labelledby="mit-art-cap" data-sequence="0,700,2000,3200,4400,5600" data-sequence-loop="3400">
        <div class="mit-scene">
          <svg class="mit-lines" viewBox="0 0 500 400" aria-hidden="true">
            <defs>
              <radialGradient id="mit-fade">
                <stop offset="0.55" stop-color="#fff" />
                <stop offset="1" stop-color="#000" />
              </radialGradient>
              <mask id="mit-mask"><rect x="0" y="0" width="500" height="400" fill="url(#mit-fade)" /></mask>
              <pattern id="mit-dots" width="20" height="20" patternUnits="userSpaceOnUse">
                <circle cx="1" cy="1" r="1" fill="rgba(255,255,255,0.09)" />
              </pattern>
            </defs>
            <rect x="0" y="0" width="500" height="400" fill="url(#mit-dots)" mask="url(#mit-mask)" />
            <ellipse class="mit-orbit" cx={C.x} cy={C.y} rx="190" ry="113" />
            <circle class="mit-hub-ring" cx={C.x} cy={C.y} r="58" />
            <circle class="mit-hub-ring mit-hub-ring--2" cx={C.x} cy={C.y} r="78" />
            {
              nodes.map((n) => (
                <g data-link={n.id}>
                  <path class="mit-link" d={`M${C.x} ${C.y} L${n.x} ${n.y}`} />
                  <path class="mit-pulse" d={`M${C.x} ${C.y} L${n.x} ${n.y}`} pathLength="100" />
                </g>
              ))
            }
            <path class="mit-ticket" d={`M440 200 L${C.x} ${C.y}`} pathLength="100" />
            <path class="mit-fix" d={`M${C.x} ${C.y} L440 200`} pathLength="100" />
          </svg>

          <div class="mit-hub" style={`left: ${pct(C.x, 500)}; top: ${pct(C.y, 400)}`}>
            <span class="mit-hub-icon"><Icon name="headset" size={26} /></span>
            <span class="mit-hub-label">Support</span>
          </div>

          {
            nodes.map((n) => (
              <div class="mit-node" data-node={n.id} style={`left: ${pct(n.x, 500)}; top: ${pct(n.y, 400)}`}>
                <span class="mit-node-icon">
                  <Icon name={n.icon} size={20} />
                </span>
                <span class="mit-node-label">{n.label}</span>
                <span class="mit-dot" aria-hidden="true" />
              </div>
            ))
          }

          <span class="mit-flag mit-flag--issue" style={`left: ${pct(440, 500)}; top: ${pct(200, 400)}`}>Issue detected</span>
          <span class="mit-flag mit-flag--ok" style={`left: ${pct(440, 500)}; top: ${pct(200, 400)}`}>Resolved</span>
        </div>

        <div class="mit-log glass-panel glass-panel--dark ix-light" aria-hidden="true">
          <p class="mit-log-title"><span class="mit-live" />Service desk</p>
          <ol>
            <li><span>Issue detected</span></li>
            <li><span>Routed to support</span></li>
            <li><span>Resolved — monitoring continues</span></li>
          </ol>
        </div>
        <figcaption id="mit-art-cap" class="visually-hidden">
          Illustration: the systems a business runs on — people and devices, Microsoft 365, servers, business apps, phones
          and backups — connected to a support team. An issue on a server is detected, routed to support and resolved,
          and monitoring continues.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Business challenges -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Sound Familiar?"
        title="IT shouldn't be "
        accent="everyone's side job."
        lead="Most growing businesses don't have an IT problem so much as an IT ownership problem. These are the signs."
      />
      <div class="cards-2" data-reveal="stagger">
        {challenges.map((c, i) => <InfoCard title={c.title} text={c.text} accent={accents[i % 3]} />)}
      </div>
    </div>
  </section>

  <!-- 3. Capabilities -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="What We Take Care Of"
        title="Support, maintenance and the "
        accent="groundwork in between."
        lead="Grouped by what your business needs, not by what's on a technician's checklist."
      />
      <CapabilityGroups groups={groups} />
    </div>
  </section>

  <!-- 4. Signature: every issue has a path -->
  <FlowMap
    id="mit-flow"
    eyebrow="How Support Flows"
    title="Every issue has a path "
    accent="to resolution."
    lead="Requests, alerts and routine work arrive in one place, are handled in order of impact, and leave a record — so the same problem is less likely to come back."
    columns={['Where it starts', 'How we handle it', 'What you get']}
    inputs={flowIn}
    stages={flowStages}
    outputs={flowOut}
  />

  <!-- 4b. How it works -->
  <section class="section">
    <div class="wrap">
      <SectionHeading eyebrow="How It Works" title="From inherited setup to " accent="managed environment." />
      <ProcessRail steps={steps} />
    </div>
  </section>

  <!-- 5. Outcomes -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading eyebrow="What Changes" title="Technology that stays out of the way, " accent="so your team doesn't have to." />
      <OutcomeList outcomes={outcomes} />
    </div>
  </section>

  <!-- 6. Engagement models -->
  <section class="section">
    <div class="wrap">
      <SectionHeading
        eyebrow="Ways to Work With Us"
        title="As much or as little "
        accent="as you need."
        lead="Some clients want a full IT team; others want backup for the one they have. We'll recommend what fits."
      />
      <EngagementModels models={models} />
    </div>
  </section>

  <!-- 7. Connected services -->
  <section class="section section-alt">
    <div class="wrap">
      <SectionHeading
        eyebrow="Works Together With"
        title="Part of one "
        accent="technology partner."
        lead="Managed IT is where the rest of your technology gets looked after day to day."
      />
      <ConnectedServices
        links={[
          ['/services/cyber-security/', 'Monitoring and maintenance go further with security controls and compliance support.'],
          ['/services/cloud-infrastructure/', 'The networks, cloud environments and office technology your support team keeps running.'],
          ['/services/software/', 'Applications we build for you can stay supported and maintained after launch.'],
        ]}
      />
    </div>
  </section>

  <!-- 8. Conversation -->
  <CtaBand
    eyebrow="Let's talk"
    heading="Tell us what keeps "
    accent="breaking."
    text="Start with a conversation about how IT works in your business today. We'll tell you plainly where ongoing support would help — and where it wouldn't."
  >
    <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
    <Button href={site.booking} variant="secondary" external>Book a Free 30-Minute Call</Button>
  </CtaBand>
</BaseLayout>

<style>
  /* ---- Hero ---------------------------------------------------------- */
  .mit-hero {
    --ok: #34d399;
    --warn: #fbbf24;
    --hot: #ff7a7a;
    --cool: #5cc3ff;
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: #fff;
    background:
      radial-gradient(48% 70% at 78% 46%, rgba(18, 136, 207, 0.16), transparent 72%),
      radial-gradient(36% 50% at 4% 12%, rgba(217, 64, 64, 0.1), transparent 70%),
      var(--ink);
    padding-block: clamp(2.25rem, 4vw, 3.5rem) clamp(2.5rem, 5vw, 4rem);
  }
  .mit-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
    min-height: clamp(520px, 42vw, 620px);
  }
  .mit-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.72);
  }
  .mit-crumbs a {
    color: #fff;
    text-decoration: none;
  }
  .mit-crumbs a:hover {
    text-decoration: underline;
  }
  .mit-copy :global(.eyebrow) {
    color: rgba(255, 255, 255, 0.82);
  }
  .mit-copy h1 {
    margin-top: 0.9rem;
    font-size: clamp(2.3rem, 4.6vw, 3.6rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: #fff;
    max-width: 14ch;
  }
  .mit-copy h1 .accent {
    color: var(--red);
  }
  .mit-lede {
    margin-top: 1.4rem;
    max-width: 44ch;
    font-size: 1.1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.8);
  }
  .mit-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  /* The map */
  .mit-art {
    position: relative;
    margin: 0;
  }
  .mit-scene {
    position: relative;
    aspect-ratio: 5 / 4;
    width: 100%;
  }
  .mit-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .mit-orbit {
    fill: none;
    stroke: rgba(255, 255, 255, 0.08);
    stroke-dasharray: 2 6;
  }
  .mit-hub-ring {
    fill: rgba(18, 136, 207, 0.06);
    stroke: rgba(92, 195, 255, 0.28);
  }
  .mit-hub-ring--2 {
    fill: none;
    stroke: rgba(92, 195, 255, 0.12);
  }
  .mit-link {
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1.2;
  }
  .mit-pulse {
    fill: none;
    stroke: var(--cool);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 3 97;
    stroke-dashoffset: 100;
    opacity: 0;
  }
  .mit-ticket,
  .mit-fix {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
  }
  .mit-ticket {
    stroke: var(--hot);
  }
  .mit-fix {
    stroke: var(--cool);
  }

  .mit-hub,
  .mit-node,
  .mit-flag {
    position: absolute;
    transform: translate(-50%, -50%);
  }
  .mit-hub {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    width: 21%;
    padding: 0.9rem 0.5rem 0.75rem;
    border-radius: 999px;
    aspect-ratio: 1;
    align-content: center;
    background: radial-gradient(circle at 50% 35%, #1b2a3f, #0f1622);
    border: 1px solid rgba(92, 195, 255, 0.45);
    box-shadow: 0 0 0 6px rgba(18, 136, 207, 0.08);
    transition: box-shadow 0.6s var(--ix-ease);
  }
  .mit-hub-icon {
    color: var(--cool);
    display: inline-flex;
  }
  .mit-hub-label {
    font-family: var(--font-head);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .mit-node {
    width: 19%;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 0.7rem 0.4rem 0.6rem;
    border-radius: 14px;
    background: rgba(22, 28, 42, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.14);
    text-align: center;
    transition:
      border-color 0.5s var(--ix-ease),
      box-shadow 0.5s var(--ix-ease);
  }
  .mit-node-icon {
    display: inline-flex;
    color: rgba(255, 255, 255, 0.9);
  }
  .mit-node-label {
    font-size: 0.72rem;
    line-height: 1.25;
    color: rgba(255, 255, 255, 0.86);
  }
  .mit-dot {
    position: absolute;
    top: 0.5rem;
    right: 0.55rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px rgba(52, 211, 153, 0.18);
    transition:
      background 0.4s ease,
      box-shadow 0.4s ease;
  }
  .mit-flag {
    margin-top: -3.6rem;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    white-space: nowrap;
    color: #0d0d0d;
    opacity: 0;
    transition:
      opacity 0.4s ease,
      transform 0.5s var(--ix-ease);
  }
  .mit-flag--issue {
    background: var(--warn);
  }
  .mit-flag--ok {
    background: var(--ok);
    opacity: 1; /* the finished picture */
  }

  /* The service desk log: a liquid-glass panel overlapping the map's base. */
  .mit-log {
    position: relative;
    width: min(100%, 420px);
    margin: -1.25rem auto 0;
    padding: 0.95rem 1.15rem 1rem;
  }
  .mit-log-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-head);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }
  .mit-live {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--ok);
  }
  .mit-log ol {
    list-style: none;
    margin: 0.7rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    counter-reset: log;
  }
  .mit-log li {
    counter-increment: log;
    position: relative;
    padding-top: 0.75rem;
    border-top: 2px solid var(--ok);
    font-size: 0.78rem;
    line-height: 1.35;
    color: rgba(255, 255, 255, 0.9);
    transition:
      opacity 0.45s ease,
      border-color 0.45s ease;
  }

  /* ---- The cycle (only while the sequence hook runs: motion + JS) ---- */
  .mit-art:global(.is-seq) .mit-flag--ok {
    opacity: 0;
  }
  .mit-art:global(.is-seq) .mit-log li {
    opacity: 0.38;
    border-top-color: rgba(255, 255, 255, 0.2);
  }
  /* 1+: healthy, monitoring pulses travel out to every system. */
  .mit-art:global(.is-seq):not([data-stage='0']) .mit-pulse {
    opacity: 1;
    animation: mit-pulse 2.6s linear infinite;
  }
  .mit-art:global(.is-seq) [data-link='devices'] .mit-pulse { animation-delay: -0.4s; }
  .mit-art:global(.is-seq) [data-link='m365'] .mit-pulse { animation-delay: -1.1s; }
  .mit-art:global(.is-seq) [data-link='apps'] .mit-pulse { animation-delay: -1.7s; }
  .mit-art:global(.is-seq) [data-link='phones'] .mit-pulse { animation-delay: -0.8s; }
  .mit-art:global(.is-seq) [data-link='backup'] .mit-pulse { animation-delay: -2.2s; }
  @keyframes mit-pulse {
    to {
      stroke-dashoffset: 0;
    }
  }
  .mit-art:global(.is-seq)[data-stage='0'] .mit-dot {
    background: rgba(255, 255, 255, 0.25);
    box-shadow: none;
  }
  /* 2–4: an issue on the server. */
  .mit-art:is([data-stage='2'], [data-stage='3'], [data-stage='4']) [data-node='servers'] {
    border-color: rgba(251, 191, 36, 0.7);
    box-shadow: 0 0 0 4px rgba(251, 191, 36, 0.12);
  }
