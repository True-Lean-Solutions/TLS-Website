---
/**
 * Technology Strategy (Hemang's brief and fold references, 2026-10-06;
 * docs/references/pages/services/technology-strategy/). Replaces the short
 * [solution].astro page for this route.
 *
 * Copy: the hero keeps the approved headline, blurb and CTAs (src/data/
 * services.ts, v2.3 §09 "Requirements Not Yet Clear"); section copy is the
 * brief's. Proof is real only: the "Six Account Tiers" case study and its own
 * at-a-glance facts, the reviews sheet (ReviewReel), the client logos, and
 * published Insights. The references' sample statistics, testimonials,
 * vendor logos, mountain imagery, inline form and newsletter are not used.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import ReviewReel from '../../components/ReviewReel.astro';
import FaqList from '../../components/FaqList.astro';
import type { IconName } from '../../components/iconTypes';
import { cta, href, site } from '../../data/site';
import { solutions } from '../../data/services';
import { testimonials } from '../../data/testimonials';
import { categoryMeta, getPublishedPosts } from '../../data/insights';

const img = (f: string) => href(`/solutions/technology-strategy/${f}`);
const page = solutions.find((s) => s.href === '/services/technology-strategy/')!;
const booking = { label: 'Book a Free 30-Minute Call', href: site.booking };

const title = 'True Lean Solutions — Technology Strategy';
const description =
  'Turn business goals into a practical technology roadmap. True Lean Solutions helps you work out what you actually need, choose the right solutions and avoid unnecessary cost.';

type Accent = 'red' | 'blue' | 'plum' | 'green';
const tone: Record<Accent, string> = { red: 'var(--red)', blue: 'var(--blue)', plum: 'var(--ts-violet)', green: 'var(--ts-green)' };

const benefits: { text: string; icon: IconName; c: Accent }[] = [
  { text: 'Business-focused approach', icon: 'target', c: 'red' },
  { text: 'Practical, actionable roadmap', icon: 'document', c: 'blue' },
  { text: 'Technology-agnostic advice', icon: 'integration', c: 'plum' },
  { text: 'Support from strategy to execution', icon: 'users', c: 'green' },
];

const indicators: { text: string; icon: IconName; c: Accent }[] = [
  { text: 'Lower costs', icon: 'database', c: 'red' },
  { text: 'Better visibility', icon: 'chart', c: 'blue' },
  { text: 'Higher efficiency', icon: 'gear', c: 'plum' },
  { text: 'Sustainable growth', icon: 'target', c: 'green' },
];

/* The roadmap illustration: milestones along one rising path (no figures). */
const milestones: { text: string; icon: IconName; x: number; y: number; side: 'l' | 'r' }[] = [
  { text: 'Clear roadmap', icon: 'users', x: 60, y: 384, side: 'r' },
  { text: 'Right priorities', icon: 'chart', x: 200, y: 300, side: 'r' },
  { text: 'Reduced risk', icon: 'shield', x: 320, y: 250, side: 'r' },
  { text: 'Scalable solutions', icon: 'gear', x: 430, y: 160, side: 'l' },
  { text: 'Business goals', icon: 'target', x: 530, y: 62, side: 'l' },
];
const PATH = 'M18 412 Q 40 396 60 384 T 200 300 T 320 250 T 430 160 T 530 62 T 586 22';

const help: { title: string; text: string; icon: IconName; c: Accent; img: string; alt: string }[] = [
  {
    title: 'Assess Current State',
    text: 'Understand your business goals, processes and existing systems to identify gaps and opportunities.',
    icon: 'search',
    c: 'red',
    img: 'card-1.webp',
    alt: 'A laptop showing dashboards, with panels labeled Systems, Processes and People.',
  },
  {
    title: 'Identify Opportunities',
    text: 'Find areas where technology can improve efficiency, visibility and results.',
    icon: 'database',
    c: 'blue',
    img: 'card-2.webp',
    alt: 'A planning wall of notes, with panels labeled Automation Opportunities, Integration Possibilities and AI & Data Use Cases.',
  },
  {
    title: 'Create a Roadmap',
    text: 'Define the right solutions, priorities, timelines and implementation approach.',
    icon: 'document',
    c: 'plum',
    img: 'card-3.webp',
    alt: 'A phased roadmap: Phase 1 Quick Wins, Phase 2 Core Solutions, Phase 3 Scale & Optimize.',
  },
  {
    title: 'Support Execution',
    text: 'Work with your team to ensure successful adoption, measure impact and adjust as you grow.',
    icon: 'users',
    c: 'green',
    img: 'card-4.webp',
    alt: 'A team at work, with checklist panels for Implementation Support, Change Management and Measure Results.',
  },
];

const steps: { title: string; text: string; c: Accent }[] = [
  { title: 'Discover', text: 'Understand your goals, challenges and constraints.', c: 'red' },
  { title: 'Analyze', text: 'Evaluate current technology, processes and data.', c: 'blue' },
  { title: 'Plan', text: 'Create a clear, prioritized roadmap with solutions.', c: 'plum' },
  { title: 'Enable', text: 'Support implementation and measure impact.', c: 'green' },
];

const outcomes: { text: string; icon: IconName; c: Accent }[] = [
  { text: 'Improved efficiency and productivity', icon: 'chart', c: 'red' },
  { text: 'Better visibility and decision-making', icon: 'database', c: 'blue' },
  { text: 'Reduced costs and technology debt', icon: 'server', c: 'plum' },
  { text: 'A scalable foundation for future growth', icon: 'rocket', c: 'green' },
];

/* Real proof: the case study's own facts, verbatim from its post. */
const posts = await getPublishedPosts();
const caseStudy = posts.find((p) => p.id === 'six-account-tiers-one-source-of-truth');
const glance =
  caseStudy?.data.blocks.find((b): b is Extract<typeof b, { type: 'stats' }> => b.type === 'stats')?.items ?? [];
const caseIcons: IconName[] = ['users', 'compass', 'software', 'process'];

const faqs: { q: string; a: string[] }[] = [
  {
    q: 'What is technology strategy?',
    a: [
      "It's working out what technology your business actually needs — and why — before anything is bought or built. We challenge assumptions early, then define the right solution, so every investment serves a real business goal.",
    ],
  },
  {
    q: 'How is this different from IT consulting?',
    a: [
      "We don't stop at advice. Others build what you ask for; we build what you actually need. We don't deliver slide decks — we deliver working systems, documented processes, and measurable improvements, and we stay engaged after go-live.",
    ],
  },
  {
    q: 'What types of businesses do you work with?',
    a: [
      'Growing small and mid-sized businesses. Everything we do is scoped and priced for the constraints you work under.',
      "Most businesses we work with know something isn't working but aren't sure which lever to pull first — that's a fine place to start.",
    ],
  },
  {
    q: 'How does the technology strategy process work?',
    a: [
      'In four steps: we discover your goals, challenges and constraints; analyze your current technology, processes and data; plan a clear, prioritized roadmap with the right solutions; and enable your team — supporting implementation and measuring impact.',
    ],
  },
  {
    q: 'What happens after the roadmap is created?',
    a: [
      'You decide how to move forward. We can work with your team to put the roadmap into practice — supporting adoption, measuring impact and adjusting as you grow — and we stay engaged after go-live to refine what we have built.',
    ],
  },
];

/* Related solutions: real routes only, each with its approved one-line summary. */
const related: { title: string; text: string; href: string; icon: IconName; c: Accent; photo?: string }[] = [
  ...['/services/enterprise-ai/'].map((h) => solutions.find((s) => s.href === h)!).map((s) => ({ title: s.title, text: s.summary, href: s.href, icon: s.icon, c: 'red' as Accent })),
  { title: 'Meeting Intelligence', text: 'Turn every meeting into secure, searchable knowledge.', href: '/services/meeting-intelligence/', icon: 'video', c: 'blue', photo: href('/solutions/meeting-intelligence/hero-900.webp') },
  ...[
    ['/services/workflow-automation/', 'plum'],
    ['/services/data-analytics/', 'green'],
    ['/services/integrations/', 'blue'],
    ['/services/software/', 'red'],
    ['/services/cyber-security/', 'plum'],
    ['/services/technical-talent/', 'green'],
  ].map(([h, c]) => {
    const s = solutions.find((x) => x.href === h)!;
    return { title: s.title, text: s.summary, href: s.href, icon: s.icon, c: c as Accent };
  }),
];

/* Insights on making technology decisions (real posts, as published). */
const insightIds = ['why-your-software-implementation-failed', 'home-grown-erp-vs-off-the-shelf', 'custom-integrations-connect-instead-of-replace'];
const insights = insightIds.map((id) => posts.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => !!p);
---

<BaseLayout title={title} description={description} path="/services/technology-strategy/">
  <!-- 1. Hero -->
  <section class="ts-hero">
    <figure class="ts-hero-media">
      <div class="ts-hero-frame" data-hero-photo>
        <img
          src={img('hero.webp')}
          srcset={`${img('hero-720.webp')} 720w, ${img('hero.webp')} 1042w`}
          sizes="(max-width: 960px) 100vw, 62vw"
          alt="A strategy meeting at dusk above a city skyline, with a rising roadmap: Understand Your Business, Assess Opportunities, Create a Technology Roadmap, Support Execution, Business Growth."
          width="1042"
          height="649"
          fetchpriority="high"
          decoding="async"
        />
        <span class="ts-node" style="--x: 56.4%; --y: 62.9%; --d: 900ms" aria-hidden="true"></span>
        <span class="ts-node" style="--x: 74.4%; --y: 47.6%; --d: 1250ms" aria-hidden="true"></span>
        <span class="ts-node ts-node--goal" style="--x: 87%; --y: 29.6%; --d: 1600ms" aria-hidden="true"></span>
      </div>
    </figure>
    <div class="wrap">
      <div class="ts-hero-copy" data-reveal="load">
        <nav class="ts-crumbs" aria-label="Breadcrumb">
          <a href={href('/services/')}>Solutions</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Technology Strategy</span>
        </nav>
        <Eyebrow label="Technology Strategy" />
        <h1>Make technology work toward <span class="accent">the right goal.</span></h1>
        <p class="ts-lede">{page.blurb}</p>
        <div class="ts-actions">
          <Button href={cta.primary.href} variant="primary" arrow>Bring Us the Need</Button>
          <Button href={cta.email.href} variant="ghost-light" external>{cta.email.label}</Button>
        </div>
      </div>
      <ul class="ts-benefits" data-reveal="stagger" aria-label="What to expect">
        {benefits.map((b) => (
          <li style={`--c: ${tone[b.c]}`}>
            <span class="ts-glyph" aria-hidden="true"><Icon name={b.icon} size={20} /></span>
            {b.text}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2. Why technology strategy matters -->
  <section class="section ts-why">
    <div class="wrap ts-why-grid">
      <div>
        <SectionHeading
          eyebrow="Why Technology Strategy Matters"
          title="Good technology decisions create "
          accent="long-term value."
          lead="Many organizations invest in tools without a clear plan, leading to higher costs, disconnected systems and limited results. A well-defined technology strategy helps you align people, processes and technology with your business goals."
        />
        <ul class="ts-indicators" data-reveal="stagger">
          {indicators.map((i) => (
            <li style={`--c: ${tone[i.c]}`}>
              <span class="ts-glyph ts-glyph--soft" aria-hidden="true"><Icon name={i.icon} size={20} /></span>
              {i.text}
            </li>
          ))}
        </ul>
      </div>
      <figure class="ts-map" data-draw>
        <div class="ts-map-grid" aria-hidden="true"></div>
        <svg class="ts-map-path" viewBox="0 0 600 440" aria-hidden="true">
          <defs>
            <linearGradient id="ts-path-grad" x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#1288CF" />
              <stop offset="0.55" stop-color="#8b6cf0" />
              <stop offset="1" stop-color="#D94040" />
            </linearGradient>
          </defs>
          <path class="draw-path ts-map-glow" d={PATH} />
          <path class="draw-path" d={PATH} />
        </svg>
        <ul class="ts-milestones">
          {milestones.map((m, i) => (
            <li
              data-draw-mark
              class:list={[`side-${m.side}`, { 'is-goal': i === milestones.length - 1 }]}
              style={`--x: ${((m.x / 600) * 100).toFixed(2)}%; --y: ${((m.y / 440) * 100).toFixed(2)}%`}
            >
              <span class="ts-dot" aria-hidden="true"></span>
              <span class="ts-chip">
                <span class="ts-glyph" aria-hidden="true"><Icon name={m.icon} size={18} /></span>
                {m.text}
              </span>
            </li>
          ))}
        </ul>
        <figcaption class="visually-hidden">
          A rising roadmap from a clear roadmap and the right priorities, through reduced risk and scalable solutions, to business goals.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 3. How we help -->
  <section class="section ts-help">
    <div class="ts-wash" aria-hidden="true"></div>
    <div class="wrap">
      <div class="ts-help-head">
        <SectionHeading
          eyebrow="How We Help"
          title="From business goals to a clear "
          accent="technology roadmap."
          lead="We work closely with your team to understand your business, evaluate your current technology landscape and create a practical plan for what comes next."
        />
        <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
      </div>
      <ol class="ts-help-cards" data-reveal="stagger">
        {help.map((h, i) => (
          <li class="ts-card ix-card ix-card--quiet" style={`--c: ${tone[h.c]}`}>
            <div class="ts-card-top">
              <span class="ts-tile" aria-hidden="true"><Icon name={h.icon} size={22} /></span>
              <span class="ts-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
            <img src={img(h.img)} alt={h.alt} width="700" height="312" loading="lazy" decoding="async" />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Our approach -->
  <section class="section ts-approach">
    <div class="wrap">
      <div class="ts-approach-head">
        <SectionHeading eyebrow="Our Approach" title="A structured and " accent="practical process." />
        <p class="ts-approach-note" data-reveal>We keep the process simple and focused on outcomes, so you get a strategy that is realistic, scalable and aligned with your business.</p>
      </div>
      <div class="ts-track" data-progress>
        <span class="ts-track-line" aria-hidden="true"><span class="ts-track-fill"></span></span>
        <ol class="ts-steps">
          {steps.map((s, i) => (
            <li data-step style={`--c: ${tone[s.c]}`}>
              <span class="ts-step-dot" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3><span class="visually-hidden">{String(i + 1).padStart(2, '0')} — </span>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- 5. Business outcomes -->
  <section class="section ts-outcomes">
    <div class="wrap">
      <div class="ts-split-head">
        <SectionHeading eyebrow="Business Outcomes" title="Build a stronger, more " accent="future-ready organization." />
        <p data-reveal>A clear technology strategy helps you make confident decisions, reduce risk and create a strong foundation for long-term growth.</p>
      </div>
      <ul class="ts-outcome-cards" data-reveal="stagger">
        {outcomes.map((o) => (
          <li class="ix-card ix-card--quiet" style={`--c: ${tone[o.c]}`}>
            <span class="ts-tile" aria-hidden="true"><Icon name={o.icon} size={22} /></span>
            <span>{o.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. Real-world impact: a real case study -->
  {
    caseStudy && (
      <section class="section ts-case">
        <div class="wrap ts-case-grid">
          <div class="ts-case-copy">
            <SectionHeading
              eyebrow="Real-World Impact"
              title="Helping businesses make "
              accent="the right technology decisions."
              lead="Every engagement starts by understanding what the business actually needs — then deciding what to build."
            />
            <article class="ts-case-card" data-reveal>
              <p class="ts-case-tag">Case study</p>
              <h3>{caseStudy.data.title}</h3>
              <p>{caseStudy.data.excerpt}</p>
              <div class="ts-actions">
                <Button href={`/insights/${caseStudy.id}/`} variant="primary" arrow>Read the Case Study</Button>
                <Button href="/insights/case-studies/" variant="ghost-light">View More Case Studies</Button>
              </div>
            </article>
          </div>
          <figure class="ts-case-visual">
            {caseStudy.data.cover && (
              <img
                src={href(caseStudy.data.cover)}
                alt={caseStudy.data.coverAlt ?? ''}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
                data-float="1"
              />
            )}
            <ul class="ts-glance" data-reveal="stagger" aria-label="At a glance">
              {glance.map((g, i) => (
                <li>
                  <span class="ts-glyph" aria-hidden="true"><Icon name={caseIcons[i % caseIcons.length]} size={18} /></span>
                  <span>
                    <strong>{g.value}</strong>
                    <span>{g.label}</span>
                  </span>
                </li>
              ))}
            </ul>
          </figure>
        </div>
      </section>
    )
  }

  <!-- 7. Clients and what they say -->
  <section class="section ts-voices">
    <div class="wrap">
      <SectionHeading eyebrow="What Our Clients Say" title="Trusted by businesses that want " accent="real results." align="center" />
      <div class="ts-logos" data-reveal><ClientLogos /></div>
    </div>
    <ReviewReel testimonials={testimonials} />
  </section>

  <!-- 8. Plan your next step -->
  <section class="ts-plan">
    <div class="ts-plan-photo" aria-hidden="true">
      <img src={img('team.webp')} alt="" width="1062" height="280" loading="lazy" decoding="async" data-float="1" />
    </div>
    <div class="wrap">
      <div class="ts-plan-copy" data-reveal>
        <Eyebrow label="Let's Plan Your Next Step" />
        <h2>Talk to our team about your <span class="accent">technology strategy.</span></h2>
        <p>In a free 30-minute call, we'll understand your goals, discuss your challenges and explore how TLS can help you build a practical technology roadmap.</p>
        <div class="ts-actions">
          <Button href={booking.href} variant="primary" arrow external>{booking.label}</Button>
          <Button href={cta.email.href} variant="ghost-light" external>{cta.email.label}</Button>
        </div>
        <ul class="ts-trust" aria-label="About the call">
          <li><span class="ts-glyph" aria-hidden="true"><Icon name="clock" size={18} /></span>A free 30-minute call</li>
          <li><span class="ts-glyph" aria-hidden="true"><Icon name="target" size={18} /></span>Tailored to your business</li>
          <li><span class="ts-glyph" aria-hidden="true"><Icon name="message" size={18} /></span>Speak with our team</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 9. FAQ -->
  <section class="section ts-faq">
    <div class="wrap ts-faq-grid">
      <SectionHeading
        eyebrow="Frequently Asked Questions"
        title="Common questions about "
        accent="technology strategy."
        lead="Quick answers about our approach, the process and how we can help your business."
      />
      <FaqList items={faqs} />
    </div>
  </section>

  <!-- 10. Related solutions -->
  <section class="section ts-related" aria-labelledby="ts-related-title">
    <div class="wrap">
      <div class="ts-split-head ts-related-head">
        <div class="section-heading" data-reveal="">
          <Eyebrow label="Related Solutions" />
          <h2 id="ts-related-title">Explore solutions that support your <span class="accent">technology strategy.</span></h2>
        </div>
        <div class="ts-related-side">
          <p>Technology strategy often connects with several areas. Explore how our other solutions can support your goals.</p>
          <div class="ts-arrows">
            <button type="button" class="ts-arrow" data-dir="-1" aria-controls="ts-rel-track" aria-label="Previous solutions"><Icon name="arrow" size={18} /></button>
            <button type="button" class="ts-arrow" data-dir="1" aria-controls="ts-rel-track" aria-label="Next solutions"><Icon name="arrow" size={18} /></button>
          </div>
        </div>
      </div>
    </div>
    <ul class="ts-rel-track" id="ts-rel-track" tabindex="-1">
      {related.map((r) => (
        <li class="ts-rel" style={`--c: ${tone[r.c]}`}>
          <a href={href(r.href)} class="ts-rel-link ix-card ix-card--quiet">
            <span class:list={['ts-rel-art', { 'has-photo': r.photo }]} aria-hidden="true">
              {r.photo ? <img src={r.photo} alt="" width="900" height="450" loading="lazy" decoding="async" /> : <span class="ts-rel-mark"><Icon name={r.icon} size={88} /></span>}
              <span class="ts-tile"><Icon name={r.icon} size={22} /></span>
            </span>
            <span class="ts-rel-body">
              <strong>{r.title}</strong>
              <span>{r.text}</span>
            </span>
            <span class="ts-rel-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- 11. Insights -->
  {
    insights.length > 0 && (
      <section class="section ts-insights">
        <div class="wrap">
          <div class="ts-split-head">
            <SectionHeading eyebrow="Insights & Resources" title="Ideas and perspectives on " accent="technology decisions." />
            <Button href="/insights/" variant="secondary" arrow>View All Insights</Button>
          </div>
          <ul class="ts-posts" data-reveal="stagger">
            {insights.map((p) => (
              <li>
                <a href={href(`/insights/${p.id}/`)} class="ts-post ix-card ix-card--quiet">
                  {p.data.cover && <img src={href(p.data.cover)} alt="" width="320" height="200" loading="lazy" decoding="async" />}
                  <span class="ts-post-body">
                    <span class="ts-post-cat">{categoryMeta[p.data.category].label}</span>
                    <strong>{p.data.title}</strong>
                    {p.data.readTime && (
                      <span class="ts-post-time">
                        <Icon name="clock" size={14} /> {p.data.readTime}
                      </span>
                    )}
                  </span>
                  <span class="ts-rel-go" aria-hidden="true"><Icon name="arrow" size={16} /></span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- 12. Final CTA -->
  <section class="ts-final">
    <svg class="ts-final-waves" viewBox="0 0 1440 360" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="ts-wave-a" x1="0" x2="1">
          <stop offset="0" stop-color="#1288CF" stop-opacity="0" />
          <stop offset="0.45" stop-color="#1288CF" stop-opacity="0.55" />
          <stop offset="1" stop-color="#D94040" stop-opacity="0.9" />
        </linearGradient>
      </defs>
      {Array.from({ length: 9 }).map((_, i) => (
        <path d={`M0 ${250 + i * 9} C 300 ${180 + i * 12}, 520 ${330 - i * 6}, 820 ${240 + i * 5} S 1260 ${120 + i * 14}, 1440 ${170 + i * 10}`} />
      ))}
    </svg>
    <div class="wrap ts-final-grid">
      <div data-reveal>
        <Eyebrow label="Ready When You Are" />
        <h2>Let's build a technology strategy that drives <span class="accent">real results.</span></h2>
      </div>
      <div class="ts-final-cta" data-reveal>
        <p>Book a free 30-minute call to discuss your goals, challenges and how we can help you create a practical technology roadmap.</p>
        <div class="ts-actions">
          <Button href={booking.href} variant="primary" arrow external>{booking.label}</Button>
          <Button href={cta.email.href} variant="ghost-light" external>{cta.email.label}</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Related solutions: arrow buttons step the track by one card; each button
  // is disabled at its end. Touch, trackpad and keyboard scroll it natively.
  const track = document.getElementById('ts-rel-track');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.ts-arrow')];
  if (track && buttons.length) {
    const step = () => (track.querySelector<HTMLElement>('.ts-rel')?.offsetWidth ?? 300) + 20;
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      buttons.forEach((b) => (b.disabled = b.dataset.dir === '-1' ? track.scrollLeft <= 2 : track.scrollLeft >= max));
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: smooth ? 'smooth' : 'auto' });
      })
    );
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>

