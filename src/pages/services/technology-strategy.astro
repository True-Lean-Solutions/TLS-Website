<script>
  // Section rail: the dot for the section in view lights; the rail fills
  // with the reader's progress through the sections.
  const railEl = document.querySelector<HTMLElement>('[data-rail]');
  if (railEl) {
    const links = [...railEl.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')];
    const secs = links.map((a) => document.getElementById(a.dataset.railLink!)).filter((s): s is HTMLElement => !!s);
    const update = () => {
      const line = window.innerHeight * 0.4;
      let active = -1;
      secs.forEach((sec, i) => {
        if (sec.getBoundingClientRect().top <= line) active = i;
      });
      links.forEach((a, i) => {
        a.classList.toggle('is-active', i === active);
        a.classList.toggle('is-past', i < active);
        if (i === active) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
      railEl.style.setProperty('--rail', String(Math.max(0, active) / Math.max(1, secs.length - 1)));
      const first = secs[0]?.getBoundingClientRect().top ?? 0;
      const last = secs[secs.length - 1]?.getBoundingClientRect().bottom ?? 0;
      railEl.classList.toggle('is-shown', first < window.innerHeight * 0.6 && last > window.innerHeight * 0.3);
    };
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => ((ticking = false), update()));
      },
      { passive: true }
    );
    window.addEventListener('resize', update);
    update();
  }

  // Hero: "2 Years" counts down from 5 while the advised path draws.
  const count = document.querySelector<HTMLElement>('[data-countdown]');
  if (count && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    let n = 5;
    count.textContent = String(n);
    const step = window.setInterval(() => {
      n -= 1;
      count.textContent = String(n);
      if (n <= 2) window.clearInterval(step);
    }, 450);
  }

  // Related solutions: arrow buttons step the track by one card; each button
  // is disabled at its end. Touch, trackpad and keyboard scroll it natively.
  const track = document.getElementById('ts-rel-track');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.ts-arrow')];
  if (track && buttons.length) {
    const step = () => (track.querySelector<HTMLElement>('.ts-rel')?.offsetWidth ?? 300) + 20;
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      buttons.forEach((b) => (b.disabled = b.dataset.dir === '-1' ? track.scrollLeft <= 2 : track.scrollLeft >= max));
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: smooth ? 'smooth' : 'auto' });
      })
    );
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>

<style>
  :global(:root) {
    --ts-navy: #0a0f1d;
    --ts-navy-2: #111a30;
    --ts-violet: #7c5cf0;
    --ts-green: #16a34a;
    --ts-on-dark: #c7cedc;
  }
  .accent {
    color: var(--red);
  }
  h2 {
    font-size: clamp(2rem, 1.35rem + 2.1vw, 2.85rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .ts-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--gap-actions);
  }
  /* Small glass icon chip, tinted by --c. */
  .ts-glyph {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    color: var(--c, #fff);
    background: color-mix(in srgb, var(--c, #fff) 14%, rgba(255, 255, 255, 0.04));
    border: 1px solid color-mix(in srgb, var(--c, #fff) 30%, transparent);
    box-shadow: 0 8px 22px -12px var(--c, transparent);
  }
  .ts-glyph--soft {
    background: color-mix(in srgb, var(--c) 10%, #fff);
    border-color: color-mix(in srgb, var(--c) 18%, transparent);
  }
  /* Solid icon tile for cards. */
  .ts-tile {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    color: #fff;
    background: linear-gradient(145deg, color-mix(in srgb, var(--c) 82%, #fff), var(--c));
    box-shadow: 0 12px 24px -12px var(--c);
    transition: transform var(--ix-base) var(--ix-ease);
  }

  /* Dark sections share one palette: headings white, copy soft gray. */
  .ts-hero,
  .ts-case,
  .ts-plan,
  .ts-final {
    color: #fff;
  }
  .ts-hero :global(h1),
  .ts-case :global(h2),
  .ts-plan h2,
  .ts-final h2 {
    color: #fff;
  }
  .ts-hero :global(.eyebrow),
  .ts-case :global(.eyebrow),
  .ts-plan :global(.eyebrow),
  .ts-final :global(.eyebrow) {
    color: var(--ts-on-dark);
  }
  .ts-case :global(.lead) {
    color: var(--ts-on-dark);
  }

  /* ---------- 1. Hero ----------
     Copy at left; at right, the exit race (5 years → 2) drawn in SVG; the
     four promises along the foot. Tablets and phones:
     everything stacks, copy first. */
  /* Fills the first screen under the header, so no strip of the next
     section shows on load (Hemang, 2026-10-29). */
  .ts-hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(1.5rem, 3vw, 2.5rem);
    background:
      radial-gradient(50% 70% at 12% 30%, rgba(217, 64, 64, 0.14), transparent 70%),
      radial-gradient(45% 60% at 82% 40%, rgba(18, 136, 207, 0.16), transparent 70%),
      linear-gradient(rgba(140, 175, 235, 0.045) 1px, transparent 1px) 0 0 / 56px 56px,
      linear-gradient(90deg, rgba(140, 175, 235, 0.045) 1px, transparent 1px) 0 0 / 56px 56px,
      var(--ts-navy);
  }
  .ts-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }
  .ts-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--ts-on-dark);
  }
  .ts-crumbs a {
    color: #9fd3f5;
    text-decoration: none;
  }
  .ts-crumbs a:hover {
    text-decoration: underline;
  }
  .ts-hero h1 {
    font-size: clamp(2.3rem, 1.4rem + 2.7vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .ts-hero h1 .accent {
    display: block;
  }
  .ts-lede {
    margin-top: var(--gap-lead);
    max-width: 46ch;
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--ts-on-dark);
  }
  /* The exit timeline. */
  .ts-hero-side {
    display: grid;
    gap: 0.9rem;
  }
  .ts-exit {
    margin: 0;
    padding: 1.4rem 1.5rem 1.2rem;
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, rgba(30, 44, 84, 0.65), rgba(12, 18, 38, 0.85));
    border: 1px solid rgba(160, 200, 255, 0.18);
    box-shadow: 0 30px 70px -30px rgba(18, 136, 207, 0.5);
  }
  .ts-exit-kicker {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9fd3f5;
  }
  .ts-exit-big {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(1.8rem, 1.2rem + 1.8vw, 2.6rem);
    line-height: 1.1;
  }
  .ts-exit-big s {
    color: #8392b0;
    text-decoration-thickness: 3px;
    text-decoration-color: rgba(217, 64, 64, 0.8);
  }
  .ts-exit-big :global(svg) {
    color: #8392b0;
  }
  .ts-exit-big strong {
    color: #ff6b6b;
  }
  .ts-exit-big [data-countdown] {
    display: inline-block;
    min-width: 0.7em;
    text-align: center;
  }
  /* The exit race: two runners on one five-year grid. */
  .ts-race {
    margin-top: 2.6rem; /* room for the tags above the plot */
  }
  /* The drawing and its labels share one box, so labels land on the lines. */
  .race-plot {
    position: relative;
  }
  .ts-race svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 540 / 260;
    overflow: visible;
  }
  .race-col {
    stroke: rgba(255, 255, 255, 0.08);
    stroke-dasharray: 2 5;
    vector-effect: non-scaling-stroke;
  }
  .race-win {
    fill: rgba(217, 64, 64, 0.06);
    stroke: rgba(255, 120, 140, 0.18);
    stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke;
  }
  .race-slow {
    fill: none;
    stroke: rgba(170, 185, 215, 0.45);
    stroke-width: 2;
    stroke-dasharray: 5 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .race-area {
    fill: url(#ts-race-area);
  }
  .race-fast {
    fill: none;
    stroke: url(#ts-race-fast);
    stroke-width: 3.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1 1;
  }
  .race-trail {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 10 90;
    stroke-dashoffset: 10;
    opacity: 0;
    filter: drop-shadow(0 0 4px #ff9ab0);
  }
  .race-end-dim {
    fill: var(--ts-navy);
    stroke: rgba(170, 185, 215, 0.6);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .race-core {
    fill: #6ee7a8;
    transform-box: fill-box;
    transform-origin: center;
  }
  .race-check {
    fill: none;
    stroke: var(--ts-navy);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .race-ring {
    fill: none;
    stroke: #6ee7a8;
    stroke-width: 2;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .race-runner-fast {
    fill: #fff;
  }
  .race-runner-slow {
    fill: #a9b6d2;
  }
  @media (prefers-reduced-motion: reduce) {
    .race-runner,
    .race-trail {
      display: none;
    }
  }
  /* Labels, in HTML so they stay readable at any width. */
  .race-step,
  .race-tag,
  .race-ahead {
    position: absolute;
    font-family: var(--font-head);
    font-weight: 600;
    white-space: nowrap;
  }
  .race-step {
    width: 0;
    height: 0;
    font-size: 0.74rem;
  }
  .race-step i {
    position: absolute;
    left: -6px;
    top: -6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ts-navy);
    border: 2.5px solid #ff8fa3;
    box-shadow: 0 0 0 4px rgba(255, 143, 163, 0.15);
  }
  .race-step b {
    position: absolute;
    top: -0.65em;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    color: #fff;
    background: rgba(10, 15, 29, 0.85);
    border: 1px solid rgba(255, 143, 163, 0.35);
    cursor: default;
  }
  .race-step.is-r b {
    left: 12px;
  }
  .race-step.is-l b {
    right: 12px;
  }
  /* Hover a milestone: what it stands for (the Expedited Exits bullets). */
  .race-step em {
    position: absolute;
    top: 1.2em;
    z-index: 2;
    width: 13rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    font-style: normal;
    font-weight: 500;
    font-size: 0.78rem;
    line-height: 1.4;
    white-space: normal;
    color: var(--ink);
    background: #fff;
    box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.6);
    opacity: 0;
    translate: 0 4px;
    pointer-events: none;
    transition:
      opacity 200ms ease,
      translate 200ms var(--ix-ease);
  }
  .race-step.is-r em {
    left: 0;
  }
  .race-step.is-l em {
    right: 0;
  }
  .race-step:hover em {
    opacity: 1;
    translate: 0 0;
  }
  .race-tag {
    translate: -50% calc(-100% - 16px);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.74rem;
  }
  .race-tag-fast {
    color: var(--ts-navy);
    background: #6ee7a8;
    box-shadow: 0 8px 20px -8px rgba(110, 231, 168, 0.8);
  }
  .race-tag-slow {
    translate: -88% calc(-100% - 16px);
    color: #a9b6d2;
    background: var(--ts-navy);
    border: 1px dashed rgba(170, 185, 215, 0.45);
  }
  /* The gap between the two finishes: a line from tag to tag (both tags sit
     at the same height, 16px plus their own height above the finish line). */
  .race-gap,
  .race-ahead {
    position: absolute;
    left: 40.7%;
    right: 3.7%;
    top: 23.85%;
  }
  .race-gap {
    z-index: 0;
    height: 2px;
    translate: 0 calc(-16px - 0.85rem);
    background: linear-gradient(90deg, #6ee7a8, rgba(110, 231, 168, 0.35));
    transform-origin: left center;
  }
  .race-tag {
    z-index: 1;
  }
  .race-ahead {
    /* Centered between the two tags. */
    left: 48%;
    right: 19%;
    translate: 0 calc(-16px - 0.6rem);
    text-align: center;
    font-size: 0.72rem;
    color: #6ee7a8;
  }
  .race-years {
    margin: 0.55rem 3.7% 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    font-size: 0.7rem;
    color: #7f8cab;
    text-align: center;
  }
  .race-years .is-done {
    color: #ffb3c0;
    font-weight: 600;
  }

  /* Motion: the advised path draws in, the milestones arrive, exit-ready
     bursts, then both runners keep racing (9 s laps, the fast one arriving at
     40% of the lap, i.e. Year 2) — the end node flashes as it arrives. */
  @media screen and (prefers-reduced-motion: no-preference) {
    .race-fast {
      animation: race-draw 1.4s cubic-bezier(0.65, 0, 0.35, 1) 300ms backwards;
    }
    .race-area {
      animation: race-fade 900ms ease 1.2s backwards;
    }
    .race-step {
      animation: race-pop 500ms var(--ix-ease) backwards;
      animation-delay: calc(600ms + var(--i) * 250ms);
    }
    .race-end,
    .race-tag-fast {
      animation: race-pop 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 1.6s backwards;
    }
    .race-gap {
      animation: race-grow 900ms var(--ix-ease) 1.9s backwards;
    }
    .race-ahead,
    .race-tag-slow {
      animation: race-fade 600ms ease 2.4s backwards;
    }
    .race-ring {
      animation: race-ring 9s ease-out 1.6s infinite;
    }
    .race-ring-2 {
      animation-delay: 1.9s;
    }
    .race-trail {
      animation: race-trail 9s linear 1.6s infinite;
    }
    .race-core {
      animation: race-beat 9s ease-out 1.6s infinite;
    }
  }
  @keyframes race-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  @keyframes race-grow {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes race-fade {
    from {
      opacity: 0;
    }
  }
  @keyframes race-pop {
    from {
      opacity: 0;
      scale: 0.5;
    }
  }
  /* Rings burst as the fast runner arrives (40% of the lap). */
  @keyframes race-ring {
    0%,
    39% {
      opacity: 0;
      transform: scale(1);
    }
    40% {
      opacity: 0.9;
      transform: scale(1);
    }
    60%,
    100% {
      opacity: 0;
      transform: scale(3.2);
    }
  }
  @keyframes race-beat {
    0%,
    39%,
    52%,
    100% {
      transform: scale(1);
    }
    44% {
      transform: scale(1.35);
    }
  }
  /* A bright streak rides the advised path with the runner. */
  @keyframes race-trail {
    0% {
      opacity: 1;
      stroke-dashoffset: 10;
    }
    40% {
      opacity: 1;
      stroke-dashoffset: -90;
    }
    41%,
    100% {
      opacity: 0;
      stroke-dashoffset: -90;
    }
  }
  .ts-exit figcaption {
    margin-top: 0.9rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.78rem;
    line-height: 1.5;
    color: #a9b6d2;
  }
  .ts-benefits {
    list-style: none;
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    padding: 0.9rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    border-radius: var(--radius-lg);
    background: rgba(10, 15, 29, 0.62);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .ts-benefits li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0.6rem;
    font-size: 0.92rem;
    line-height: 1.35;
    color: #eef1f7;
  }
  .ts-benefits li + li {
    border-left: 1px solid rgba(255, 255, 255, 0.1);
  }
  @media (max-width: 1024px) {
    .ts-hero-grid {
      grid-template-columns: 1fr;
    }
    .ts-hero-side {
      max-width: 640px;
    }
    .ts-benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ts-benefits li:nth-child(3) {
      border-left: 0;
    }
  }
  @media (max-width: 560px) {
    .ts-benefits {
      grid-template-columns: 1fr;
    }
    .ts-benefits li + li {
      border-left: 0;
    }
    .ts-exit {
      padding: 1.1rem 1.1rem 1rem;
    }
    .race-years {
      font-size: 0.62rem;
    }
    /* Too little room between the tags: the caption below says it. */
    .race-ahead {
      display: none;
    }
  }

  /* ---------- 2. The challenge, and where engagements start ---------- */
  .ts-challenge-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .ts-challenge-grid :global(.section-heading) {
    margin-bottom: 0;
  }
  /* Three equal cards that run the full height of the heading and fork
     beside them, so the column has no empty tail (Hemang, 2026-10-29). */
  .ts-challenges {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-auto-rows: 1fr;
    gap: 1rem;
    align-self: stretch;
  }
  .ts-challenges li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-content: space-between;
    align-items: center;
    column-gap: 1.1rem;
    row-gap: 1rem;
    padding: 1.4rem 1.5rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(120deg, color-mix(in srgb, var(--c) 5%, #fff), #fff 55%);
    border: 1px solid var(--border);
    border-left: 3px solid var(--c);
    box-shadow: var(--shadow);
  }
  .ts-challenges h3 {
    font-size: 1.08rem;
    margin-bottom: 0.2rem;
  }
  .ts-challenges p {
    color: var(--text-2);
  }
  /* ---------- The challenge cards' pictures ----------
     Fill each card's lower half (Hemang, 2026-10-29). --p comes from the
     list's scrub: complete once the cards are wholly on screen. */
  .ch-art {
    grid-column: 1 / -1;
    position: relative;
  }
  /* 1. Options: four alike; the highlight never settles. */
  .ch-opts {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ch-opts span {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    height: 2rem;
    padding: 0 0.55rem;
    border-radius: 9px;
    background: #fff;
    border: 1px solid var(--border-2);
  }
  .ch-opts i {
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--border-2);
  }
  .ch-opts b {
    flex: 1;
    height: 4px;
    border-radius: 4px;
    background: var(--border);
  }
  .ch-opts em {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    font-family: var(--font-head);
    font-style: normal;
    font-weight: 800;
    font-size: 0.85rem;
    color: #fff;
    background: var(--red);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ch-opts span {
      animation: ch-hop 4s ease-in-out infinite;
      animation-delay: calc(var(--i) * 1s);
    }
    .ch-opts span i {
      animation: ch-hop-dot 4s ease-in-out infinite;
      animation-delay: calc(var(--i) * 1s);
    }
  }
  @keyframes ch-hop {
    0%,
    30%,
    100% {
      border-color: var(--border-2);
      box-shadow: none;
    }
    8%,
    22% {
      border-color: var(--red);
      box-shadow: 0 0 0 3px rgba(217, 64, 64, 0.14);
    }
  }
  @keyframes ch-hop-dot {
    0%,
    30%,
    100% {
      background: var(--border-2);
    }
    8%,
    22% {
      background: var(--red);
    }
  }
  /* 2. Risk: the marker slides from low to high. */
  .ch-risk {
    padding-bottom: 1.1rem;
  }
  .ch-risk-track {
    position: relative;
    display: block;
    height: 10px;
    border-radius: 10px;
    background: linear-gradient(90deg, #22c55e, #f59e0b 50%, var(--red));
  }
  .ch-risk-mark {
    position: absolute;
    top: 50%;
    left: calc(8% + var(--p, 1) * 80%);
    width: 20px;
    height: 20px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    border: 4px solid var(--ink);
    box-shadow: 0 4px 12px rgba(13, 13, 13, 0.2);
  }
  .ch-risk-low,
  .ch-risk-high {
    position: absolute;
    bottom: 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.7rem;
    color: var(--text-2);
  }
  .ch-risk-low {
    left: 0;
  }
  .ch-risk-high {
    right: 0;
  }
  /* 3. Alignment: three lanes whose markers line up. */
  .ch-align {
    display: grid;
    gap: 0.35rem;
    padding-right: 1.9rem;
  }
  .ch-lane {
    display: grid;
    grid-template-columns: 5.6rem minmax(0, 1fr);
    align-items: center;
    gap: 0.6rem;
  }
  .ch-lane small {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.7rem;
    color: var(--text-2);
  }
  .ch-lane-track {
    position: relative;
    height: 4px;
    border-radius: 4px;
    background: var(--border);
  }
  .ch-lane-track i {
    position: absolute;
    top: 50%;
    left: calc(var(--off) * (1 - var(--p, 1)) + 78% * var(--p, 1));
    width: 12px;
    height: 12px;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--ts-green);
    box-shadow: 0 0 0 3px rgba(22, 163, 74, 0.15);
  }
  .ch-align-check {
    position: absolute;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    color: #fff;
    background: var(--ts-green);
    opacity: clamp(0, (var(--p, 1) - 0.85) * 7, 1);
  }
  @media (max-width: 900px) {
    .ch-art {
      display: none;
    }
  }
  .ts-starts {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .ts-starts-title {
    margin-bottom: 1rem;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  .ts-start-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .ts-start-cards li {
    padding: 1.4rem;
    border-radius: 18px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--c) 6%, #fff), #fff 60%);
    border: 1px solid var(--border);
    border-top: 3px solid var(--c);
    box-shadow: var(--shadow);
  }
  .ts-start-cards h4 {
    margin: 1rem 0 0.35rem;
    font-size: 1.08rem;
    line-height: 1.3;
  }
  .ts-start-cards p {
    color: var(--text-2);
    line-height: 1.55;
  }
  @media (max-width: 900px) {
    .ts-challenge-grid,
    .ts-start-cards {
      grid-template-columns: 1fr;
    }
    .ts-challenges {
      grid-auto-rows: auto;
    }
  }

  /* ---------- 3. Advisory value ---------- */
  .ts-advisory {
    position: relative;
    isolation: isolate;
    color: #fff;
    background:
      radial-gradient(50% 60% at 0% 0%, rgba(217, 64, 64, 0.16), transparent 70%),
      radial-gradient(45% 60% at 100% 100%, rgba(18, 136, 207, 0.18), transparent 70%),
      var(--ts-navy);
  }
  .ts-advisory :global(h2) {
    color: #fff;
  }
  .ts-advisory :global(.eyebrow),
  .ts-advisory :global(.lead) {
    color: var(--ts-on-dark);
  }
  .ts-pillar-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .ts-pillar {
    padding: 1.6rem;
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, color-mix(in srgb, var(--c) 18%, rgba(20, 30, 60, 0.9)), rgba(12, 18, 38, 0.92));
    border: 1px solid color-mix(in srgb, var(--c) 45%, transparent);
  }
  .ts-pillar-k {
    margin-top: 1rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--c) 60%, #fff);
  }
  .ts-pillar h3 {
    margin-top: 0.2rem;
    font-size: 1.5rem;
    color: #fff;
  }
  .ts-pillar-lead {
    margin-top: 0.5rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: #e6ebf5;
  }
  .ts-pillar ul {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .ts-pillar li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ts-on-dark);
    line-height: 1.5;
  }
  .ts-pillar li::before {
    content: '';
    position: absolute;
    left: 0.15rem;
    top: 0.42em;
    width: 0.75rem;
    height: 0.4rem;
    border-left: 2px solid color-mix(in srgb, var(--c) 70%, #fff);
    border-bottom: 2px solid color-mix(in srgb, var(--c) 70%, #fff);
    transform: rotate(-45deg);
  }
  .ts-proof {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .ts-proof li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.2rem 1.25rem;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .ts-proof strong {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 1.9rem;
    line-height: 1.1;
    color: #ff6b6b;
  }
  .ts-proof span {
    color: #e6ebf5;
    line-height: 1.45;
  }
  .ts-proof small {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: 0.76rem;
    line-height: 1.45;
    color: #a9b6d2;
  }
  @media (max-width: 1024px) {
    .ts-proof {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .ts-pillar-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .ts-proof {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 4. Realized results (the shared Marquee) ---------- */
  .ts-results {
    background: linear-gradient(180deg, var(--bg), #fff);
  }
  .ts-results .section-heading {
    margin-bottom: 0.75rem;
  }
  .ts-results-note {
    max-width: 62ch;
    margin-bottom: 1.75rem;
    font-size: 0.9rem;
    color: var(--text-2);
  }
  /* One brand treatment for every card (Hemang, 2026-10-29: "make this card
     attractive and interactive"): the figure in the brand gradient, a
     gradient rule that sweeps across on hover, a cursor light (.ix-light)
     and a lift with a plum glow (.ix-card). */
  .ts-result {
    --c: var(--plum);
    flex: none;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    width: 19rem;
    height: 13.25rem;
    padding: 1.4rem 1.35rem 1.15rem;
    border-radius: 20px;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow:
      0 1px 2px rgba(13, 13, 13, 0.04),
      0 14px 34px -20px rgba(13, 13, 13, 0.28);
  }
  .ts-result::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background: var(--grad-h);
    transform: scaleX(0.22);
    transform-origin: left;
    transition: transform 600ms var(--ix-ease);
  }
  .ts-result strong {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .ts-result span {
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .ts-result small {
    display: flex;
    gap: 0.45rem;
    align-items: flex-start;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--text-2);
  }
  .ts-result small :global(svg) {
    flex: none;
    margin-top: 0.1rem;
    color: var(--plum);
  }
  /* Room inside the strip for the hover lift and glow (it clips overflow). */
  .ts-results :global(.mq-track) {
    padding-block: 0.6rem 1.6rem;
  }
  @media (hover: hover) and (pointer: fine) {
    :root .ts-result:hover {
      border-color: color-mix(in srgb, var(--plum) 35%, var(--border));
      box-shadow:
        0 1px 2px rgba(13, 13, 13, 0.04),
        0 26px 50px -22px rgba(135, 54, 98, 0.45);
    }
    .ts-result:hover::after {
      transform: scaleX(1);
    }
  }
  @media (max-width: 480px) {
    .ts-result {
      width: 16.5rem;
      height: 13.75rem;
    }
  }

  /* ---------- 5. Advisor profile ---------- */
  .ts-advisor-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .ts-advisor-grid .section-heading {
    margin-bottom: 0;
  }
  .ts-advisor-card {
    display: grid;
  }
  @media (max-width: 860px) {
    .ts-advisor-grid {
      grid-template-columns: 1fr;
    }
    .ts-advisor-card {
      max-width: 26rem;
    }
  }

  /* ---------- 6. Key areas of advisory support ---------- */
  .ts-areas {
    background: var(--section);
  }
  .ts-areas-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .ts-area-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .ts-area-tiles li {
    padding: 1.2rem;
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .ts-area-tiles h3 {
    margin: 0.85rem 0 0.3rem;
    font-size: 1rem;
    line-height: 1.3;
  }
  .ts-area-tiles p {
    color: var(--text-2);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  @media (max-width: 1024px) {
    .ts-areas-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .ts-area-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .ts-area-tiles {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 7. How we help: our approach ---------- */
  .ts-help {
    position: relative;
    isolation: isolate;
  }
  .ts-wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(40% 50% at 95% 10%, rgba(18, 136, 207, 0.08), transparent 70%),
      radial-gradient(36% 44% at 2% 90%, rgba(217, 64, 64, 0.07), transparent 72%);
  }
  .ts-help-head,
  .ts-split-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: var(--gap-block);
  }
  .ts-help-head :global(.section-heading),
  .ts-split-head :global(.section-heading) {
    margin-bottom: 0;
  }
  .ts-split-head > p {
    max-width: 44ch;
    color: var(--text-2);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .ts-help-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .ts-card {
    display: flex;
    flex-direction: column;
    padding: 1.4rem 1.4rem 1rem;
    border-radius: 20px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--c) 5%, #fff), #fff 45%);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .ts-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .ts-num {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--c);
    opacity: 0.8;
  }
  .ts-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }
  .ts-card p {
    color: var(--text-2);
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 1.1rem;
  }
  .ts-card img {
    display: block;
    width: 100%;
    height: auto;
    margin-top: auto;
    border-radius: 14px;
    aspect-ratio: 700 / 312;
    object-fit: cover;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .ts-card:hover .ts-tile,
    :global(.ts-outcome-cards li:hover) .ts-tile {
      transform: translateY(-2px) rotate(-4deg);
    }
  }
  @media (max-width: 1100px) {
    .ts-help-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .ts-help-cards {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 8. Industries we support ---------- */
  .ts-industry-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .ts-industry-tiles li {
    display: flex;
    flex-direction: column;
    padding: 1.4rem;
    border-radius: 18px;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
  .ts-industry-tiles h3 {
    margin-top: 1rem;
    font-size: 1.08rem;
    line-height: 1.3;
  }
  .ts-industry-tag {
    align-self: start;
    margin-top: 0.5rem;
    padding: 0.18rem 0.6rem;
    border-radius: 999px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text-2);
    background: var(--section);
    border: 1px solid var(--border);
  }
  .ts-industry-tag.is-tls {
    color: var(--red-text);
    background: var(--red-tint);
    border-color: var(--red-edge);
  }
  .ts-industry-tiles p {
    margin-top: 0.6rem;
    color: var(--text-2);
    font-size: 0.93rem;
    line-height: 1.55;
  }
  @media (max-width: 1024px) {
    .ts-industry-tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 520px) {
    .ts-industry-tiles {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 9. Outcomes (five) ---------- */
  .ts-outcome-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .ts-outcome-cards li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.3rem;
    border-radius: 18px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 6%, #fff), #fff 60%);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
  }
  @media (max-width: 1100px) {
    .ts-outcome-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .ts-outcome-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .ts-outcome-cards {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 6. Case study ---------- */
  .ts-case {
    background:
      radial-gradient(45% 70% at 100% 0%, rgba(18, 136, 207, 0.18), transparent 70%),
      radial-gradient(40% 60% at 0% 100%, rgba(217, 64, 64, 0.16), transparent 70%),
      var(--ts-navy);
  }
  .ts-case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .ts-case-card {
    padding: 1.6rem;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }
  .ts-case-tag {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #ff9a9a;
    margin-bottom: 0.6rem;
  }
  .ts-case-card h3 {
    color: #fff;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1.2;
    margin-bottom: 0.6rem;
  }
  .ts-case-card p {
    color: var(--ts-on-dark);
    line-height: 1.6;
  }
  .ts-case-visual {
    position: relative;
    isolation: isolate;
    margin: 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 40px 80px -50px rgba(0, 0, 0, 0.9);
    min-height: 420px;
    display: grid;
    align-items: end;
  }
  .ts-case-visual img {
    position: absolute;
    inset: -40px 0;
    width: 100%;
    height: calc(100% + 80px);
    object-fit: cover;
    z-index: -1;
  }
  .ts-case-visual::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(90deg, rgba(10, 15, 29, 0.92), rgba(10, 15, 29, 0.55) 60%, rgba(10, 15, 29, 0.25));
  }
  .ts-glance {
    list-style: none;
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    gap: 0.75rem;
    max-width: 30rem;
  }
  .ts-glance li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 0.75rem 0.9rem;
    border-radius: 14px;
    background: rgba(10, 15, 29, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    --c: #8ec9ff;
  }
  .ts-glance strong {
    display: block;
    font-family: var(--font-head);
    font-size: 1.15rem;
    color: #fff;
  }
  .ts-glance li > span:last-child > span {
    display: block;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ts-on-dark);
  }
  @media (max-width: 1024px) {
    .ts-case-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 8. Plan your next step ---------- */
  .ts-plan {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: linear-gradient(90deg, var(--ts-navy) 30%, #1a1426);
  }
  .ts-plan-photo {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(70%, 1100px);
    z-index: -1;
    --fade-x: linear-gradient(90deg, transparent 0, #000 40%);
    mask-image: var(--fade-x);
    -webkit-mask-image: var(--fade-x);
  }
  .ts-plan-photo img {
    width: 100%;
    height: calc(100% + 60px);
    margin-top: -30px;
    object-fit: cover;
    object-position: 70% 50%;
    opacity: 0.85;
  }
  .ts-plan-copy {
    max-width: 38rem;
  }
  .ts-plan-copy > p {
    margin-top: var(--gap-lead);
    color: var(--ts-on-dark);
    font-size: 1.08rem;
    line-height: 1.6;
  }
  .ts-trust {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .ts-trust li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.92rem;
    color: #eef1f7;
    --c: #ff9a9a;
  }
  .ts-trust .ts-glyph {
    width: 34px;
    height: 34px;
    border-radius: 10px;
  }
  @media (max-width: 860px) {
    .ts-plan-photo {
      width: 100%;
      opacity: 0.35;
      --fade-x: linear-gradient(90deg, transparent, #000);
    }
  }

  /* ---------- 10. Related solutions ---------- */
  .ts-related {
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }
  .ts-related-head {
    align-items: flex-end;
  }
  .ts-related-head .section-heading {
    max-width: 40rem;
  }
  .ts-related-side {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
  }
  .ts-related-side p {
    max-width: 40ch;
    color: var(--text-2);
    line-height: 1.6;
  }
  .ts-arrows {
    display: flex;
    gap: 0.5rem;
    flex: none;
  }
  .ts-arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    box-shadow: var(--shadow);
    transition:
      background-color var(--ix-base) var(--ix-ease),
      opacity var(--ix-base) var(--ix-ease);
  }
  .ts-arrow[data-dir='-1'] :global(svg) {
    transform: rotate(180deg);
  }
  .ts-arrow:hover:not(:disabled) {
    background: var(--section);
  }
  .ts-arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .ts-arrow:focus-visible {
    outline: 2px solid var(--blue-text);
    outline-offset: 2px;
  }
  .ts-rel-track {
    list-style: none;
    margin: 0;
    padding: 0.5rem max(var(--gutter), (100vw - var(--wrap)) / 2 + var(--gutter)) 1.5rem;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: max(var(--gutter), (100vw - var(--wrap)) / 2 + var(--gutter));
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .ts-rel-track::-webkit-scrollbar {
    display: none;
  }
  .ts-rel {
    flex: 0 0 clamp(250px, 23vw, 286px);
    scroll-snap-align: start;
  }
  .ts-rel-link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 20px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
  }
  .ts-rel-link:focus-visible {
    outline: 2px solid var(--blue-text);
    outline-offset: 3px;
  }
  .ts-rel-art {
    position: relative;
    height: 128px;
    overflow: hidden;
    background:
      radial-gradient(70% 90% at 80% 0%, color-mix(in srgb, var(--c) 55%, transparent), transparent 70%),
      linear-gradient(150deg, #17213d, var(--ts-navy));
  }
  .ts-rel-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }
  .ts-rel-mark {
    position: absolute;
    right: -6px;
    top: -10px;
    color: color-mix(in srgb, var(--c) 70%, #fff);
    opacity: 0.32;
  }
  .ts-rel-art .ts-tile {
    position: absolute;
    left: 1.1rem;
    bottom: 0.9rem;
  }
  .ts-rel-body {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 3.5rem 1.25rem 1.1rem;
  }
  .ts-rel-body strong {
    font-family: var(--font-head);
    font-size: 1.05rem;
  }
  .ts-rel-body span {
    color: var(--text-2);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .ts-rel-go {
    position: absolute;
    right: 1rem;
    bottom: 1.1rem;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    color: var(--c, var(--red));
    background: color-mix(in srgb, var(--c, var(--red)) 12%, #fff);
    transition: transform var(--ix-base) var(--ix-ease);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .ts-rel-link:hover .ts-rel-go,
    .ts-post:hover .ts-rel-go {
      transform: translateX(3px);
    }
  }
  @media (max-width: 760px) {
    .ts-related-side {
      width: 100%;
      justify-content: space-between;
    }
    .ts-rel {
      flex-basis: 78%;
    }
  }

  /* ---------- 11. Insights ---------- */
  .ts-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .ts-post {
    position: relative;
    display: flex;
    gap: 1rem;
    align-items: stretch;
    height: 100%;
    padding: 0.75rem 3.5rem 0.75rem 0.75rem;
    border-radius: 18px;
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    --c: var(--red);
  }
  .ts-post:focus-visible {
    outline: 2px solid var(--blue-text);
    outline-offset: 3px;
  }
  .ts-post img {
    flex: none;
    width: 112px;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 12px;
  }
  .ts-post-body {
    display: grid;
    align-content: center;
    gap: 0.4rem;
  }
  .ts-post-cat {
    justify-self: start;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--red-tint);
    color: var(--red-text);
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ts-post-body strong {
    font-family: var(--font-head);
    font-size: 0.98rem;
    line-height: 1.3;
  }
  .ts-post-time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.82rem;
    color: var(--text-2);
  }
  .ts-post .ts-rel-go {
    top: 50%;
    bottom: auto;
    margin-top: -17px;
  }
  @media (max-width: 1024px) {
    .ts-posts {
      grid-template-columns: 1fr;
      max-width: 640px;
    }
  }

  /* ---------- 12. Final CTA ---------- */
  .ts-final {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    background:
      radial-gradient(50% 80% at 100% 100%, rgba(217, 64, 64, 0.22), transparent 70%),
      var(--ts-navy);
  }
  .ts-final-waves {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
  }
  .ts-final-waves path {
    fill: none;
    stroke: url(#ts-wave-a);
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    .ts-final-waves {
      animation: ts-drift 20s ease-in-out infinite alternate;
    }
  }
  @keyframes ts-drift {
    to {
      transform: translateX(-3%) scaleY(1.06);
    }
  }
  .ts-final-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 2rem clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .ts-final-cta > p {
    color: var(--ts-on-dark);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  @media (max-width: 860px) {
    .ts-final-grid {
      grid-template-columns: 1fr;
    }
  }

  /* =====================================================================
     Scroll-driven diagrams (src/scripts/scroll/scrub.ts). Each one's "not
     yet" state lives under .is-scrub: without motion every diagram is
     complete and still. --p is the diagram's scroll progress (0–1).
     ===================================================================== */

  /* ---------- Section rail (wide screens) ---------- */
  .ts-rail {
    display: none;
  }
  @media (min-width: 1380px) {
    .ts-rail {
      --rail: 0;
      position: fixed;
      left: 1.25rem;
      top: 50%;
      z-index: 40;
      display: block;
      translate: -12px -50%;
      opacity: 0;
      pointer-events: none;
      transition:
        opacity 400ms var(--ix-ease),
        translate 400ms var(--ix-ease);
    }
    .ts-rail.is-shown {
      opacity: 1;
      translate: 0 -50%;
      pointer-events: auto;
    }
    .ts-rail ol {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.95rem;
      position: relative;
    }
    .ts-rail-track {
      position: absolute;
      left: 5px;
      top: 6px;
      bottom: 6px;
      width: 2px;
      border-radius: 2px;
      background: rgba(130, 140, 170, 0.25);
    }
    .ts-rail-track span {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(180deg, var(--red), var(--blue));
      transform-origin: top;
      transform: scaleY(var(--rail));
      transition: transform 500ms var(--ix-ease);
    }
    .ts-rail a {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.6rem;
      text-decoration: none;
      color: var(--text-2);
    }
    .ts-rail i {
      flex: none;
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: var(--bg);
      border: 2px solid rgba(130, 140, 170, 0.6);
      transition:
        background-color 300ms ease,
        border-color 300ms ease,
        box-shadow 300ms ease,
        scale 300ms var(--ix-ease);
    }
    .ts-rail a.is-past i {
      background: color-mix(in srgb, var(--red) 60%, var(--blue));
      border-color: transparent;
    }
    .ts-rail a.is-active i {
      scale: 1.35;
      background: var(--red);
      border-color: #fff;
      box-shadow: 0 0 0 4px rgba(217, 64, 64, 0.2);
    }
    .ts-rail span {
      padding: 0.2rem 0.55rem;
      border-radius: 999px;
      font-family: var(--font-head);
      font-weight: 600;
      font-size: 0.72rem;
      white-space: nowrap;
      color: #fff;
      background: var(--ink);
      opacity: 0;
      translate: -6px 0;
      transition:
        opacity 200ms ease,
        translate 200ms var(--ix-ease);
    }
    .ts-rail a:is(:hover, :focus-visible) span {
      opacity: 1;
      translate: 0 0;
    }
    /* The current section's name stays out only where the gutter has room. */
    @media (min-width: 1600px) {
      .ts-rail a.is-active span {
        opacity: 1;
        translate: 0 0;
      }
    }
    .ts-rail a:focus-visible {
      outline: none;
    }
    .ts-rail a:focus-visible i {
      box-shadow: 0 0 0 3px var(--blue-text);
    }
  }

  /* ---------- The challenge: decision fork ---------- */
  .ts-fork {
    position: relative;
    margin: 2rem 0 0;
    max-width: 34rem;
  }
  .ts-fork svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .fork-path {
    fill: none;
    stroke: var(--border-2);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1 0;
  }
  .fork-path.is-pick {
    stroke: color-mix(in srgb, var(--blue) 40%, var(--border-2));
  }
  .fork-glow {
    fill: none;
    stroke: url(#ts-fork-pick);
    stroke-width: 5;
    stroke-linecap: round;
    filter: drop-shadow(0 4px 8px rgba(18, 136, 207, 0.35));
  }
  .fork-off circle {
    fill: #fff;
    stroke: var(--border-2);
    stroke-width: 1.5;
  }
  .fork-off path {
    stroke: #94a3b8;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .fork-off {
    opacity: 0.55;
    transition: opacity 400ms ease;
  }
  .is-scrub .fork-off:not(.is-on) {
    opacity: 0;
  }
  .fork-start {
    fill: var(--ink);
    stroke: #fff;
    stroke-width: 3;
  }
  .fork-goal circle:not(.fork-goal-ring) {
    fill: var(--blue);
  }
  .fork-goal-ring {
    fill: rgba(18, 136, 207, 0.15);
    stroke: rgba(18, 136, 207, 0.4);
  }
  .fork-goal path {
    fill: none;
    stroke: #fff;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .fork-goal {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 400ms ease,
      scale 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .is-scrub .fork-goal:not(.is-on) {
    opacity: 0;
    scale: 0.4;
  }
  .fork-label {
    position: absolute;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.78rem;
    white-space: nowrap;
    transition: opacity 400ms ease;
  }
  .fork-label-start {
    left: 0;
    top: calc(112 / 224 * 100% + 14px);
    color: var(--ink);
  }
  .fork-label-many {
    left: 44%;
    bottom: -1.4rem;
    color: var(--text-2);
  }
  .fork-label-goal {
    right: calc(8.1% + 14px);
    top: calc(58 / 224 * 100%);
    translate: 0 -50%;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    color: #fff;
    background: var(--blue-text);
  }
  .is-scrub .fork-label[data-at]:not(.is-on) {
    opacity: 0;
  }

  /* ---------- Where engagements start: each picture resolves ---------- */
  .ts-start-cards li {
    position: relative;
  }
  .ts-start-art {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    width: 104px;
    height: auto;
  }
  .st-doc {
    fill: #fff;
    stroke: var(--border-2);
    stroke-width: 1.5;
  }
  .st-lines,
  .st-text,
  .st-axis {
    fill: none;
    stroke: var(--border-2);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .st-axis {
    stroke-width: 1.5;
  }
  .st-bad circle {
    fill: var(--red);
  }
  .st-good circle {
    fill: var(--ts-green);
  }
  .st-bad path,
  .st-good path {
    fill: none;
    stroke: #fff;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .st-bad,
  .st-good {
    transition: opacity 350ms ease;
  }
  .st-bad {
    opacity: 0;
  }
  .is-scrub .st-swap:not(.is-on) .st-bad {
    opacity: 1;
  }
  .is-scrub .st-swap:not(.is-on) .st-good {
    opacity: 0;
  }
  .st-trend {
    fill: none;
    stroke: var(--blue);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .st-low {
    fill: var(--red);
  }
  .st-high {
    fill: var(--ts-green);
    stroke: #fff;
    stroke-width: 2;
  }
  .st-low,
  .st-high {
    transition: opacity 300ms ease;
  }
  .is-scrub :is(.st-low, .st-high):not(.is-on) {
    opacity: 0;
  }
  .st-row rect {
    fill: #fff;
    stroke: var(--border-2);
    stroke-width: 1.5;
    transition:
      fill 300ms ease,
      stroke 300ms ease;
  }
  .st-row.is-on rect,
  .ts-start-cards:not(.is-scrub) .st-row rect {
    fill: var(--ts-violet);
    stroke: var(--ts-violet);
  }
  .st-tick {
    fill: none;
    stroke: #fff;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: opacity 300ms ease;
  }
  .is-scrub .st-row:not(.is-on) .st-tick {
    opacity: 0;
  }

  /* ---------- Pillar 1: five years compress into two ----------
     A timed motion graphic (sequence.ts), stages 0–6:
     0 the five-year plan · 1 a light sweeps it · 2–4 Years 5, 4, 3 fold away
     (the counter rolls 5 → 2) · 5 the two kept years light up · 6 Exit-ready.
     At rest (reduced motion, no JS) the finished picture. */
  .ts-compress {
    margin-top: 1.1rem;
  }
  .yb-count {
    display: flex;
    align-items: baseline;
    gap: 0.1rem;
    margin: 0 0 0.5rem;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.85rem;
    color: #a9b6d2;
  }
  .yb-odo {
    display: inline-block;
    height: 1.6rem;
    overflow: hidden;
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
    color: #fff;
  }
  .yb-digits {
    display: flex;
    flex-direction: column;
    translate: 0 calc(var(--k, 3) * -1.6rem);
    transition: translate 700ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .yb-digits span {
    height: 1.6rem;
    text-align: right;
  }
  .yb-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.4rem;
  }
  .yb {
    flex: 1;
    display: grid;
    place-items: center;
    height: 100%;
    overflow: hidden;
    border-radius: 10px;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.75rem;
    white-space: nowrap;
    color: #fff;
    background: linear-gradient(135deg, var(--red), #b04a8f);
    box-shadow: 0 10px 24px -12px rgba(217, 64, 64, 0.8);
    transition:
      flex 850ms cubic-bezier(0.65, 0, 0.35, 1),
      margin 850ms cubic-bezier(0.65, 0, 0.35, 1),
      opacity 600ms ease,
      translate 850ms cubic-bezier(0.65, 0, 0.35, 1),
      background 500ms ease,
      color 500ms ease,
      box-shadow 500ms ease;
  }
  /* Years 3–5 are gone at rest (the plan delivered in two). */
  .yb:not(.is-kept) {
    flex: 0 0 0;
    margin-inline: -0.175rem;
    opacity: 0;
    translate: -40% 0;
  }
  .yb-flag {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--ts-navy);
    background: #6ee7a8;
    transition:
      opacity 400ms ease,
      scale 600ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .yb-note {
    display: block;
    margin-top: 0.55rem;
    font-size: 0.8rem;
    color: #6ee7a8;
    transition: opacity 500ms ease;
  }

  /* The sequence. "Still in the plan" for each year, by stage. */
  .is-seq:is([data-stage='0'], [data-stage='1']) .yb[data-y='5'],
  .is-seq:is([data-stage='0'], [data-stage='1'], [data-stage='2']) .yb[data-y='4'],
  .is-seq:is([data-stage='0'], [data-stage='1'], [data-stage='2'], [data-stage='3']) .yb[data-y='3'] {
    flex: 1;
    margin-inline: 0;
    opacity: 1;
    translate: 0 0;
  }
  /* Until stage 5 every year is the plain plan. */
  .is-seq:not([data-stage='5'], [data-stage='6']) .yb {
    background: rgba(255, 255, 255, 0.08);
    color: #a9b6d2;
    box-shadow: none;
  }
  /* Stage 5: the two kept years light up. */
  .is-seq[data-stage='5'] .yb.is-kept {
    animation: yb-pop 600ms ease-out;
  }
  @keyframes yb-pop {
    50% {
      box-shadow: 0 0 0 6px rgba(217, 64, 64, 0.25), 0 10px 24px -12px rgba(217, 64, 64, 0.8);
    }
  }
  /* Stage 1: a light sweeps the five-year plan. */
  .yb-row::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 22%;
    border-radius: 10px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.22), transparent);
    opacity: 0;
    pointer-events: none;
  }
  .is-seq[data-stage='1'] .yb-row::after {
    animation: yb-sweep 1000ms ease-in-out;
  }
  @keyframes yb-sweep {
    0% {
      opacity: 1;
      translate: -20% 0;
    }
    100% {
      opacity: 1;
      translate: 460% 0;
    }
  }
  /* The counter: 5, then one down per folded year. */
  .is-seq:is([data-stage='0'], [data-stage='1']) .yb-digits {
    --k: 0;
  }
  .is-seq[data-stage='2'] .yb-digits {
    --k: 1;
  }
  .is-seq[data-stage='3'] .yb-digits {
    --k: 2;
  }
  /* Exit-ready and the note arrive last. */
  .is-seq:not([data-stage='6']) :is(.yb-flag, .yb-note) {
    opacity: 0;
  }
  .is-seq:not([data-stage='6']) .yb-flag {
    scale: 0.6;
  }

  /* ---------- Pillar 2: noisy signals converge into one view ---------- */
  .ts-signal {
    position: relative;
    margin: 1.1rem 0 0.4rem;
    padding-bottom: 1.4rem;
    container-type: inline-size;
  }
  .ts-signal svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .sig-noise {
    fill: none;
    stroke: rgba(160, 185, 230, 0.5);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .sig-clean {
    fill: none;
    stroke: #4fb6ff;
    stroke-width: 3.5;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px rgba(79, 182, 255, 0.8));
  }
  .sig-node {
    fill: #4fb6ff;
  }
  .sig-node-ring {
    fill: rgba(79, 182, 255, 0.18);
    stroke: rgba(79, 182, 255, 0.5);
  }
  .sig-node,
  .sig-node-ring {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 400ms ease,
      scale 500ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .is-scrub :is(.sig-node, .sig-node-ring):not(.is-on) {
    opacity: 0;
    scale: 0.3;
  }
  .sig-label {
    position: absolute;
    bottom: 0;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.72rem;
    white-space: nowrap;
    color: #a9b6d2;
    transition: opacity 400ms ease;
  }
  .sig-label-l {
    left: 0;
  }
  /* Above its node: clear of the two captions below. */
  .sig-label-m {
    left: 50.6%;
    bottom: auto;
    top: calc((100% - 1.4rem) * 0.3);
    translate: -50% -100%;
    color: #8fd0ff;
  }
  .sig-label-r {
    right: 0;
    color: #8fd0ff;
  }
  .is-scrub .sig-label[data-at]:not(.is-on) {
    opacity: 0;
  }
  /* Too narrow for both captions in one row: keep the outcome. */
  @container (max-width: 440px) {
    .sig-label-l {
      display: none;
    }
  }

  /* ---------- Key areas: the strategy hub ---------- */
  .ts-hub {
    margin: 1.5rem auto 0;
    max-width: 21rem;
  }
  .ts-hub svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .hub-orbit {
    fill: none;
    stroke: var(--border-2);
    stroke-dasharray: 3 7;
  }
  .hub-orbit-2 {
    stroke-dasharray: 2 5;
    opacity: 0.6;
  }
  @media screen and (prefers-reduced-motion: no-preference) {
    .hub-orbit {
      transform-box: fill-box;
      transform-origin: center;
      animation: hub-spin 40s linear infinite;
    }
    .hub-orbit-2 {
      animation-direction: reverse;
      animation-duration: 28s;
    }
  }
  @keyframes hub-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .hub-spoke {
    fill: none;
    stroke: color-mix(in srgb, var(--blue) 45%, var(--border-2));
    stroke-width: 2;
    stroke-linecap: round;
    transition:
      stroke 250ms ease,
      stroke-width 250ms ease;
  }
  .hub-node circle {
    fill: #fff;
    stroke: var(--blue);
    stroke-width: 2;
    transition:
      fill 250ms ease,
      stroke 250ms ease;
  }
  .hub-node text {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: 15px;
    text-anchor: middle;
    fill: var(--ink);
  }
