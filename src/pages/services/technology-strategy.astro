---
/**
 * Technology Strategy — executive technology strategy, led by TLS's advisor
 * Dr. Wally Potts (Hemang's brief and Wally's requests, 2026-10-28; earlier
 * version: Hemang's brief and fold references, 2026-10-06). Replaces the
 * short [solution].astro page for this route.
 *
 * DRAFT pending Dr. Potts's approval: not published until Hemang's go-ahead.
 *
 * Proof, two kinds, kept apart:
 * - The advisor's own results (src/data/advisor.ts): his resume's role-level
 *   bullets, every figure credited to his role, employer and years — a
 *   page-scoped exception to the six-metric rule (Hemang, 2026-10-28).
 * - TLS's own work: the "Six Account Tiers" case study and published
 *   Insights. (The reviews reel, client logos and FAQ were removed on
 *   2026-10-28, Hemang: Tali answers the questions.)
 * Scope guardrail: Dr. Potts leads strategy and guidance; TLS teams and
 * partners do the hands-on implementation.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Button from '../../components/Button.astro';
import Icon from '../../components/Icon.astro';
import Marquee from '../../components/Marquee.astro';
import TeamCard from '../../components/TeamCard.astro';
import type { IconName } from '../../components/iconTypes';
import { cta, href, site, canonicalUrl } from '../../data/site';
import { solutions } from '../../data/services';
import { categoryMeta, getPublishedPosts } from '../../data/insights';
import { advisor, proofTiles, results } from '../../data/advisor';
import { parseMetric, formatMetric } from '../../scripts/metric';

const img = (f: string) => href(`/solutions/technology-strategy/${f}`);
const booking = { label: 'Book a Free 30-Minute Call', href: site.booking };
const PATH_URL = '/services/technology-strategy/';

const title = 'True Lean Solutions — Executive Technology Strategy';
const description =
  'Executive technology strategy for growing and PE-backed firms: faster exits, AI enablement, MADO (mergers, acquisitions, divestitures) and rationalization.';

type Accent = 'red' | 'blue' | 'plum' | 'green';
const tone: Record<Accent, string> = { red: 'var(--red)', blue: 'var(--blue)', plum: 'var(--ts-violet)', green: 'var(--ts-green)' };

/* 1. Hero */
const benefits: { text: string; icon: IconName; c: Accent }[] = [
  { text: 'Business-first perspective', icon: 'target', c: 'red' },
  { text: 'Executive experience in small, medium and Fortune 50 companies', icon: 'briefcase', c: 'blue' },
  { text: 'Technology-agnostic advice', icon: 'integration', c: 'plum' },
  { text: 'Support from strategy to execution', icon: 'users', c: 'green' },
];

/* Hero visual: the exit race. A 540 × 260 drawing, five years left to right
   (100 units each). The advised path climbs to exit-ready at the end of Year
   2; the typical plan winds to the top at Year 5. HTML labels sit on it by
   percentage, so they stay readable at any width. */
const RW = 540;
const RH = 260;
type P = [number, number];
const cubic = (p0: P, c1: P, c2: P, p3: P, t: number): P => {
  const u = 1 - t;
  return [0, 1].map((k) => u * u * u * p0[k] + 3 * u * u * t * c1[k] + 3 * u * t * t * c2[k] + t * t * t * p3[k]) as P;
};
const FAST_A: [P, P, P, P] = [[20, 230], [80, 226], [112, 202], [140, 170]];
const FAST_B: [P, P, P, P] = [[140, 170], [168, 138], [196, 92], [220, 62]];
const FAST = `M20 230 C80 226 112 202 140 170 S196 92 220 62`;
const SLOW = 'M20 230 C120 229 200 218 280 196 S420 120 520 62';
const raceSteps: { t: string; tip: string; at: P; side: 'l' | 'r' }[] = [
  { t: 'Roadmap', tip: 'Define and execute a clear two-year roadmap', at: cubic(...FAST_A, 0.62), side: 'r' },
  { t: 'Priorities', tip: 'Prioritize the initiatives that drive valuation', at: cubic(...FAST_B, 0.3), side: 'r' },
  { t: 'Alignment', tip: 'Align people, processes and technology for a successful exit', at: cubic(...FAST_B, 0.7), side: 'l' },
];
const pct = (p: P) => `left: ${((p[0] / RW) * 100).toFixed(2)}%; top: ${((p[1] / RH) * 100).toFixed(2)}%`;

/* The page's section rail (wide screens): one dot per section, lit as you read. */
const rail = [
  { id: 'challenge', label: 'The challenge' },
  { id: 'advisory', label: 'Advisory value' },
  { id: 'results', label: 'Realized results' },
  { id: 'advisor', label: 'The advisor' },
  { id: 'areas', label: 'Key areas' },
  { id: 'approach', label: 'Our approach' },
  { id: 'industries', label: 'Industries' },
  { id: 'outcomes', label: 'Outcomes' },
];

/* Decision fork (The Challenge): six options leave "Today"; one stays aligned. */
const FORK_YS = [22, 58, 94, 130, 166, 202];
const FORK_PICK = 1;
const fork = FORK_YS.map((y, i) => ({ i, y, d: `M28 112 C150 112 250 ${y} 478 ${y}` }));

/* Strategy hub (Key Areas): six areas around one strategy. */
const hub = Array.from({ length: 6 }, (_, i) => {
  const a = (-90 + i * 60) * (Math.PI / 180);
  return { i, x: +(160 + 118 * Math.cos(a)).toFixed(1), y: +(160 + 118 * Math.sin(a)).toFixed(1) };
});

/* Count-up starting state for the proof tiles ("$0", "0+ years"). */
const zeroOf = (v: string) => {
  const m = parseMetric(v);
  return m ? formatMetric(m, 0) : undefined;
};

/* 2. The challenge, and where engagements start */
const challenges: { title: string; text: string; icon: IconName; c: Accent }[] = [
  { title: 'Multiple competing options', text: "It's not always clear which path is right.", icon: 'integration', c: 'red' },
  { title: 'Higher financial and operational risk', text: 'The cost of getting it wrong is real.', icon: 'alert', c: 'blue' },
  { title: 'Need for business and technology alignment', text: 'People, processes and technology must work together.', icon: 'workflow', c: 'green' },
];
const starts: { title: string; text: string; icon: IconName; c: Accent }[] = [
  { title: 'A government cure notice to resolve', text: 'A contract is at risk and needs a credible plan to restore performance.', icon: 'document', c: 'red' },
  { title: 'A major miss with a key customer to correct', text: 'A Fortune 100 relationship needs a clear recovery plan and rebuilt confidence.', icon: 'users', c: 'blue' },
  { title: 'A sale to prepare for', text: 'The company must be ready for buyers and prove its quality of earnings.', icon: 'briefcase', c: 'plum' },
];

/* 3. Advisory value: the two pillars */
const exitBullets = [
  'Define and execute a clear two-year roadmap',
  'Prioritize the initiatives that drive valuation',
  'Align people, processes and technology for a successful exit',
];
const aiBullets = [
  'Identify where AI, AIOps and analytics can improve how operations run',
  'Experience leading an AIOps, analytics and monitoring transformation that consolidated tools and improved mean time to resolution (TISTA, 2021–2022)',
  'Author of “Best Practices Implementing AIOps in Large Organizations” (IEEE, 2024)',
];

/* 6. Key areas of advisory support (descriptions: the v2 mockup) */
const areas: { title: string; text: string; icon: IconName; c: Accent }[] = [
  { title: 'Technology Direction & Architecture', text: 'Define the right technology foundation and roadmap.', icon: 'compass', c: 'blue' },
  { title: 'Risk Assessment & Decision Support', text: 'Identify risks, evaluate options, and make better decisions.', icon: 'shield', c: 'red' },
  { title: 'Operational Transformation', text: 'Improve processes, efficiency, and performance.', icon: 'gear', c: 'plum' },
  { title: 'Cloud, Data & AI Modernization', text: 'Build scalable, secure, and flexible infrastructure.', icon: 'cloud', c: 'blue' },
  { title: 'Execution Planning & Partner Alignment', text: 'Bridge strategy and execution with the right partners.', icon: 'checklist', c: 'green' },
  { title: 'Strategic Transitions & Acquisition Readiness', text: 'Prepare for growth, change, and long-term value.', icon: 'chart', c: 'plum' },
];

/* 7. How we help + our approach (one section; the hero's anchor lands here) */
const help: { title: string; text: string; icon: IconName; c: Accent; img: string; alt: string }[] = [
  {
    title: 'Assess Current State',
    text: 'Understand your business goals, processes and existing systems to identify gaps and opportunities.',
    icon: 'search',
    c: 'red',
    img: 'card-1.webp',
    alt: 'A laptop showing dashboards, with panels labeled Systems, Processes and People.',
  },
  {
    title: 'Identify Opportunities',
    text: 'Find areas where technology can improve efficiency, visibility and results, including application and system rationalization.',
    icon: 'database',
    c: 'blue',
    img: 'card-2.webp',
    alt: 'A planning wall of notes, with panels labeled Automation Opportunities, Integration Possibilities and AI & Data Use Cases.',
  },
  {
    title: 'Create a Roadmap',
    text: 'Define the right solutions, priorities, timelines and implementation approach.',
    icon: 'document',
    c: 'plum',
    img: 'card-3.webp',
    alt: 'A phased technology roadmap for enterprise transformation: Phase 1 Quick Wins, Phase 2 Core Solutions, Phase 3 Scale & Optimize.',
  },
  {
    title: 'Support Execution',
    text: 'Work with your team to ensure successful adoption, measure impact and adjust as you grow.',
    icon: 'users',
    c: 'green',
    img: 'card-4.webp',
    alt: 'A team at work, with checklist panels for Implementation Support, Change Management and Measure Results.',
  },
];

/* 8. Industries: "advisor experience" where the only evidence is Dr. Potts's resume. */
const industries: { title: string; text: string; icon: IconName; c: Accent; advisorOnly: boolean }[] = [
  { title: 'Private Equity & Portfolio Companies', text: 'Portfolio companies facing a major technology decision or preparing for a sale.', icon: 'briefcase', c: 'red', advisorOnly: true },
  { title: 'Enterprise & Corporate', text: 'Large, complex environments with many systems, vendors and teams.', icon: 'server', c: 'blue', advisorOnly: true },
  { title: 'Federal & Healthcare', text: 'Mission-critical systems where performance and continuity matter most.', icon: 'shield', c: 'plum', advisorOnly: true },
  { title: 'Growing Small & Mid-Sized Businesses', text: 'The businesses TLS is built for: everything we do is scoped and priced for the constraints you work under.', icon: 'users', c: 'green', advisorOnly: false },
];

/* 9. Business outcomes */
const outcomes: { text: string; icon: IconName; c: Accent }[] = [
  { text: 'Faster outcomes', icon: 'rocket', c: 'red' },
  { text: 'Reduced risk', icon: 'shield', c: 'blue' },
  { text: 'Greater efficiency', icon: 'gear', c: 'plum' },
  { text: 'Higher valuation', icon: 'chart', c: 'green' },
  { text: 'Long-term value', icon: 'target', c: 'red' },
];

/* Real proof: the case study's own facts, verbatim from its post. */
const posts = await getPublishedPosts();
const caseStudy = posts.find((p) => p.id === 'six-account-tiers-one-source-of-truth');
const glance =
  caseStudy?.data.blocks.find((b): b is Extract<typeof b, { type: 'stats' }> => b.type === 'stats')?.items ?? [];
const caseIcons: IconName[] = ['users', 'compass', 'software', 'process'];


/* Related solutions: real routes only, each with its approved one-line summary. */
const related: { title: string; text: string; href: string; icon: IconName; c: Accent; photo?: string }[] = [
  ...['/services/enterprise-ai/'].map((h) => solutions.find((s) => s.href === h)!).map((s) => ({ title: s.title, text: s.summary, href: s.href, icon: s.icon, c: 'red' as Accent })),
  { title: 'Meeting Intelligence', text: 'Turn every meeting into secure, searchable knowledge.', href: '/services/meeting-intelligence/', icon: 'video', c: 'blue', photo: href('/solutions/meeting-intelligence/hero-900.webp') },
  ...[
    ['/services/workflow-automation/', 'plum'],
    ['/services/data-analytics/', 'green'],
    ['/services/integrations/', 'blue'],
    ['/services/software/', 'red'],
    ['/services/cyber-security/', 'plum'],
    ['/services/technical-talent/', 'green'],
  ].map(([h, c]) => {
    const s = solutions.find((x) => x.href === h)!;
    return { title: s.title, text: s.summary, href: s.href, icon: s.icon, c: c as Accent };
  }),
];

/* Insights on making technology decisions (real posts, as published). */
const insightIds = ['why-your-software-implementation-failed', 'home-grown-erp-vs-off-the-shelf', 'custom-integrations-connect-instead-of-replace'];
const insights = insightIds.map((id) => posts.find((p) => p.id === id)).filter((p): p is NonNullable<typeof p> => !!p);

/* Structured data: the page and its advisor (resume-supported fields only). */
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl(PATH_URL)}#webpage`,
      url: canonicalUrl(PATH_URL),
      name: title,
      description,
      keywords:
        'technology strategy, executive technology strategy, MADO strategy, mergers, acquisitions, divestitures, enterprise transformation, application rationalization, system rationalization, AI enablement, AIOps, mean time to resolution (MTTR) improvement, acquisition readiness',
      isPartOf: { '@type': 'WebSite', name: site.name, url: canonicalUrl('/') },
      about: { '@id': `${canonicalUrl(PATH_URL)}#advisor` },
    },
    {
      '@type': 'Person',
      '@id': `${canonicalUrl(PATH_URL)}#advisor`,
      name: `${advisor.name}, ${advisor.credentials}`,
      jobTitle: advisor.title,
      sameAs: [advisor.linkedin],
      alumniOf: advisor.alumniOf.map((name) => ({ '@type': 'CollegeOrUniversity', name })),
    },
  ],
};
---

<BaseLayout title={title} description={description} path={PATH_URL}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <!-- 1. Hero -->
  <section class="ts-hero">
    <div class="wrap ts-hero-grid">
      <div class="ts-hero-copy" data-reveal="load">
        <nav class="ts-crumbs" aria-label="Breadcrumb">
          <a href={href('/services/')}>Solutions</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Technology Strategy</span>
        </nav>
        <Eyebrow label="Executive Technology Strategy" />
        <h1>Accelerate Business Outcomes with <span class="accent">Proven Expertise.</span></h1>
        <p class="ts-lede">
          Get senior-level perspective to make the right technology decisions, enable AI and accelerate strategic outcomes — including successful exits.
        </p>
        <div class="ts-actions">
          <Button href={cta.primary.href} variant="primary" arrow>{cta.primary.label}</Button>
        </div>
      </div>

      <div class="ts-hero-side">
        <figure class="ts-exit">
          <p class="ts-exit-kicker">From Strategy to Successful Exit</p>
          <p class="ts-exit-big">
            <s>5 Years</s>
            <Icon name="arrow" size={26} />
            <strong><span data-countdown>2</span> Years</strong>
          </p>
          <div class="ts-race" aria-hidden="true">
            <div class="race-plot">
            <svg viewBox={`0 0 ${RW} ${RH}`} preserveAspectRatio="none">
              <defs>
                <linearGradient id="ts-race-fast" gradientUnits="userSpaceOnUse" x1="20" y1="230" x2="220" y2="62">
                  <stop offset="0" stop-color="#ff5a6e" />
                  <stop offset="0.55" stop-color="#c25bd6" />
                  <stop offset="1" stop-color="#4fb6ff" />
                </linearGradient>
                <linearGradient id="ts-race-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#c25bd6" stop-opacity="0.35" />
                  <stop offset="1" stop-color="#c25bd6" stop-opacity="0" />
                </linearGradient>
                <filter id="ts-race-glow" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="4" result="b" />
                  <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
                </filter>
              </defs>
              {[120, 220, 320, 420].map((x) => <line class="race-col" x1={x} x2={x} y1="20" y2="238" />)}
              <rect class="race-win" x="20" y="20" width="200" height="218" rx="10" />
              <path class="race-slow" d={SLOW} />
              <path class="race-area" d={`${FAST} L220 238 L20 238 Z`} />
              <path class="race-fast" d={FAST} pathLength="1" />
              <path class="race-trail" d={FAST} pathLength="100" />
              <circle class="race-end-dim" cx="520" cy="62" r="6" />
              <g class="race-end">
                <circle class="race-ring" cx="220" cy="62" r="11" />
                <circle class="race-ring race-ring-2" cx="220" cy="62" r="11" />
                <circle class="race-core" cx="220" cy="62" r="11" filter="url(#ts-race-glow)" />
                <path class="race-check" d="M214.5 62 L218.5 66 L226 57.5" />
              </g>
              <circle class="race-runner race-runner-slow" r="4.5">
                <animateMotion dur="9s" begin="1.6s" repeatCount="indefinite" path={SLOW} />
              </circle>
              <circle class="race-runner race-runner-fast" r="6" filter="url(#ts-race-glow)">
                <animateMotion dur="9s" begin="1.6s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;0.4;1" calcMode="linear" path={FAST} />
              </circle>
            </svg>
            <span class="race-gap"></span>
            <span class="race-ahead">Three years ahead of plan</span>
            {
              raceSteps.map((s, i) => (
                <span class:list={['race-step', `is-${s.side}`]} style={`${pct(s.at)}; --i: ${i}`}>
                  <i />
                  <b>{s.t}</b>
                  <em>{s.tip}</em>
                </span>
              ))
            }
            <span class="race-tag race-tag-fast" style={pct([220, 62])}>Exit-ready</span>
            <span class="race-tag race-tag-slow" style={pct([520, 62])}>Original plan</span>
            </div>
            <div class="race-years">
              {[1, 2, 3, 4, 5].map((y) => <span class:list={[{ 'is-done': y <= 2 }]}>Year {y}</span>)}
            </div>
          </div>
          <figcaption>
            Advisor experience: Dr. Wally Potts, VP, Advisory Services, Veterans Engineering (acquired by Aretum), 2022–2026 — acquisition readiness three years
            ahead of plan.
          </figcaption>
        </figure>
      </div>
    </div>
    <div class="wrap">
      <ul class="ts-benefits" data-reveal="stagger" aria-label="What to expect">
        {
          benefits.map((b) => (
            <li style={`--c: ${tone[b.c]}`}>
              <span class="ts-glyph" aria-hidden="true">
                <Icon name={b.icon} size={20} />
              </span>
              {b.text}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Section rail: where you are on the page (wide screens) -->
  <nav class="ts-rail" aria-label="On this page" data-rail>
    <span class="ts-rail-track" aria-hidden="true"><span class="ts-rail-fill"></span></span>
    <ol>
      {
        rail.map((r) => (
          <li>
            <a href={`#${r.id}`} class="glide" data-rail-link={r.id}>
              <i aria-hidden="true" />
              <span>{r.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <!-- 2. The challenge, and where engagements start -->
  <section class="section ts-challenge" id="challenge">
    <div class="wrap">
      <div class="ts-challenge-grid">
        <div>
        <SectionHeading
          eyebrow="The Challenge"
          title="Technology decisions shape your business "
          accent="for years."
          lead="New technologies, market changes and growing customer expectations create difficult decisions. Without the right perspective, it's easy to invest in the wrong solutions, underestimate risk, or miss opportunities for growth."
        />
        <figure class="ts-fork" data-scrub aria-hidden="true">
          <svg viewBox="0 0 520 224">
            <defs>
              <linearGradient id="ts-fork-pick" gradientUnits="userSpaceOnUse" x1="28" y1="0" x2="478" y2="0">
                <stop offset="0" stop-color="#D94040" />
                <stop offset="0.6" stop-color="#873662" />
                <stop offset="1" stop-color="#1288CF" />
              </linearGradient>
            </defs>
            {fork.map((f) => <path class:list={['fork-path scrub-path', { 'is-pick': f.i === FORK_PICK }]} d={f.d} data-from="0" data-to="0.42" />)}
            {fork.filter((f) => f.i !== FORK_PICK).map((f) => (
              <g class="fork-off" data-at="0.5">
                <circle cx="478" cy={f.y} r="9" />
                <path d={`M474 ${f.y - 4} L482 ${f.y + 4} M482 ${f.y - 4} L474 ${f.y + 4}`} />
              </g>
            ))}
            <path class="fork-glow scrub-path" d={fork[FORK_PICK].d} data-from="0.5" data-to="0.82" />
            <circle class="fork-start" cx="28" cy="112" r="9" />
            <g class="fork-goal" data-at="0.84">
              <circle class="fork-goal-ring" cx="478" cy={FORK_YS[FORK_PICK]} r="15" />
              <circle cx="478" cy={FORK_YS[FORK_PICK]} r="10" />
              <path d={`M473 ${FORK_YS[FORK_PICK]} L477 ${FORK_YS[FORK_PICK] + 4} L484 ${FORK_YS[FORK_PICK] - 4}`} />
            </g>
          </svg>
          <span class="fork-label fork-label-start">Today</span>
          <span class="fork-label fork-label-many" data-at="0.2">Many possible paths</span>
          <span class="fork-label fork-label-goal" data-at="0.86">Aligned with your goals</span>
        </figure>
        </div>
        <ul class="ts-challenges" data-reveal="stagger" data-scrub>
          {
            challenges.map((c, k) => (
              <li style={`--c: ${tone[c.c]}`}>
                <span class="ts-glyph ts-glyph--soft" aria-hidden="true">
                  <Icon name={c.icon} size={20} />
                </span>
                <div>
                  <h3>{c.title}</h3>
                  <p>{c.text}</p>
                </div>
                {k === 0 && (
                  <div class="ch-art ch-opts" aria-hidden="true">
                    {[0, 1, 2, 3].map((i) => <span style={`--i: ${i}`}><i /><b /></span>)}
                    <em>?</em>
                  </div>
                )}
                {k === 1 && (
                  <div class="ch-art ch-risk" aria-hidden="true">
                    <span class="ch-risk-track"><span class="ch-risk-mark" /></span>
                    <span class="ch-risk-low">Low</span>
                    <span class="ch-risk-high">High</span>
                  </div>
                )}
                {k === 2 && (
                  <div class="ch-art ch-align" aria-hidden="true">
                    {['People', 'Processes', 'Technology'].map((t, i) => (
                      <span class="ch-lane" style={`--off: ${[18, 46, 30][i]}%`}><small>{t}</small><span class="ch-lane-track"><i /></span></span>
                    ))}
                    <span class="ch-align-check"><Icon name="check" size={12} /></span>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="ts-starts">
        <h3 class="ts-starts-title">Where engagements start</h3>
        <ul class="ts-start-cards" data-reveal="stagger" data-scrub>
          {
            starts.map((s, k) => (
              <li class="ix-card ix-card--quiet" style={`--c: ${tone[s.c]}`}>
                <span class="ts-tile" aria-hidden="true">
                  <Icon name={s.icon} size={22} />
                </span>
                <svg class="ts-start-art" viewBox="0 0 120 64" aria-hidden="true">
                  {k === 0 && (
                    <g class="st-swap" data-at="0.45">
                      <rect class="st-doc" x="30" y="6" width="44" height="54" rx="5" />
                      <path class="st-lines" d="M38 18 H66 M38 27 H66 M38 36 H58" />
                      <g class="st-bad"><circle cx="78" cy="46" r="13" /><path d="M78 39 V47 M78 51.5 V52" /></g>
                      <g class="st-good"><circle cx="78" cy="46" r="13" /><path d="M71.5 46 L76 50.5 L84.5 41.5" /></g>
                    </g>
                  )}
                  {k === 1 && (
                    <g>
                      <path class="st-axis" d="M8 56 H112" />
                      <path class="st-trend scrub-path" d="M10 26 L34 30 L52 50 L72 38 L94 22 L110 12" data-from="0.2" data-to="0.65" />
