---
import { getCollection } from 'astro:content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, href as withBase, canonicalUrl } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path for canonical + OG url, e.g. "/about-us/". Defaults to current. */
  path?: string;
  /** Absolute OG image URL; defaults to the site's shared OG image. */
  ogImage?: string;
  /** Keep the page out of search indexes (draft pages). */
  noindex?: boolean;
  /** Open Graph type; "article" for Insights posts. */
  ogType?: string;
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = canonicalUrl('/og-default.png'),
  noindex = false,
  ogType = 'website',
} = Astro.props;

// Normalize the given path to a canonical (production-domain) URL.
const cleanPath = path.startsWith(import.meta.env.BASE_URL)
  ? '/' + path.slice(import.meta.env.BASE_URL.length).replace(/^\//, '')
  : path;
const canonical = canonicalUrl(cleanPath);

// Footer: three newest published posts.
const latestPosts = (await getCollection('insights', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((p) => ({ title: p.data.title, href: withBase(`/insights/${p.id}/`) }));
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href={withBase('/brand/tls-mark.png')} />

    <!-- Interaction layer (see src/styles/motion.css).
         1. Opt in to scroll reveals before first paint; if the motion script
            hasn't run within 3s, un-hide everything.
         2. Page transitions: name the header only while a transition runs, so
            it holds still without a permanent view-transition-name (which
            costs subpixel text rendering in the narrow header layout). These
            listeners must exist before first render, hence inline in head. -->
    <link rel="expect" href="#main" blocking="render" />
    <script is:inline>
      (function (d) {
        if ('IntersectionObserver' in window) {
          d.classList.add('ix');
          setTimeout(function () {
            if (!window.__ixReady) d.classList.remove('ix');
          }, 3000);
        }
        function nameHeader(vt) {
          var h = d.querySelector('.site-header');
          if (!h) return;
          h.style.viewTransitionName = vt ? 'ix-header' : '';
          if (vt) vt.finished.finally(function () { h.style.viewTransitionName = ''; });
        }
        window.addEventListener('pageswap', function (e) { if (e.viewTransition) nameHeader(e.viewTransition); });
        window.addEventListener('pagereveal', function (e) { nameHeader(e.viewTransition); });
      })(document.documentElement);
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="True Lean Solutions — Insights"
      href={withBase('/rss.xml')}
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer latestPosts={latestPosts} />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
